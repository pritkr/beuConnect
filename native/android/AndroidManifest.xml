<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.beuconnect.app">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Restores the campus Wi-Fi job after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
        Push notifications. Android 13 asks the student at runtime; the request
        is made from the notifications screen, never at launch. The other three
        are what FCM itself needs: a wake lock to hand the message over, and the
        legacy c2dm permission that Play services still checks when it binds the
        receive path on older builds.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name="com.longbridge.nsh.MainActivity"
            android:configChanges="locale|keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|layoutDirection|fontScale"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Firebase Cloud Messaging.

            The host is assembled with aapt2 from AARs, and nothing merges a
            library's manifest, so every element below is the union of what
            firebase-messaging, firebase-common, firebase-installations,
            firebase-datatransport and play-services-basement declare in their
            own AARs. A missing line does not fail the build; it makes the app
            launch and silently never receive a message, which is why they are
            copied rather than invented.

            `FirebaseInitProvider` is what reads `res/values/firebase.xml` (made
            by scripts/firebase-config.sh from google-services.json) at process
            start. With no values there, `FirebaseApp.getApps` is empty and the
            notifications screen says the build has no service.
        -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="org.beuconnect.app.firebaseinitprovider"
            android:directBootAware="true"
            android:exported="false"
            android:initOrder="100" />

        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter android:priority="-500">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The app's own subclass, which turns a data message into a notification. -->
        <service
            android:name="com.longbridge.nsh.BeuMessagingService"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
            Play services hands a message to this receiver first. It is exported
            because the sender is another process, and guarded by the c2dm SEND
            permission so no ordinary app can spoof a delivery.
        -->
        <receiver
            android:name="com.google.firebase.iid.FirebaseInstanceIdReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
            <meta-data
                android:name="com.google.android.gms.cloudmessaging.FINISHED_AFTER_HANDLED"
                android:value="true" />
        </receiver>

        <!--
            The registrars are how Firebase discovers its own components without
            reflection over the classpath. Each one is a `<meta-data>` entry
            named `com.google.firebase.components:<class>`.
        -->
        <service
            android:name="com.google.firebase.components.ComponentDiscoveryService"
            android:directBootAware="true"
            android:exported="false">
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.FirebaseCommonKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.installations.FirebaseInstallationsKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.installations.FirebaseInstallationsRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.messaging.FirebaseMessagingKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.messaging.FirebaseMessagingRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.datatransport.TransportRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
        </service>

        <!--
            FCM's own delivery log goes through Firebase's transport layer. The
            backend is found by scanning this service's meta-data, so without it
            the transport factory has no destination and logs an error on every
            token request.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                android:value="cct" />
        </service>
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            android:exported="false" />

        <!-- Play services refuses to bind when the app does not declare its version. -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />
        <!-- Only used if a message ever arrives with a `notification` payload
             (the Firebase console's test sender does). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:value="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:value="@color/brand" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="beu.notices" />

        <!--
            Campus Wi-Fi sign-in. The portal is a plain-HTTP page on the local
            network, which is why cleartext traffic is on above; the job only
            ever talks to the host the portal redirects to.
        -->
        <service
            android:name="com.longbridge.nsh.WifiAutoLoginJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            A persisted job survives a reboot on most phones, but not all: an
            OEM that clears jobs at boot, or the package replace itself, leaves
            the feature silently dead. Both actions are protected broadcasts,
            so exporting the receiver is safe.
        -->
        <receiver
            android:name="com.longbridge.nsh.WifiBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

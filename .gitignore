# build output
dist/

# cf build output (Build Output Specification)
.cloudflare/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# cf / wrangler local state
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# native app build output (regenerate with ./scripts/package-android.sh)
native/.nsh/
native/dist/
native/node_modules/

# Firebase client config, downloaded per checkout from the console, and the
# res/values file scripts/firebase-config.sh derives from it.
native/android/google-services.json
native/android/res/values/firebase.xml

# scratch: logs, one-off probes, throwaway harnesses
.tmp/
native/.tmp/
native/.tmp-peek/

# python bytecode
__pycache__/
*.pyc
native/android/libs/*.aar
native/android/libs/*.jar
native/android/deps/.gradle/
native/android/deps/build/

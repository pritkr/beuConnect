---
import { renderMarkdown } from '../utils/markdown';
import 'katex/dist/katex.min.css';

interface Props {
  sections: any[];
  subject?: string;
  year?: number;
}

const { sections, subject = "this subject", year = "" } = Astro.props;

function cleanId(id: string) {
  if (!id) return '';
  let clean = id.replace(/^(question|q)_?/i, '');
  return clean.replace(/_/g, '.');
}

function getLetter(index: number) {
  return String.fromCharCode(97 + index); // 0 -> a, 1 -> b
}

function sanitizeForPrompt(text: string) {
  if (!text) return "";
  // Strip markdown images to prevent URL Too Long errors
  return text.replace(/!\[.*?\]\(.*?\)/g, '[Image omitted in prompt]');
}

function getQuestionText(item: any) {
  if (!item) return '';

  const text = typeof item.text === 'string' ? item.text : '';
  const question = typeof item.question === 'string' ? item.question : '';
  const normalizedText = text.trim().toLowerCase();

  if (question && (!text || normalizedText === 'answer the following:' || normalizedText === '<p></p>')) {
    return question;
  }

  return text || question;
}

function getSubQuestions(item: any) {
  if (Array.isArray(item?.sub_questions) && item.sub_questions.length > 0) {
    return item.sub_questions;
  }

  if (Array.isArray(item?.subQuestions) && item.subQuestions.length > 0) {
    return item.subQuestions;
  }

  return [];
}

function getSubparts(item: any) {
  return Array.isArray(item?.subparts) ? item.subparts : [];
}

function buildSectionPrompt(section: any, subj: string, yr: number | string) {
  const isObjectiveSection = section.questions && section.questions.length > 0 && (section.questions[0].type === 'mcq' || (section.questions[0].options && section.questions[0].options.length > 0));
  
  let prompt = "";
  if (isObjectiveSection) {
    const totalMarks = section.total_marks ? `[${section.total_marks} Marks]` : '';
    prompt = `Act as an expert engineering professor. Solve these BEU (Bihar Engineering University) ${subj} ${yr} objective questions ${totalMarks}. For each question, identify the correct option and provide a concise explanation.\n\n`;
  } else {
    const totalMarks = section.total_marks ? `[${section.total_marks} Marks]` : '';
    prompt = `Act as an expert engineering professor grading a university exam. Provide a comprehensive, exhaustive, exam-style answer for this BEU (Bihar Engineering University) ${subj} ${yr} question to guarantee full marks ${totalMarks}.\n\nInclude relevant images, examples, diagrams, code, and step-by-step calculations as required to construct a complete, structured answer.\n\n`;
  }
  
  prompt += `Main Question / Context: ${sanitizeForPrompt(section.section_title)}\n`;
  
  if (section.questions && section.questions.length > 0) {
    section.questions.forEach((q: any) => {
      const questionText = getQuestionText(q);
      const subQuestions = getSubQuestions(q);
      prompt += `\nPart: ${q.marks ? `[${q.marks} Marks] ` : ''}${sanitizeForPrompt(questionText)}\n`;
      if (q.options && q.options.length > 0) {
        q.options.forEach((opt: string, i: number) => {
          prompt += `   ${getLetter(i)}) ${sanitizeForPrompt(opt)}\n`;
        });
      }
      if (subQuestions.length > 0) {
        subQuestions.forEach((sub: any, si: number) => {
          const subText = getQuestionText(sub);
          prompt += `   ${getLetter(si)}) ${sub.marks ? `[${sub.marks} Marks] ` : ''}${sanitizeForPrompt(subText)}\n`;
          if (sub.options && sub.options.length > 0) {
            sub.options.forEach((sopt: string, soi: number) => {
              prompt += `      ${getLetter(soi)}. ${sanitizeForPrompt(sopt)}\n`;
            });
          }

          getSubparts(sub).forEach((part: any) => {
            const partLabel = part.label ? `${part.label}) ` : '';
            const partText = getQuestionText(part);
            prompt += `      ${partLabel}${sanitizeForPrompt(partText)}\n`;
          });
        });
      }
    });
  }
  return prompt;
}

function buildFullPromptText(q: any, sectionTitle: string, subj: string, yr: number | string, sectionTotalMarks: any) {
  const isObjective = q.type === 'mcq' || (q.options && q.options.length > 0);
  const marks = q.marks != null ? q.marks : sectionTotalMarks;
  
  let prompt = "";
  if (isObjective) {
    const totalMarks = marks != null ? `[${marks} Marks]` : '';
    prompt = `Act as an expert engineering professor. Solve this BEU (Bihar Engineering University) ${subj} ${yr} objective question ${totalMarks}. Identify the correct option and provide a concise explanation.\n\n`;
  } else {
    const totalMarks = marks != null ? `[${marks} Marks]` : '[14 Marks]';
    prompt = `Act as an expert engineering professor grading a university exam. Provide a comprehensive, exhaustive, exam-style answer for this BEU (Bihar Engineering University) ${subj} ${yr} question to guarantee full marks ${totalMarks}.\n\nInclude relevant images, examples, diagrams, code, and step-by-step calculations as required to construct a complete, structured answer.\n\n`;
  }
  
  prompt += `Context: ${sanitizeForPrompt(sectionTitle)}\n`;
  const questionText = getQuestionText(q);
  const subQuestions = getSubQuestions(q);

  prompt += `Question: ${sanitizeForPrompt(questionText)}\n`;
  
  if (q.options && q.options.length > 0) {
    prompt += `\nOptions:\n`;
    q.options.forEach((opt: string, i: number) => {
      prompt += `${getLetter(i)}) ${sanitizeForPrompt(opt)}\n`;
    });
  }
  
  if (subQuestions.length > 0) {
    prompt += `\nSub-questions:\n`;
    subQuestions.forEach((sub: any, si: number) => {
      const subMarks = sub.marks ? `[${sub.marks} Marks] ` : '';
      prompt += `${getLetter(si)}) ${subMarks}${sanitizeForPrompt(getQuestionText(sub))}\n`;
      if (sub.options && sub.options.length > 0) {
        sub.options.forEach((sopt: string, soi: number) => {
          prompt += `   ${getLetter(soi)}. ${sanitizeForPrompt(sopt)}\n`;
        });
      }

      getSubparts(sub).forEach((part: any) => {
        const partLabel = part.label ? `${part.label}) ` : '';
        prompt += `   ${partLabel}${sanitizeForPrompt(getQuestionText(part))}\n`;
      });
    });
  }
  
  return prompt;
}

function getAiUrl(type: 'gpt' | 'claude' | 'gemini', fullPrompt: string) {
  const encodedPrompt = encodeURIComponent(fullPrompt);
  if (type === 'gpt') return `https://chatgpt.com/?q=${encodedPrompt}`;
  if (type === 'gemini') return `https://gemini.google.com/app?prompt=${encodedPrompt}`;
  return `https://claude.ai/new?q=${encodedPrompt}`;
}
---


<div class="pyq-dense-renderer">
  {sections.map((section) => {
    const sectionPrompt = buildSectionPrompt(section, subject, year);
    return (
    <section class="paper-section">
      <header class="section-head">
        <h3 class="section-title">
          <span set:html={renderMarkdown(section.section_title)} />
        </h3>
        <div class="section-tools">
          {section.total_marks && <span class="marks">{section.total_marks} marks</span>}
          <details class="ai">
            <summary>Ask AI</summary>
            <div class="ai-menu">
              <button type="button" data-prompt={sectionPrompt} data-url={getAiUrl('gpt', sectionPrompt)} class="ai-action-btn">ChatGPT</button>
              <button type="button" data-prompt={sectionPrompt} data-url={getAiUrl('gemini', sectionPrompt)} class="ai-action-btn">Gemini</button>
              <button type="button" data-prompt={sectionPrompt} data-url={getAiUrl('claude', sectionPrompt)} class="ai-action-btn">Claude</button>
            </div>
          </details>
        </div>
      </header>

      {section.questions && section.questions.length > 0 && (
      <ol class="questions">
        {section.questions.map((q: any) => {
          const fullPrompt = buildFullPromptText(q, section.section_title, subject, year, section.total_marks);
          const questionText = getQuestionText(q);
          const subQuestions = getSubQuestions(q);
          const marks = q.marks != null ? q.marks : section.total_marks;
          return (
          <li class="question">
            <p class="q-num">Q{cleanId(q.id)}</p>
            <div class="q-body">
              <div class="q-text content-rich" set:html={renderMarkdown(questionText)} />

              {q.options && q.options.length > 0 && (
                <div class="options-grid">
                  {q.options.map((opt: string, i: number) => (
                    <div class="opt-item">
                      <span class="opt-lbl">{getLetter(i)})</span>
                      <div class="opt-val content-rich" set:html={renderMarkdown(opt)} />
                    </div>
                  ))}
                </div>
              )}

              {subQuestions.length > 0 && (
                <div class="sub-list">
                  {subQuestions.map((sub: any, si: number) => (
                    <div class="sub-item">
                      <span class="sub-lbl">{getLetter(si)})</span>
                      <div class="sub-body">
                        <div class="sub-text content-rich" set:html={renderMarkdown(getQuestionText(sub))} />
                        {getSubparts(sub).length > 0 && (
                          <div class="subparts-list">
                            {getSubparts(sub).map((part: any) => (
                              <div class="subpart-item">
                                <span class="subpart-lbl">{part.label ? `${part.label})` : '-'}</span>
                                <div class="subpart-text content-rich" set:html={renderMarkdown(getQuestionText(part))} />
                              </div>
                            ))}
                          </div>
                        )}
                        {sub.options && (
                          <div class="options-grid mini">
                            {sub.options.map((sopt: string, soi: number) => (
                              <div class="opt-item">
                                <span class="opt-lbl">{getLetter(soi)})</span>
                                <div class="opt-val content-rich" set:html={renderMarkdown(sopt)} />
                              </div>
                            ))}
                          </div>
                        )}
                      </div>
                      {sub.marks && <span class="marks">{sub.marks} marks</span>}
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div class="q-tools">
              {marks != null && <span class="marks">{marks} marks</span>}
              <details class="ai">
                <summary>Ask AI</summary>
                <div class="ai-menu">
                  <button type="button" data-prompt={fullPrompt} data-url={getAiUrl('gpt', fullPrompt)} class="ai-action-btn">ChatGPT</button>
                  <button type="button" data-prompt={fullPrompt} data-url={getAiUrl('gemini', fullPrompt)} class="ai-action-btn">Gemini</button>
                  <button type="button" data-prompt={fullPrompt} data-url={getAiUrl('claude', fullPrompt)} class="ai-action-btn">Claude</button>
                </div>
              </details>
            </div>
          </li>
          );
        })}
      </ol>
      )}
    </section>
    );
  })}
</div>

<script>
  // Copy the prompt where the target needs it, then open the assistant.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const button = target.closest('.ai-action-btn');
    if (!button) return;

    const prompt = button.getAttribute('data-prompt');
    const url = button.getAttribute('data-url');
    const isGemini = url.startsWith('https://gemini.google.com');

    if (!prompt || !url) return;

    button.closest('details')?.removeAttribute('open');

    if (isGemini) {
      navigator.clipboard.writeText(prompt).then(() => {
        const toast = document.createElement('div');
        toast.className = 'copy-toast';
        toast.textContent = 'Prompt copied. Paste it in Gemini.';
        document.body.appendChild(toast);
        setTimeout(() => toast.remove(), 3000);
        window.open('https://gemini.google.com/app', '_blank');
      }).catch(() => {
        window.open(url, '_blank');
      });
    } else {
      window.open(url, '_blank');
    }
  });
</script>

<style is:global>
  .content-rich img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: var(--s3) 0;
    border: 1px solid var(--line);
    border-radius: var(--r);
  }

  .content-rich p { margin: 0; }
  .content-rich table { width: auto; margin: var(--s2) 0; font-size: 0.82rem; }
  .content-rich { color: var(--paper); }

  .copy-toast {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    z-index: 9999;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r);
    background: var(--surface);
    color: var(--paper);
    font-size: 0.8rem;
    transform: translateX(-50%);
    animation: toast-in 0.2s ease both;
  }

  @keyframes toast-in {
    from { opacity: 0; transform: translate(-50%, 0.4rem); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .copy-toast { animation: none; }
  }
</style>

<style>
  .pyq-dense-renderer {
    display: grid;
    gap: var(--s5);
    font-size: 0.9rem;
  }

  .paper-section {
    padding-top: var(--s4);
    border-top: 1px solid var(--line-strong);
  }

  .paper-section:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
    padding-bottom: var(--s2);
    border-bottom: 1px solid var(--line);
  }

  .section-title {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-title p {
    display: inline;
    margin: 0;
  }

  .section-tools {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--s3);
  }

  .marks {
    color: var(--faint);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .questions {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .question {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    gap: var(--s3);
    padding: var(--s4) 0;
    border-bottom: 1px solid var(--line);
  }

  .question:last-child {
    border-bottom: 0;
  }

  .q-num {
    margin: 0;
    padding-top: 0.15rem;
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .q-body {
    display: grid;
    gap: var(--s2);
    min-width: 0;
  }

  .q-text {
    min-width: 0;
    line-height: 1.55;
    overflow-wrap: break-word;
  }

  .q-tools {
    display: flex;
    align-items: flex-start;
    gap: var(--s3);
    padding-top: 0.15rem;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 0.15rem var(--s4);
  }

  .options-grid.mini {
    grid-template-columns: minmax(0, 1fr);
  }

  .opt-item {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.35rem;
    min-width: 0;
    padding: 0.1rem 0;
  }

  .opt-lbl {
    color: var(--faint);
    font-size: 0.8rem;
  }

  .opt-val {
    min-width: 0;
    overflow-wrap: break-word;
  }

  .sub-list {
    display: grid;
    gap: var(--s2);
    margin-top: var(--s2);
    padding-left: var(--s3);
    border-left: 1px solid var(--line);
  }

  .sub-item {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr) auto;
    gap: 0.35rem;
    min-width: 0;
  }

  .sub-lbl {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .sub-body {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .subparts-list {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.2rem;
  }

  .subpart-item {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr);
    gap: 0.35rem;
    min-width: 0;
  }

  .subpart-lbl {
    color: var(--faint);
    font-size: 0.78rem;
  }

  .subpart-text {
    min-width: 0;
    overflow-wrap: break-word;
  }

  /* Ask AI: native disclosure keeps keyboard and escape behaviour. */
  .ai {
    position: relative;
    margin: 0;
    border: 0;
  }

  .ai summary {
    padding: 0;
    color: var(--faint);
    font-size: 0.7rem;
    white-space: nowrap;
    cursor: pointer;
    list-style: none;
  }

  .ai summary::-webkit-details-marker {
    display: none;
  }

  .ai summary:hover,
  .ai[open] summary {
    color: var(--paper);
  }

  .ai summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .ai-menu {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 20;
    display: grid;
    min-width: 8.5rem;
    margin-top: var(--s1);
    padding: var(--s1);
    border: 1px solid var(--line-strong);
    border-radius: var(--r);
    background: var(--surface);
  }

  .ai-menu button {
    margin: 0;
    padding: 0.4rem 0.55rem;
    border: 0;
    border-radius: calc(var(--r) - 1px);
    background: transparent;
    color: var(--muted);
    font-size: 0.76rem;
    text-align: left;
    cursor: pointer;
  }

  .ai-menu button:hover {
    background: var(--surface-2);
    color: var(--paper);
  }

  @media (max-width: 700px) {
    .question {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s2);
    }

    .q-num {
      padding-top: 0;
    }

    .q-tools {
      align-items: center;
      justify-content: space-between;
    }

    .sub-item {
      grid-template-columns: 1.1rem minmax(0, 1fr);
    }

    .sub-item > .marks {
      grid-column: 2;
    }
  }
</style>

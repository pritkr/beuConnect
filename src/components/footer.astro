---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import UpiLogo from "./UpiLogo.astro";
import UpiQr from "../assets/upiqr.svg";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const upiId = "pritkr@cnrb";

const columns = [
	{
		title: "Study",
		links: [
			{ href: "syllabus", label: "BEU syllabus" },
			{ href: "pyqs", label: "Previous-year papers" },
			{ href: "gate-syllabus", label: "GATE syllabus" },
			{ href: "gate-pyqs", label: "GATE papers" },
		],
	},
	{
		title: "Results",
		links: [
			{ href: "result", label: "Check result" },
			{ href: "result-table", label: "Result tables" },
			{ href: "merit-list", label: "Merit list" },
			{ href: "data-browser", label: "Data browser" },
			{ href: "rank", label: "University rank" },
			{ href: "battle", label: "Result battle" },
		],
	},
	{
		title: "Campus",
		links: [
			{ href: "routine", label: "Class routine" },
			{ href: "attendance", label: "Attendance" },
			{ href: "calculator", label: "GPA calculator" },
			{ href: "notices", label: "Notices" },
			{ href: "notice-board", label: "Notice board" },
			{ href: "holidays", label: "Holidays" },
			{ href: "listofstudents", label: "Student list" },
			{ href: "wifi", label: "WiFi setup" },
		],
	},
];
---

<footer class="site-footer">
	<div class="footer-grid">
		<div class="footer-brand">
			<Logo size={24} />
			<p>
				Student-run tools for Bihar Engineering University. Not an official
				BEU service.
			</p>
		</div>

		{
			columns.map((column) => (
				<nav aria-label={column.title}>
					<h2>{column.title}</h2>
					<ul>
						{column.links.map((link) => (
							<li>
								<a href={`${base}${link.href}`}>{link.label}</a>
							</li>
						))}
					</ul>
				</nav>
			))
		}
	</div>

	<div class="footer-base">
		<p>
			Built by <a href="https://prit.eu.org/">Prit</a> at GEC Sheikhpura.
			<a href={`${base}privacy`}>Privacy</a>.
		</p>
		<div class="footer-actions">
			<button
				type="button"
				class="btn-ghost btn-sm"
				data-feedback-trigger
				data-feedback-context="footer"
			>
				<Icon name="message" size={14} />
				Report a problem
			</button>
			<button type="button" class="btn-ghost btn-sm" id="supportOpen">
				<Icon name="award" size={14} />
				Support
			</button>
		</div>
		<p class="footer-copy">© {year} BEUConnect</p>
	</div>
</footer>

<dialog id="supportDialog" class="support-dialog" aria-labelledby="support-title">
	<form method="dialog" class="support-close-form">
		<button type="submit" class="btn-icon btn-ghost" aria-label="Close">
			<Icon name="x" size={16} />
		</button>
	</form>

	<div class="support-body">
		<h2 id="support-title">Support BEUConnect</h2>
		<p>Contributions cover the domain and hosting.</p>

		<img src={UpiQr.src} alt="UPI QR code for pritkr@cnrb" width="200" height="200" />

		<div class="support-upi">
			<UpiLogo width={64} class="support-upi-logo" />
			<code id="supportUpi">{upiId}</code>
			<button type="button" class="btn-sm" id="supportCopy">Copy UPI ID</button>
		</div>
		<p class="support-status" id="supportStatus" role="status" aria-live="polite"></p>
	</div>
</dialog>

<style>
	.site-footer {
		border-top: 1px solid var(--line-strong);
		background: var(--bg);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: minmax(220px, 1.4fr) repeat(3, minmax(0, 1fr));
		gap: var(--s6);
		width: min(100% - 2.5rem, var(--max));
		margin-inline: auto;
		padding: var(--s7) 0 var(--s6);
	}

	.footer-brand p {
		margin-top: var(--s3);
		max-width: 26ch;
		font-size: 0.85rem;
		line-height: 1.5;
	}


	.footer-grid nav {
		display: block;
	}

	.footer-grid nav h2 {
		margin-bottom: var(--s3);
		font-family: var(--font-sans);
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--faint);
	}

	.footer-grid nav ul {
		display: grid;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.footer-grid nav li {
		margin: 0;
		padding: 0;
		line-height: 1.4;
	}

	.footer-grid nav a {
		display: inline;
		margin: 0;
		padding: 0;
		color: var(--muted);
		font-size: 0.85rem;
		line-height: 1.5;
		text-decoration: none;
	}

	.footer-grid nav a:hover {
		color: var(--paper);
		text-decoration: underline;
		text-underline-offset: 0.16em;
	}

	.footer-base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--s4);
		width: min(100% - 2.5rem, var(--max));
		margin-inline: auto;
		padding: var(--s4) 0 var(--s5);
		border-top: 1px solid var(--line);
	}

	.footer-base p {
		margin: 0;
		font-size: 0.8rem;
		color: var(--faint);
	}

	.footer-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s2);
		margin-left: auto;
	}

	.footer-copy {
		width: 100%;
	}

	dialog.support-dialog {
		width: min(100% - 2rem, 25rem);
		padding: var(--s5);
		border: 1px solid var(--line-strong);
		border-radius: var(--r-lg);
		background: var(--surface);
		color: var(--paper);
	}

	dialog.support-dialog::backdrop {
		background: var(--scrim);
	}

	.support-close-form {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		margin: 0;
	}

	.support-body {
		display: grid;
		justify-items: start;
		gap: var(--s3);
	}

	.support-body h2 {
		font-size: 1.5rem;
	}

	.support-body p {
		font-size: 0.85rem;
	}

	.support-body img {
		width: min(200px, 55vw);
		height: auto;
		border: 1px solid var(--line);
		border-radius: var(--r);
		background: var(--paper);
	}

	.support-upi {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--s2);
	}

	.support-upi-logo {
		flex: none;
		color: var(--paper);
	}

	.support-upi code {
		padding: 0.35rem 0.5rem;
		font-size: 0.9rem;
	}

	.support-status {
		margin: 0;
		min-height: 1.1rem;
		font-size: 0.78rem;
		color: var(--ok);
	}

	@media (max-width: 900px) {
		.footer-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--s5);
		}
	}

	@media (max-width: 640px) {
		.footer-grid,
		.footer-base {
			width: min(100% - 1.5rem, var(--max));
		}

		.footer-grid {
			grid-template-columns: 1fr 1fr;
			padding-top: var(--s6);
		}

		.footer-brand {
			grid-column: 1 / -1;
		}

		.footer-actions {
			margin-left: 0;
		}
	}
</style>

<script define:vars={{ upiId }}>
	// define:vars scripts are inlined verbatim: no TypeScript here.
	const dialog = document.getElementById("supportDialog");
	const openButton = document.getElementById("supportOpen");
	const copyButton = document.getElementById("supportCopy");
	const status = document.getElementById("supportStatus");

	openButton?.addEventListener("click", () => dialog?.showModal());

	copyButton?.addEventListener("click", async () => {
		try {
			await navigator.clipboard.writeText(upiId);
			if (status) status.textContent = "UPI ID copied.";
			if (copyButton) copyButton.textContent = "Copied";
		} catch {
			if (status) status.textContent = "Copy failed. Select the ID manually.";
		}
	});

	dialog?.addEventListener("click", (event) => {
		const bounds = dialog.getBoundingClientRect();
		const inside =
			event.clientX >= bounds.left &&
			event.clientX <= bounds.right &&
			event.clientY >= bounds.top &&
			event.clientY <= bounds.bottom;
		if (!inside) dialog.close();
	});

	dialog?.addEventListener("close", () => {
		if (status) status.textContent = "";
		if (copyButton) copyButton.textContent = "Copy UPI ID";
	});
</script>

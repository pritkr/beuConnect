---
import Icon from "./Icon.astro";

type AnnouncementItem = {
	text: string;
	link: string;
};

const announcements: AnnouncementItem[] = Astro.props.announcements ?? [];
const importantApi: string | undefined = Astro.props.importantApi;
const latest = announcements[0];
const baseUrl = import.meta.env.BASE_URL;

const resolveLink = (link: string) =>
	link.startsWith("http://") || link.startsWith("https://")
		? link
		: `${baseUrl}${link.replace(/^\/+/, "")}`;

const isExternal = latest ? /^https?:\/\//.test(latest.link) : false;
---

{
	latest && (
		<section class="latest" aria-labelledby="latest-label">
			<p id="latest-label">Latest notice</p>
			<a
				id="latestNotice"
				href={resolveLink(latest.link)}
				target={isExternal ? "_blank" : undefined}
				rel={isExternal ? "noopener" : undefined}
			>
				<span id="latestNoticeText">{latest.text}</span>
				<Icon name="arrow-right" size={14} />
			</a>
		</section>
	)
}

<script define:vars={{ importantApi, baseUrl }}>
	const link = document.getElementById("latestNotice");
	const text = document.getElementById("latestNoticeText");

	const CACHE_KEY = "beu_home_important_notices_v1";
	const CACHE_TTL_MS = 2 * 60 * 1000;

	if (link && text && importantApi) {
		const normalizeLink = (value) => {
			if (!value) return `${baseUrl}notice-board`;
			if (/^https?:\/\//.test(value)) return value;
			const trimmed = value.replace(/^\/+/, "");
			if (trimmed.startsWith("backend/")) return `https://beu-bih.ac.in/${trimmed}`;
			if (trimmed.includes(".pdf")) return `https://beu-bih.ac.in/backend/${trimmed}`;
			return `https://beu-bih.ac.in/${trimmed}`;
		};

		const apply = (items) => {
			const first = Array.isArray(items) ? items[0] : null;
			const label = String(first?.board || first?.title || "").trim();
			if (label.length < 3) return;
			text.textContent = label;
			link.href = normalizeLink(first.link);
			link.target = "_blank";
			link.rel = "noopener";
		};

		const readCache = () => {
			try {
				const raw = localStorage.getItem(CACHE_KEY);
				if (!raw) return null;
				const parsed = JSON.parse(raw);
				if (!parsed?.ts || !Array.isArray(parsed?.items)) return null;
				if (Date.now() - parsed.ts > CACHE_TTL_MS) return null;
				return parsed.items;
			} catch {
				return null;
			}
		};

		const refresh = async () => {
			try {
				const response = await fetch(importantApi, { cache: "no-store" });
				if (!response.ok) return;
				const data = await response.json();
				const items = Array.isArray(data?.items)
					? data.items
					: Array.isArray(data)
						? data
						: Array.isArray(data?.data)
							? data.data
							: [];
				apply(items);
				try {
					localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), items }));
				} catch {}
			} catch {}
		};

		const cached = readCache();
		if (cached) apply(cached);
		refresh();
	}
</script>

<style>
	.latest {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem var(--s4);
		padding: var(--s3) 0;
		border-bottom: 1px solid var(--line);
	}

	.latest p {
		margin: 0;
		color: var(--faint);
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.latest a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-width: 0;
		color: var(--paper);
		font-size: 0.85rem;
		text-decoration: none;
	}

	.latest a:hover {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 0.16em;
	}

	.latest a :global(svg) {
		flex: 0 0 auto;
		color: var(--faint);
	}
</style>

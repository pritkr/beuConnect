---
import Icon from "./Icon.astro";

const base = import.meta.env.BASE_URL;

const groups = [
	{
		title: "Study",
		items: [
			{ href: "syllabus", label: "Syllabus", icon: "book" },
			{ href: "pyqs", label: "Previous-year papers", icon: "file" },
			{ href: "gate-syllabus", label: "GATE syllabus", icon: "target" },
			{ href: "gate-pyqs", label: "GATE papers", icon: "file" },
		],
	},
	{
		title: "Results",
		items: [
			{ href: "result", label: "Check result", icon: "search" },
			{ href: "result-table", label: "Result tables", icon: "table" },
			{ href: "merit-list", label: "Merit list", icon: "trophy" },
			{ href: "data-browser", label: "Data browser", icon: "database" },
			{ href: "rank", label: "University rank", icon: "award" },
			{ href: "battle", label: "Result battle", icon: "compare" },
		],
	},
	{
		title: "Campus",
		items: [
			{ href: "routine", label: "Class routine", icon: "calendar" },
			{ href: "attendance", label: "Attendance", icon: "clock" },
			{ href: "calculator", label: "GPA calculator", icon: "calculator" },
			{ href: "notices", label: "Notices", icon: "bell" },
			{ href: "holidays", label: "Holidays", icon: "calendar" },
			{ href: "listofstudents", label: "Student list", icon: "users" },
		],
	},
] as const;

// Counted once here so the header can state the size of the index.
const toolCount = groups.reduce((total, group) => total + group.items.length, 0);

const figures = [
	{ value: "1,069", label: "previous-year papers" },
	{ value: "6", label: "B.Tech branches" },
	{ value: "1–8", label: "semesters covered" },
];
---

<section class="desk" aria-labelledby="intro-title">
	<div class="desk-inner">
		<div class="intro-copy">
			<p class="kicker">Bihar Engineering University</p>

			<h1 id="intro-title">Syllabus, results and question papers.</h1>

			<ul class="ledger" aria-label="Site coverage">
				{
					figures.map((figure) => (
						<li>
							<span class="figure-value num">{figure.value}</span>
							<span class="figure-label">{figure.label}</span>
						</li>
					))
				}
			</ul>
		</div>

		<aside class="card" aria-label="Your registration number">
			<div id="profileEmpty">
				<p class="card-label">Registration number</p>

				<form id="heroProfileForm" novalidate>
					<label class="sr-only" for="heroRegInput">Registration number</label>
					<div class="card-field">
						<input
							id="heroRegInput"
							name="reg"
							type="text"
							inputmode="numeric"
							autocomplete="on"
							maxlength="11"
							placeholder="22105123019"
							aria-describedby="heroRegError"
						/>
						<button type="submit" class="btn-primary" id="heroRegBtn">Use</button>
					</div>
					<p class="form-status is-error" id="heroRegError" role="alert"></p>
				</form>

				<p class="card-note">Stored on this device.</p>
			</div>

			<div id="profileFilled" hidden>
				<div class="card-head">
					<p class="card-label">Student</p>
					<button type="button" class="btn-link" id="dashForgetBtn">
						Forget
					</button>
				</div>

				<h2 id="dash-name">Student</h2>

				<p class="card-line">
					<span id="dash-branch">Branch</span>
					<span class="card-sem">Semester <span id="dash-sem">—</span></span>
				</p>

				<p class="card-sgpa" id="dashSgpaRow">
					<span class="card-label">Last SGPA</span>
					<span class="num" id="dash-sgpa">—</span>
				</p>

				<div class="card-actions">
					<a id="dash-syllabus-link" class="btn btn-primary" href={`${base}syllabus`}>
						Open syllabus
					</a>
					<a class="btn btn-ghost" href={`${base}result`}>Check result</a>
				</div>
			</div>
		</aside>
	</div>
</section>

<section class="tools" id="tools" aria-labelledby="tools-title">
	<div class="tools-head">
		<h2 id="tools-title">Tools</h2>
		<span class="tools-rule" aria-hidden="true"></span>
		<span class="tools-count num">{toolCount}</span>
	</div>

	<div class="index">
		{
			groups.map((group) => (
				<div class="index-group">
					<h3>
						<span class="index-dot" aria-hidden="true" />
						{group.title}
					</h3>
					<ul>
						{group.items.map((item) => (
							<li>
								<a href={`${base}${item.href}`}>
									<Icon name={item.icon} size={15} class="icon" />
									<span class="row-label">{item.label}</span>
									<span class="row-leader" aria-hidden="true" />
									<Icon name="arrow-right" size={14} class="go" />
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>

<style>
	/* The hero sits on a slightly deeper tone than the page, like a desk under
	   the paper. The card is the paper: same surface as every other panel. The
	   ruled texture is the only decoration on the site. */
	.desk {
		position: relative;
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		border-top: 1px solid var(--line-strong);
		border-bottom: 1px solid var(--line-strong);
		background-color: var(--surface-2);
		background-image: repeating-linear-gradient(
			to bottom,
			transparent 0 33px,
			color-mix(in srgb, var(--line) 45%, transparent) 33px 34px
		);
	}

	.desk-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
		align-items: start;
		gap: var(--s7);
		width: min(100% - 2.5rem, var(--max));
		margin-inline: auto;
		padding: var(--s7) 0 var(--s7);
	}

	.kicker {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 var(--s4);
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		line-height: 1;
		text-transform: uppercase;
	}

	.kicker::before {
		content: "";
		width: 0.5rem;
		height: 0.5rem;
		background: var(--accent);
	}

	.intro-copy h1 {
		max-width: 15ch;
		font-size: clamp(2.75rem, 5.6vw, 4.5rem);
		line-height: 0.94;
		letter-spacing: -0.03em;
	}

	.ledger {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, auto));
		justify-content: start;
		gap: 0;
		margin: var(--s6) 0 0;
		padding: 0;
		border-top: 1px solid var(--line-strong);
		list-style: none;
	}

	.ledger li {
		display: grid;
		gap: 0.2rem;
		padding: var(--s3) 0 0;
		margin: 0;
	}

	.ledger li + li {
		margin-left: var(--s5);
		padding-left: var(--s5);
		border-left: 1px solid var(--line);
	}

	.figure-value {
		color: var(--paper);
		font-family: var(--font-display);
		font-size: 2.15rem;
		line-height: 1;
	}

	.figure-label {
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.1em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.card {
		margin-top: 1.7rem;
		padding: var(--s5);
		border: 1px solid var(--line-strong);
		border-top: 3px solid var(--accent);
		border-radius: var(--r);
		background: var(--surface);
		box-shadow: var(--shadow-md);
	}

	.card-label {
		margin: 0 0 var(--s3);
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		line-height: 1;
		text-transform: uppercase;
	}

	.card form {
		display: grid;
		gap: var(--s2);
		margin: 0;
	}

	.card-field {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: var(--s2);
	}

	.card-field input,
	.card-field input:focus {
		width: 100%;
		margin: 0;
		padding: 0.5rem 0;
		border: 0;
		border-bottom: 1.5px solid var(--line-strong);
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: 1.05rem;
		letter-spacing: 0.08em;
		line-height: 1.4;
	}

	.card-field input:focus {
		border-bottom-color: var(--accent);
		outline: none;
	}

	.card-field input::placeholder {
		color: var(--faint);
		letter-spacing: 0.06em;
	}

	.card-field .btn-primary {
		min-height: 2.5rem;
		margin: 0;
	}

	.card-note {
		margin: var(--s4) 0 0;
		padding-top: var(--s3);
		border-top: 1px solid var(--line);
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		letter-spacing: 0.1em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	#profileFilled h2 {
		margin-bottom: 0.35rem;
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 2.4vw, 1.9rem);
		line-height: 1.05;
		overflow-wrap: anywhere;
	}

	.card-line {
		display: grid;
		gap: 0.1rem;
		margin: 0;
		color: var(--muted);
		font-size: 0.85rem;
		line-height: 1.45;
		overflow-wrap: anywhere;
	}

	.card-sem {
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}

	.card-sgpa {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s3);
		margin: var(--s4) 0 0;
		padding-top: var(--s3);
		border-top: 1px solid var(--line);
	}

	.card-sgpa[hidden] {
		display: none;
	}

	.card-sgpa .card-label {
		margin: 0;
	}

	.card-sgpa .num {
		color: var(--paper);
		font-family: var(--font-display);
		font-size: 1.5rem;
		line-height: 1;
	}

	.card-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--s2);
		margin-top: var(--s4);
	}

	.card-actions .btn {
		margin: 0;
	}

	/* The card swaps between "enter a number" and "your desk". Only after the
	   visitor acts: a returning visitor's saved profile must not fade in on load. */
	.card.is-live #profileEmpty,
	.card.is-live #profileFilled {
		transition:
			opacity var(--dur-ui) var(--ease-out),
			transform var(--dur-ui) var(--ease-out);
	}

	@starting-style {
		.card.is-live #profileFilled:not([hidden]) {
			opacity: 0;
			transform: translateY(6px);
		}

		.card.is-live #profileEmpty:not([hidden]) {
			opacity: 0;
			transform: translateY(-4px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card.is-live #profileEmpty,
		.card.is-live #profileFilled {
			transition-property: opacity;
			transition-duration: 120ms !important;
		}
	}

	.card-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s3);
		margin-bottom: var(--s2);
	}

	.card-head .card-label {
		margin: 0;
	}

	.btn-link {
		min-height: 0;
		margin: 0;
		padding: 0.35rem 0;
		border: 0;
		background: none;
		color: var(--faint);
		font-size: 0.8rem;
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-underline-offset: 0.2em;
	}

	.btn-link:hover {
		color: var(--bad);
		text-decoration-color: var(--bad);
	}

	/* ---- Tools ------------------------------------------------------------ */

	.tools {
		padding: var(--s7) 0 0;
	}

	.tools-head {
		display: flex;
		align-items: center;
		gap: var(--s3);
		margin-bottom: var(--s5);
	}

	.tools-head h2 {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.tools-rule {
		flex: 1;
		height: 1px;
		background: var(--line-strong);
	}

	.tools-count {
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
	}

	.index {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0 var(--s6);
	}

	.index-group h3 {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 var(--s2);
		padding-bottom: var(--s2);
		border-bottom: 1px solid var(--line-strong);
		color: var(--paper);
		font-family: var(--font-mono);
		font-size: 0.66rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.index-dot {
		width: 0.4rem;
		height: 0.4rem;
		background: var(--accent);
	}

	.index-group ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.index-group li {
		margin: 0;
		list-style: none;
	}

	.index-group a {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		min-height: 2.35rem;
		padding: 0.5rem 0;
		color: var(--paper);
		font-size: 0.92rem;
		font-weight: 500;
		text-decoration: none;
	}

	.index-group .icon {
		flex: none;
		margin-top: 0.15em;
		color: var(--faint);
		transition: color 120ms ease;
	}

	.row-label {
		flex: none;
		max-width: calc(100% - 4.4rem);
	}

	.row-leader {
		flex: 1;
		min-width: 0.75rem;
		border-bottom: 1px dotted var(--line-strong);
		transform: translateY(-0.2em);
	}

	.index-group .go {
		flex: none;
		color: var(--line-strong);
		transition:
			color 120ms ease,
			transform 120ms ease;
	}

	.index-group a:hover {
		color: var(--accent);
	}

	.index-group a:hover .icon,
	.index-group a:hover .go {
		color: var(--accent);
	}

	.index-group a:hover .go {
		transform: translateX(2px);
	}

	.index-group a:hover .row-leader {
		border-bottom-color: var(--accent-line);
	}

	@media (max-width: 900px) {
		.desk-inner {
			grid-template-columns: 1fr;
			gap: var(--s5);
			padding: var(--s6) 0 var(--s6);
		}

		.intro-copy h1 {
			max-width: 20ch;
		}

		.card {
			margin-top: 0;
		}

		.index {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--s5) var(--s6);
		}
	}

	@media (max-width: 620px) {
		.ledger {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			justify-content: stretch;
		}

		.ledger li + li {
			margin-left: var(--s3);
			padding-left: var(--s3);
		}

		.figure-value {
			font-size: 1.55rem;
		}

		.figure-label {
			font-size: 0.56rem;
			letter-spacing: 0.06em;
		}

		.index {
			grid-template-columns: 1fr;
			gap: var(--s5);
		}

		.index-group a {
			min-height: 2.6rem;
		}
	}
</style>

<script>
	import { inferCurrentSemester } from "../lib/beuReg";
	import { fetchStudent } from "../lib/students/client";
	import {
		clearProfile,
		getProfile,
		parseRegNo,
		saveProfile,
		type BEUProfile,
	} from "../utils/profileManager";

	const emptyState = document.getElementById("profileEmpty");
	const filledState = document.getElementById("profileFilled");
	const form = document.getElementById("heroProfileForm") as HTMLFormElement | null;
	const card = document.querySelector("aside.card");
	const input = document.getElementById("heroRegInput") as HTMLInputElement | null;
	const errorEl = document.getElementById("heroRegError");
	const nameEl = document.getElementById("dash-name");
	const branchEl = document.getElementById("dash-branch");
	const semEl = document.getElementById("dash-sem");
	const sgpaEl = document.getElementById("dash-sgpa");
	const sgpaRow = document.getElementById("dashSgpaRow");
	const syllabusLink = document.getElementById("dash-syllabus-link") as HTMLAnchorElement | null;
	const forgetBtn = document.getElementById("dashForgetBtn");
	const base = import.meta.env.BASE_URL;

	/** Bumped per lookup so a slow answer never overwrites a newer number. */
	let lookupToken = 0;

	const render = (profile: BEUProfile | null) => {
		if (!emptyState || !filledState) return;

		if (!profile || (!profile.branchPath && !profile.name && !profile.currentSem)) {
			emptyState.hidden = false;
			filledState.hidden = true;
			return;
		}

		emptyState.hidden = true;
		filledState.hidden = false;

		const name = (profile.name ?? "").replace(/\s+/g, " ").trim();
		if (nameEl) nameEl.textContent = name || "Student";
		if (branchEl) branchEl.textContent = profile.branchName ?? "Branch";
		if (semEl) semEl.textContent = profile.currentSem ? String(profile.currentSem) : "—";

		if (sgpaEl) {
			sgpaEl.textContent = profile.lastSgpa || "—";
			if (profile.lastSgpa && profile.lastCgpa) {
				sgpaEl.textContent = `${profile.lastSgpa} (CGPA ${profile.lastCgpa})`;
			}
		}

		// An empty grade row is a dash pretending to be data. Show it only when
		// there is a result behind it.
		if (sgpaRow) sgpaRow.hidden = !profile.lastSgpa;

		if (syllabusLink && profile.branchPath && profile.currentSem) {
			syllabusLink.href = `${base}syllabus/${profile.branchPath}/${profile.currentSem}`;
		}
	};

	/**
	 * Name resolution without the result portal: the GECS register answers
	 * offline, so identity survives the captcha the portal now has. Only when
	 * the register has no row do we fall back to the portal, and any failure
	 * there is silent — branch and semester already came from the number.
	 */
	const resolveIdentity = async (regNo: string) => {
		const token = ++lookupToken;

		const student = await fetchStudent(regNo);
		if (token !== lookupToken) return;

		if (student?.name) {
			const saved = getProfile();
			if (saved?.regNo === regNo && saved.name !== student.name.trim()) {
				saveProfile({ name: student.name.trim() });
			}
			render(getProfile());
			return;
		}

		const semester = getProfile()?.currentSem;
		if (!semester) return;

		try {
			const response = await fetch(
				`${base}api/result?reg=${encodeURIComponent(regNo)}&sem=${semester}&format=json`,
			);
			if (!response.ok) return;

			const payload = (await response.json()) as {
				status?: number;
				data?: { name?: string; sgpa?: unknown; cgpa?: unknown };
			};
			if (token !== lookupToken) return;
			if (payload?.status !== 200 || !payload.data) return;

			const name = typeof payload.data.name === "string" ? payload.data.name.trim() : "";
			if (!name) return;

			const sgpaList = Array.isArray(payload.data.sgpa) ? payload.data.sgpa : [];
			const sgpa = sgpaList[semester - 1];
			const cgpa = payload.data.cgpa;

			saveProfile({
				name,
				lastSgpa: sgpa === undefined || sgpa === null ? undefined : String(sgpa),
				lastCgpa: cgpa === undefined || cgpa === null || cgpa === "" ? undefined : String(cgpa),
			});
			render(getProfile());
		} catch {
			// The portal is behind a captcha; a miss here is normal.
		}
	};

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		if (!input) return;

		const value = input.value.replace(/\D/g, "");
		input.value = value;

		if (value.length !== 11) {
			if (errorEl) errorEl.textContent = "Enter your 11-digit registration number.";
			input.setAttribute("aria-invalid", "true");
			input.focus();
			return;
		}

		const parsed = parseRegNo(value);
		if (!parsed.branchPath) {
			if (errorEl) errorEl.textContent = "That number does not match a BEU registration format.";
			input.setAttribute("aria-invalid", "true");
			input.focus();
			return;
		}

		if (errorEl) errorEl.textContent = "";
		input.removeAttribute("aria-invalid");
		card?.classList.add("is-live");

		const previous = getProfile();
		if (previous?.regNo === parsed.regNo) {
			saveProfile(parsed);
		} else {
			// A different number must not inherit the previous student's name.
			saveProfile({
				...parsed,
				name: undefined,
				lastSgpa: undefined,
				lastCgpa: undefined,
				lastSemChecked: undefined,
			});
		}

		const profile = getProfile();
		render(profile);
		if (profile?.regNo) void resolveIdentity(profile.regNo);
	});

	input?.addEventListener("input", () => {
		const digits = input.value.replace(/\D/g, "").slice(0, 11);
		if (input.value !== digits) input.value = digits;
		if (errorEl) errorEl.textContent = "";
		input.removeAttribute("aria-invalid");
	});

	// maxlength counts a pasted "2410 5157 010" as 13 characters, so take the
	// digits ourselves instead of letting the field cut the number short.
	input?.addEventListener("paste", (event) => {
		const text = event.clipboardData?.getData("text");
		if (!text) return;
		const digits = text.replace(/\D/g, "");
		if (!digits) return;
		event.preventDefault();
		const start = input.selectionStart ?? input.value.length;
		const end = input.selectionEnd ?? input.value.length;
		const next = `${input.value.slice(0, start)}${digits}${input.value.slice(end)}`
			.replace(/\D/g, "")
			.slice(0, 11);
		input.value = next;
		const caret = Math.min(next.length, start + digits.length);
		input.setSelectionRange(caret, caret);
		if (errorEl) errorEl.textContent = "";
		input.removeAttribute("aria-invalid");
	});

	forgetBtn?.addEventListener("click", () => {
		if (!confirm("Remove your saved branch and semester from this device?")) return;
		lookupToken += 1;
		clearProfile();
		card?.classList.add("is-live");
		render(null);
		if (input) input.value = "";
	});

	window.addEventListener("beu_profile_updated", () => render(getProfile()));

	// Paint the saved profile before any network work so a known name never
	// falls back to the placeholder.
	const stored = getProfile();
	if (stored?.batchYear) {
		// A profile saved last term still knows its batch, not its semester.
		const semester = inferCurrentSemester(stored.batchYear);
		if (semester !== stored.currentSem) saveProfile({ currentSem: semester });
	}
	const profile = getProfile();
	render(profile);
	if (profile?.regNo && !profile.name) void resolveIdentity(profile.regNo);
</script>

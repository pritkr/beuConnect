---
import Icon from "./Icon.astro";

const baseUrl = import.meta.env.BASE_URL;
// Turnstile is intentionally disabled for now.
// const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
// const turnstileEnabled = Boolean(turnstileSiteKey);
---

<div class="feedback-widget">
	<div id="feedbackToast" class="feedback-toast" aria-live="polite"></div>

	<dialog id="feedbackDialog" class="feedback-dialog">
		<button type="button" class="feedback-close" id="feedbackCloseBtn" aria-label="Close feedback form">
			<Icon name="x" size={16} />
		</button>

		<div class="feedback-panel">
			<div class="feedback-copy">
				<h2>Send feedback</h2>
				<p class="feedback-page"><code id="feedbackPageLabel">/</code></p>
			</div>

			<form id="feedbackForm" class="feedback-form">
				<input
					type="text"
					name="company"
					class="feedback-honeypot"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
				/>
				<input type="hidden" name="page" id="feedbackPageInput" />
				<input type="hidden" name="context" id="feedbackContextInput" />

				<label class="feedback-field">
					<span>Type</span>
					<select name="type" id="feedbackType" required>
						<option value="bug">Bug report</option>
						<option value="wrong-data">Wrong data</option>
						<option value="feature">Feature request</option>
						<option value="other">Other</option>
					</select>
				</label>

				<label class="feedback-field feedback-field-wide">
					<span>Message</span>
					<textarea
						name="message"
						id="feedbackMessage"
						rows="3"
						maxlength="1200"
						placeholder="Example: Sem 5 result shows blank SGPA in modern view."
						required
					></textarea>
				</label>

				<div class="feedback-grid">
					<label class="feedback-field">
						<span>Reg no. (optional)</span>
						<input
							type="text"
							name="regNo"
							id="feedbackRegNo"
							inputmode="numeric"
							maxlength="20"
							placeholder="22105123019"
						/>
					</label>

					<label class="feedback-field">
						<span>Contact (optional)</span>
						<input
							type="text"
							name="contact"
							id="feedbackContact"
							maxlength="80"
							placeholder="Telegram @username"
						/>
					</label>
				</div>

				<!--
				<div class="feedback-verification">
					<div
						class="cf-turnstile"
						id="feedbackTurnstile"
						data-sitekey={turnstileSiteKey}
						data-theme="dark"
					></div>
				</div>
				-->

				<p id="feedbackStatus" class="feedback-status" role="status" aria-live="polite"></p>

				<div class="feedback-actions">
					<button type="button" class="feedback-secondary" id="feedbackCancelBtn">Cancel</button>
					<button type="submit" class="feedback-primary" id="feedbackSubmitBtn">Send</button>
				</div>
			</form>
		</div>
	</dialog>
</div>

<!-- <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script> -->

<style>
	.feedback-widget {
		position: relative;
	}

	.feedback-dialog {
		width: min(100%, 30rem);
		max-height: min(88dvh, 38rem);
		padding: 0;
		border: 1px solid var(--line-strong);
		border-radius: var(--r-lg);
		background: var(--surface);
		color: var(--paper);
		overflow: hidden;
	}

	.feedback-dialog::backdrop {
		background: var(--scrim);
	}

	.feedback-toast {
		position: fixed;
		right: max(1rem, var(--safe-right));
		bottom: calc(1rem + var(--safe-bottom));
		z-index: 150;
		max-width: min(24rem, calc(100vw - 2rem));
		padding: var(--s3) var(--s4);
		border: 1px solid var(--line-strong);
		border-left: 3px solid var(--ok);
		border-radius: var(--r);
		background: var(--surface);
		color: var(--paper);
		font-size: 0.82rem;
		opacity: 0;
		pointer-events: none;
		translate: 0 12px;
		transition-property: opacity, translate;
		transition-duration: 150ms;
		transition-timing-function: var(--ease-out);
	}

	.feedback-toast.show {
		opacity: 1;
		translate: 0 0;
	}

	.feedback-close {
		position: absolute;
		top: var(--s2);
		right: var(--s2);
		z-index: 2;
		display: grid;
		place-items: center;
		width: 1.9rem;
		height: 1.9rem;
		padding: 0;
		border: 1px solid transparent;
		border-radius: var(--r);
		background: transparent;
		color: var(--faint);
		line-height: 1;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition-property: color, border-color;
		transition-duration: 150ms;
		transition-timing-function: ease-out;
	}

	@media (hover: hover) and (pointer: fine) {
		.feedback-close:hover {
			color: var(--paper);
			border-color: var(--line);
		}
	}

	/* The press is the only feedback the button gets on a touch screen. */
	.feedback-close:active {
		color: var(--paper);
		border-color: var(--line);
	}

	.feedback-panel {
		display: grid;
		gap: var(--s4);
		padding: var(--s5);
		overflow: auto;
		overscroll-behavior: contain;
		overscroll-behavior: contain;
	}

	.feedback-copy h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.6rem;
		font-weight: 400;
		line-height: 1.1;
	}

	.feedback-page {
		margin: var(--s1) 0 0;
		font-size: 0.72rem;
	}

	.feedback-page code {
		color: var(--faint);
		font-family: var(--font-mono);
	}

	.feedback-form {
		display: grid;
		gap: var(--s3);
	}

	.feedback-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--s3);
	}

	.feedback-field {
		display: grid;
		gap: 0.25rem;
		margin: 0;
	}

	.feedback-field span {
		color: var(--faint);
		font-size: 0.68rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.feedback-field input,
	.feedback-field select,
	.feedback-field textarea {
		margin: 0;
		padding: 0.45rem 0.55rem;
		border: 1px solid var(--line-field);
		border-radius: var(--r);
		background: var(--bg);
		color: var(--paper);
		/* 16px is the floor: below it iOS zooms the page on focus and leaves it
		   zoomed when the keyboard closes. */
		font-size: 1rem;
	}

	.feedback-field textarea {
		min-height: 5.5rem;
		resize: vertical;
	}

	.feedback-field :is(input, select, textarea):focus {
		border-color: var(--accent);
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}

	.feedback-honeypot {
		position: absolute;
		left: -9999px;
		opacity: 0;
		pointer-events: none;
	}

	.feedback-status {
		min-height: 1rem;
		margin: 0;
		font-size: 0.75rem;
	}

	.feedback-status.is-error {
		color: var(--bad);
	}

	.feedback-status.is-success {
		color: var(--ok);
	}

	.feedback-status.is-loading {
		color: var(--muted);
	}

	.feedback-actions {
		display: flex;
		justify-content: flex-end;
		gap: var(--s2);
		margin-top: var(--s2);
	}

	.feedback-actions button {
		margin: 0;
		padding: 0.45rem 0.9rem;
		border-radius: var(--r);
		font-size: 0.82rem;
		cursor: pointer;
	}

	.feedback-secondary {
		border: 1px solid var(--line-field);
		background: transparent;
		color: var(--muted);
	}

	@media (hover: hover) and (pointer: fine) {
		.feedback-secondary:hover {
			color: var(--paper);
			border-color: var(--muted);
		}
	}

	.feedback-primary {
		border: 1px solid var(--accent);
		background: var(--accent);
		color: var(--accent-ink);
		font-weight: 600;
	}

	@media (hover: hover) and (pointer: fine) {
		.feedback-primary:hover {
			background: var(--accent-hover);
			border-color: var(--accent-hover);
		}
	}

	.feedback-primary:disabled {
		opacity: 0.7;
		cursor: wait;
	}

	@media (max-width: 720px) {
		.feedback-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.feedback-toast {
			left: max(0.75rem, var(--safe-left));
			right: max(0.75rem, var(--safe-right));
			bottom: calc(0.75rem + var(--safe-bottom));
			max-width: none;
		}

		/* A sheet, not a floating card: full width, anchored to the bottom
		   edge, and shorter than the visual viewport so the keyboard cannot
		   hide the Send button. */
		.feedback-dialog {
			width: 100%;
			max-height: min(90dvh, calc(var(--vvh, 100dvh) - 1.5rem));
			border-radius: var(--r-lg) var(--r-lg) 0 0;
		}

		.feedback-panel {
			padding: var(--s4) var(--s4) calc(var(--s4) + var(--safe-bottom));
		}
	}

	@media (pointer: coarse) {
		.feedback-dialog {
			/* A sheet sits on the screen edge, so its bottom corners are square
			   even when the width rule above does not fire (a tablet). */
			border-radius: var(--r-lg) var(--r-lg) 0 0;
		}

		.feedback-close {
			width: var(--tap);
			height: var(--tap);
			top: 0.35rem;
			right: 0.35rem;
		}

		.feedback-actions button {
			min-height: var(--tap);
		}
	}
</style>


<script define:vars={{ baseUrl }}>
	const dialog = document.getElementById("feedbackDialog");
	const form = document.getElementById("feedbackForm");
	const closeBtn = document.getElementById("feedbackCloseBtn");
	const cancelBtn = document.getElementById("feedbackCancelBtn");
	const submitBtn = document.getElementById("feedbackSubmitBtn");
	const statusEl = document.getElementById("feedbackStatus");
	const toastEl = document.getElementById("feedbackToast");
	const typeInput = document.getElementById("feedbackType");
	const messageInput = document.getElementById("feedbackMessage");
	const regInput = document.getElementById("feedbackRegNo");
	const pageInput = document.getElementById("feedbackPageInput");
	const pageLabel = document.getElementById("feedbackPageLabel");
	const contextInput = document.getElementById("feedbackContextInput");
	const cooldownKey = "beu_feedback_last_sent_at";
	const cooldownMs = 30000;
	let toastTimer = null;

	// Turnstile restore notes:
	// 1. bring back the widget markup and external script above
	// 2. reintroduce the turnstile window typings + `turnstileRoot`
	// 3. require `cf-turnstile-response` before submit and send it to the API

	function setStatus(kind, text) {
		statusEl.textContent = text;
		statusEl.className = "feedback-status";
		if (kind) {
			statusEl.classList.add(`is-${kind}`);
		}
	}

	function showToast(text) {
		if (!toastEl) return;
		toastEl.textContent = text;
		toastEl.classList.add("show");
		if (toastTimer) {
			clearTimeout(toastTimer);
		}
		toastTimer = setTimeout(() => {
			toastEl.classList.remove("show");
		}, 3200);
	}

	function getCooldownRemaining() {
		const lastSentAt = Number.parseInt(localStorage.getItem(cooldownKey) || "0", 10);
		if (!lastSentAt) return 0;
		return Math.max(0, cooldownMs - (Date.now() - lastSentAt));
	}

	function collectContext(trigger) {
		const url = new URL(window.location.href);
		const parts = [];
		const triggerContext = trigger?.dataset.feedbackContext?.trim();
		if (triggerContext) parts.push(triggerContext);
		const sem = url.searchParams.get("sem");
		const view = url.searchParams.get("view");
		if (sem) parts.push(`sem:${sem}`);
		if (view) parts.push(`view:${view}`);
		return parts.join(" | ");
	}

	function prepareDialog(trigger) {
		const url = new URL(window.location.href);
		const page = `${url.pathname}${url.search}${url.hash}` || "/";
		pageInput.value = page;
		pageLabel.textContent = page;
		contextInput.value = collectContext(trigger);
		const triggerType = trigger?.dataset.feedbackType?.trim();
		if (triggerType) {
			typeInput.value = triggerType;
		}
		const urlRegNo = url.searchParams.get("reg");
		if (!regInput.value && urlRegNo) {
			regInput.value = urlRegNo;
		}
		setStatus("", "");
	}

	function openDialog(trigger) {
		prepareDialog(trigger);
		window.beuTrack?.("feedback_open", { type: typeInput.value || "other" });
		if (typeof dialog.showModal === "function") {
			dialog.showModal();
			// Raising the keyboard on open hides the sheet's own copy behind it
			// and scrolls the page on iOS. A touch user taps the field when ready.
			if (window.matchMedia("(pointer: fine)").matches) {
				messageInput.focus();
			}
			return;
		}
		dialog.setAttribute("open", "open");
		if (window.matchMedia("(pointer: fine)").matches) {
			messageInput.focus();
		}
	}

	function closeDialog() {
		if (typeof dialog.close === "function") {
			dialog.close();
			return;
		}
		dialog.removeAttribute("open");
	}

	document.addEventListener("click", (event) => {
		const trigger = event.target instanceof Element
			? event.target.closest("[data-feedback-trigger]")
			: null;
		if (!trigger) return;
		event.preventDefault();
		openDialog(trigger);
	});

	dialog.addEventListener("click", (event) => {
		const bounds = dialog.getBoundingClientRect();
		const isInside =
			event.clientX >= bounds.left &&
			event.clientX <= bounds.right &&
			event.clientY >= bounds.top &&
			event.clientY <= bounds.bottom;
		if (!isInside) {
			closeDialog();
		}
	});

	closeBtn?.addEventListener("click", closeDialog);
	cancelBtn?.addEventListener("click", closeDialog);

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const remaining = getCooldownRemaining();
		if (remaining > 0) {
			setStatus("error", `Please wait ${Math.ceil(remaining / 1000)}s before sending another report.`);
			return;
		}

		const formData = new FormData(form);
		const message = String(formData.get("message") || "").trim();
		if (message.length < 10) {
			setStatus("error", "Please add a bit more detail so I can actually fix it.");
			messageInput.focus();
			return;
		}
		// Turnstile restore:
		// const turnstileToken = String(formData.get("cf-turnstile-response") || "").trim();
		// if (!turnstileToken) {
		// 	setStatus("error", "Please complete the verification check first.");
		// 	return;
		// }

		submitBtn.disabled = true;
		setStatus("loading", "Sending feedback...");

		try {
			const response = await fetch(`${baseUrl}api/feedback`, {
				method: "POST",
				headers: {
					"content-type": "application/json",
				},
				body: JSON.stringify({
					type: formData.get("type"),
					message,
					regNo: String(formData.get("regNo") || ""),
					contact: String(formData.get("contact") || ""),
					page: String(formData.get("page") || ""),
					context: String(formData.get("context") || ""),
					hp: String(formData.get("company") || ""),
					// turnstileToken,
				}),
			});

			const result = await response.json().catch(() => null);
			if (!response.ok || !result?.ok) {
				throw new Error(result?.message || "Feedback could not be sent right now.");
			}

			localStorage.setItem(cooldownKey, String(Date.now()));
			setStatus("success", result.message || "Sent. I'll check this.");
			showToast(result.message || "Sent. I'll check this.");
			// The type is the only thing worth knowing here: the message itself is
			// a person's words and never leaves this form's own channel.
			window.beuTrack?.("feedback_submit", { type: formData.get("type") || "other" });
			const preservedRegNo = regInput.value;
			form.reset();
			regInput.value = preservedRegNo;
			setTimeout(() => {
				closeDialog();
			}, 900);
		} catch (error) {
			setStatus("error", error instanceof Error ? error.message : "Feedback could not be sent right now.");
		} finally {
			submitBtn.disabled = false;
		}
	});
</script>

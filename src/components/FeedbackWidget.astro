---
const baseUrl = import.meta.env.BASE_URL;
// Turnstile is intentionally disabled for now.
// const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
// const turnstileEnabled = Boolean(turnstileSiteKey);
---

<div class="feedback-widget">
	<div id="feedbackToast" class="feedback-toast" aria-live="polite"></div>

	<dialog id="feedbackDialog" class="feedback-dialog glass-card">
		<button type="button" class="feedback-close" id="feedbackCloseBtn" aria-label="Close feedback form">
			&times;
		</button>

		<div class="feedback-panel">
			<div class="feedback-copy">
				<p class="feedback-eyebrow">Feedback</p>
				<h2>Bug, bad data, or feature idea</h2>
				<p class="feedback-intro">
					Short report is enough. Page is attached automatically.
				</p>
				<div class="feedback-page-pill">
					<span>Page</span>
					<code id="feedbackPageLabel">/</code>
				</div>
			</div>

			<form id="feedbackForm" class="feedback-form">
				<input
					type="text"
					name="company"
					class="feedback-honeypot"
					tabindex="-1"
					autocomplete="off"
					aria-hidden="true"
				/>
				<input type="hidden" name="page" id="feedbackPageInput" />
				<input type="hidden" name="context" id="feedbackContextInput" />

				<label class="feedback-field">
					<span>Type</span>
					<select name="type" id="feedbackType" required>
						<option value="bug">Bug report</option>
						<option value="wrong-data">Wrong data</option>
						<option value="feature">Feature request</option>
						<option value="other">Other</option>
					</select>
				</label>

				<label class="feedback-field feedback-field-wide">
					<span>Message</span>
					<textarea
						name="message"
						id="feedbackMessage"
						rows="3"
						maxlength="1200"
						placeholder="Example: Sem 5 result shows blank SGPA in modern view."
						required
					></textarea>
				</label>

				<div class="feedback-grid">
					<label class="feedback-field">
						<span>Reg no. (optional)</span>
						<input
							type="text"
							name="regNo"
							id="feedbackRegNo"
							inputmode="numeric"
							maxlength="20"
							placeholder="22105123019"
						/>
					</label>

					<label class="feedback-field">
						<span>Contact (optional)</span>
						<input
							type="text"
							name="contact"
							id="feedbackContact"
							maxlength="80"
							placeholder="Telegram @username"
						/>
					</label>
				</div>

				<!--
				<div class="feedback-verification">
					<div
						class="cf-turnstile"
						id="feedbackTurnstile"
						data-sitekey={turnstileSiteKey}
						data-theme="dark"
					></div>
				</div>
				-->

				<p id="feedbackStatus" class="feedback-status" role="status" aria-live="polite"></p>

				<div class="feedback-actions">
					<button type="button" class="feedback-secondary" id="feedbackCancelBtn">Close</button>
					<button type="submit" class="feedback-primary" id="feedbackSubmitBtn">Send</button>
				</div>
			</form>
		</div>
	</dialog>
</div>

<!-- <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script> -->

<style>
	.feedback-widget {
		position: relative;
	}

	.feedback-dialog {
		width: min(100%, 31rem);
		max-height: min(88dvh, 38rem);
		padding: 0;
		border: 1px solid rgba(45, 212, 191, 0.22);
		background:
			radial-gradient(circle at top right, rgba(45, 212, 191, 0.16), transparent 32%),
			linear-gradient(180deg, rgba(15, 23, 42, 0.98), rgba(2, 6, 23, 0.96));
		color: var(--text-primary);
		overflow: hidden;
	}

	.feedback-toast {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		z-index: 150;
		max-width: min(26rem, calc(100vw - 2rem));
		padding: 0.85rem 1rem;
		border-left: 4px solid #10b981;
		border-radius: 0.9rem;
		background: rgba(15, 23, 42, 0.96);
		box-shadow: 0 18px 40px rgba(2, 6, 23, 0.32);
		color: #ecfdf5;
		font-size: 0.84rem;
		font-weight: 700;
		opacity: 0;
		pointer-events: none;
		transform: translateY(18px);
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	.feedback-toast.show {
		opacity: 1;
		transform: translateY(0);
	}

	.feedback-dialog::backdrop {
		background: rgba(2, 6, 23, 0.72);
		backdrop-filter: blur(6px);
	}

	.feedback-close {
		position: absolute;
		top: 0.6rem;
		right: 0.6rem;
		z-index: 2;
		width: 1.8rem;
		height: 1.8rem;
		padding: 0;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.22);
		background: rgba(15, 23, 42, 0.5);
		color: var(--text-primary);
		font-size: 0.95rem;
		line-height: 1;
	}

	.feedback-panel {
		padding: 0.85rem;
		display: grid;
		gap: 0.7rem;
		overflow: auto;
	}

	.feedback-copy h2 {
		margin: 0.1rem 0 0.2rem;
		font-size: clamp(1rem, 2vw, 1.2rem);
		line-height: 1.2;
	}

	.feedback-eyebrow {
		margin: 0;
		color: #67e8f9;
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.feedback-intro {
		margin: 0;
		max-width: 42rem;
		font-size: 0.78rem;
		color: #cbd5e1;
	}

	.feedback-page-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-top: 0.5rem;
		padding: 0.32rem 0.55rem;
		border: 1px solid rgba(148, 163, 184, 0.14);
		border-radius: 999px;
		background: rgba(15, 23, 42, 0.4);
		font-size: 0.68rem;
	}

	.feedback-page-pill span {
		color: #94a3b8;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.feedback-page-pill code {
		max-width: min(68vw, 24rem);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: #f8fafc;
	}

	.feedback-form {
		display: grid;
		gap: 0.65rem;
	}

	.feedback-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
	}

	.feedback-field {
		display: grid;
		gap: 0.26rem;
	}

	.feedback-field span {
		font-size: 0.7rem;
		font-weight: 700;
		color: #dbeafe;
	}

	.feedback-field input,
	.feedback-field select,
	.feedback-field textarea {
		margin: 0;
		border: 1px solid rgba(148, 163, 184, 0.16);
		background: rgba(15, 23, 42, 0.62);
		color: #f8fafc;
		box-shadow: none;
	}

	.feedback-field textarea {
		resize: vertical;
		min-height: 5.8rem;
	}

	.feedback-field input,
	.feedback-field select,
	.feedback-field textarea,
	.feedback-actions button {
		font-size: 0.8rem;
	}

	.feedback-field input,
	.feedback-field select,
	.feedback-field textarea {
		padding: 0.5rem 0.65rem;
	}

	.feedback-field input:focus,
	.feedback-field select:focus,
	.feedback-field textarea:focus {
		border-color: rgba(34, 211, 238, 0.55);
		box-shadow: 0 0 0 0.18rem rgba(14, 165, 233, 0.14);
	}

	.feedback-honeypot {
		position: absolute;
		left: -9999px;
		opacity: 0;
		pointer-events: none;
	}

	.feedback-status {
		min-height: 0.95rem;
		margin: 0;
		font-size: 0.73rem;
		font-weight: 600;
	}

	.feedback-status.is-error {
		color: #fecaca;
	}

	.feedback-status.is-success {
		color: #bbf7d0;
	}

	.feedback-status.is-loading {
		color: #bae6fd;
	}

	/*
	.feedback-verification {
		display: grid;
		gap: 0.45rem;
	}

	.feedback-turnstile-missing {
		margin: 0;
		padding: 0.8rem 0.9rem;
		border: 1px solid rgba(248, 113, 113, 0.28);
		border-radius: 0.85rem;
		background: rgba(127, 29, 29, 0.18);
		color: #fecaca;
		font-size: 0.82rem;
	}
	*/

	.feedback-actions {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
		align-items: stretch;
	}

	.feedback-actions button {
		margin: 0;
		min-width: 0;
		padding: 0.55rem 0.7rem;
	}

	.feedback-secondary {
		background: rgba(15, 23, 42, 0.3);
		border: 1px solid rgba(148, 163, 184, 0.18);
		color: #dbeafe;
	}

	.feedback-primary {
		border: none;
		background: linear-gradient(135deg, #0d9488, #0284c7);
		color: #f8fafc;
	}

	.feedback-primary:disabled {
		opacity: 0.7;
		cursor: wait;
	}

	@media (max-width: 720px) {
		.feedback-panel {
			padding: 0.8rem;
		}

		.feedback-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.feedback-toast {
			left: 0.75rem;
			right: 0.75rem;
			bottom: 0.75rem;
			max-width: none;
		}

		.feedback-dialog {
			width: calc(100% - 1rem);
			max-height: min(90dvh, 34rem);
		}
	}
</style>

<script define:vars={{ baseUrl }}>
	const dialog = document.getElementById("feedbackDialog");
	const form = document.getElementById("feedbackForm");
	const closeBtn = document.getElementById("feedbackCloseBtn");
	const cancelBtn = document.getElementById("feedbackCancelBtn");
	const submitBtn = document.getElementById("feedbackSubmitBtn");
	const statusEl = document.getElementById("feedbackStatus");
	const toastEl = document.getElementById("feedbackToast");
	const typeInput = document.getElementById("feedbackType");
	const messageInput = document.getElementById("feedbackMessage");
	const regInput = document.getElementById("feedbackRegNo");
	const pageInput = document.getElementById("feedbackPageInput");
	const pageLabel = document.getElementById("feedbackPageLabel");
	const contextInput = document.getElementById("feedbackContextInput");
	const cooldownKey = "beu_feedback_last_sent_at";
	const cooldownMs = 30000;
	let toastTimer = null;

	// Turnstile restore notes:
	// 1. bring back the widget markup and external script above
	// 2. reintroduce the turnstile window typings + `turnstileRoot`
	// 3. require `cf-turnstile-response` before submit and send it to the API

	function setStatus(kind, text) {
		statusEl.textContent = text;
		statusEl.className = "feedback-status";
		if (kind) {
			statusEl.classList.add(`is-${kind}`);
		}
	}

	function showToast(text) {
		if (!toastEl) return;
		toastEl.textContent = text;
		toastEl.classList.add("show");
		if (toastTimer) {
			clearTimeout(toastTimer);
		}
		toastTimer = setTimeout(() => {
			toastEl.classList.remove("show");
		}, 3200);
	}

	function getCooldownRemaining() {
		const lastSentAt = Number.parseInt(localStorage.getItem(cooldownKey) || "0", 10);
		if (!lastSentAt) return 0;
		return Math.max(0, cooldownMs - (Date.now() - lastSentAt));
	}

	function collectContext(trigger) {
		const url = new URL(window.location.href);
		const parts = [];
		const triggerContext = trigger?.dataset.feedbackContext?.trim();
		if (triggerContext) parts.push(triggerContext);
		const sem = url.searchParams.get("sem");
		const view = url.searchParams.get("view");
		if (sem) parts.push(`sem:${sem}`);
		if (view) parts.push(`view:${view}`);
		return parts.join(" | ");
	}

	function prepareDialog(trigger) {
		const url = new URL(window.location.href);
		const page = `${url.pathname}${url.search}${url.hash}` || "/";
		pageInput.value = page;
		pageLabel.textContent = page;
		contextInput.value = collectContext(trigger);
		const triggerType = trigger?.dataset.feedbackType?.trim();
		if (triggerType) {
			typeInput.value = triggerType;
		}
		const urlRegNo = url.searchParams.get("reg");
		if (!regInput.value && urlRegNo) {
			regInput.value = urlRegNo;
		}
		setStatus("", "");
	}

	function openDialog(trigger) {
		prepareDialog(trigger);
		if (typeof dialog.showModal === "function") {
			dialog.showModal();
			messageInput.focus();
			return;
		}
		dialog.setAttribute("open", "open");
		messageInput.focus();
	}

	function closeDialog() {
		if (typeof dialog.close === "function") {
			dialog.close();
			return;
		}
		dialog.removeAttribute("open");
	}

	document.addEventListener("click", (event) => {
		const trigger = event.target instanceof Element
			? event.target.closest("[data-feedback-trigger]")
			: null;
		if (!trigger) return;
		event.preventDefault();
		openDialog(trigger);
	});

	dialog.addEventListener("click", (event) => {
		const bounds = dialog.getBoundingClientRect();
		const isInside =
			event.clientX >= bounds.left &&
			event.clientX <= bounds.right &&
			event.clientY >= bounds.top &&
			event.clientY <= bounds.bottom;
		if (!isInside) {
			closeDialog();
		}
	});

	closeBtn?.addEventListener("click", closeDialog);
	cancelBtn?.addEventListener("click", closeDialog);

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const remaining = getCooldownRemaining();
		if (remaining > 0) {
			setStatus("error", `Please wait ${Math.ceil(remaining / 1000)}s before sending another report.`);
			return;
		}

		const formData = new FormData(form);
		const message = String(formData.get("message") || "").trim();
		if (message.length < 10) {
			setStatus("error", "Please add a bit more detail so I can actually fix it.");
			messageInput.focus();
			return;
		}
		// Turnstile restore:
		// const turnstileToken = String(formData.get("cf-turnstile-response") || "").trim();
		// if (!turnstileToken) {
		// 	setStatus("error", "Please complete the verification check first.");
		// 	return;
		// }

		submitBtn.disabled = true;
		setStatus("loading", "Sending feedback...");

		try {
			const response = await fetch(`${baseUrl}api/feedback`, {
				method: "POST",
				headers: {
					"content-type": "application/json",
				},
				body: JSON.stringify({
					type: formData.get("type"),
					message,
					regNo: String(formData.get("regNo") || ""),
					contact: String(formData.get("contact") || ""),
					page: String(formData.get("page") || ""),
					context: String(formData.get("context") || ""),
					hp: String(formData.get("company") || ""),
					// turnstileToken,
				}),
			});

			const result = await response.json().catch(() => null);
			if (!response.ok || !result?.ok) {
				throw new Error(result?.message || "Feedback could not be sent right now.");
			}

			localStorage.setItem(cooldownKey, String(Date.now()));
			setStatus("success", result.message || "Sent. I'll check this.");
			showToast(result.message || "Sent. I'll check this.");
			const preservedRegNo = regInput.value;
			form.reset();
			regInput.value = preservedRegNo;
			setTimeout(() => {
				closeDialog();
			}, 900);
		} catch (error) {
			setStatus("error", error instanceof Error ? error.message : "Feedback could not be sent right now.");
		} finally {
			submitBtn.disabled = false;
		}
	});
</script>

---
// src/components/InstallBanner.astro
import Icon from "./Icon.astro";
---

<div id="pwa-install-banner" class="hidden install-banner">
  <div class="banner-content">
    <p class="banner-text">Install BEUConnect</p>
    <div class="banner-actions">
      <button id="pwa-install-btn" class="btn btn-primary">Install</button>
      <button id="pwa-close-btn" class="banner-close" aria-label="Dismiss install banner">
        <Icon name="x" size={16} />
      </button>
    </div>
  </div>
</div>

<!-- Modal for iOS Users -->
<dialog id="ios-install-modal" class="ios-modal">
  <article>
    <header>
      <h2>Add to home screen</h2>
      <button aria-label="Close" id="close-ios-modal" class="modal-close">
        <Icon name="x" size={16} />
      </button>
    </header>
    <ol>
      <li>Tap Share in Safari.</li>
      <li>Choose Add to Home Screen.</li>
    </ol>
  </article>
</dialog>

<style>
  .install-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    z-index: 9999;
    width: 100%;
    /* Bottom-fixed: clear the home indicator, not just the contents. */
    padding: var(--s3) max(var(--s4), var(--safe-right)) calc(var(--s3) + var(--safe-bottom)) max(var(--s4), var(--safe-left));
    border-top: 1px solid var(--line-strong);
    background: var(--surface);
    transform: translateY(100%);
    transition: transform 250ms var(--ease-drawer);
  }

  .install-banner.visible {
    transform: translateY(0);
  }

  .hidden {
    display: none;
  }

  .banner-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    max-width: var(--max);
    margin: 0 auto;
  }

  .banner-text {
    margin: 0;
    color: var(--paper);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .banner-actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--s2);
  }

  #pwa-install-btn {
    margin: 0;
    padding: 0.35rem 0.9rem;
    font-size: 0.8rem;
  }

  .banner-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--r);
    background: transparent;
    color: var(--faint);
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .banner-close:hover {
      color: var(--paper);
      background: var(--surface-2);
    }
  }

  .ios-modal {
    width: min(100% - 1rem, 24rem);
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--paper);
  }

  .ios-modal::backdrop {
    background: var(--scrim);
  }

  .ios-modal article {
    margin: 0;
    padding: var(--s5);
    background: transparent;
  }

  .ios-modal header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s3);
    margin-bottom: var(--s3);
  }

  .ios-modal h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
  }

  .modal-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: var(--r);
    background: transparent;
    color: var(--faint);
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .modal-close:hover {
      color: var(--paper);
      background: var(--surface-2);
    }
  }

  .ios-modal ol {
    display: grid;
    gap: var(--s2);
    margin: 0;
    padding-left: 1.1rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  /* The two controls on a bottom bar are the whole interaction; neither is
     allowed to be a 30px target. */
  @media (pointer: coarse) {
    #pwa-install-btn {
      min-height: var(--tap);
      padding-inline: 1.15rem;
    }

    .banner-close,
    .modal-close {
      width: var(--tap);
      height: var(--tap);
    }

    .ios-modal {
      width: 100%;
      margin: 0;
      border-radius: var(--r-lg) var(--r-lg) 0 0;
      padding-bottom: var(--safe-bottom);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .install-banner {
      transition: none;
    }
  }
</style>

<script>
  let deferredPrompt;
  const installBanner = document.getElementById('pwa-install-banner');
  const installBtn = document.getElementById('pwa-install-btn');
  const closeBtn = document.getElementById('pwa-close-btn');

  const iosModal = document.getElementById('ios-install-modal');
  const closeIosModal = document.getElementById('close-ios-modal');

  // 1. Detect iOS. iPadOS reports a Macintosh user agent, so platform alone
  //    misses every iPad; a touch-capable Mac is the tell.
  const isIos = () => {
    const nav = window.navigator;
    const userAgent = nav.userAgent.toLowerCase();
    if (/iphone|ipad|ipod/.test(userAgent)) return true;
    return /macintosh/.test(userAgent) && nav.maxTouchPoints > 1;
  };

  // 2. Check if already running as standalone (installed)
  const isStandalone = () => {
    return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  };

  // 3. Check if user dismissed recently (7 days)
  const shouldShowBanner = () => {
    if (!installBanner) return false;
    if (isStandalone()) return false;
    const dismissedAt = localStorage.getItem('beu_pwa_dismissed');
    if (!dismissedAt) return true;

    const daysSinceDismissed = (Date.now() - parseInt(dismissedAt)) / (1000 * 60 * 60 * 24);
    return daysSinceDismissed > 7; // Show again after 7 days
  };

  // 4. Show the banner with a smooth slide up
  const showBanner = () => {
    if (shouldShowBanner() && installBanner) {
      installBanner.classList.remove('hidden');
      // Small delay to allow CSS transition to trigger after removing 'hidden'
      setTimeout(() => {
        installBanner.classList.add('visible');
      }, 50);
    }
  };

  // 5. Wait for intent instead of a timer: a banner that slides in three
  //    seconds after load lands on top of whatever the student was reading,
  //    and can steal a tap already in progress.
  const armBanner = () => {
    let shown = false;
    const reveal = () => {
      if (shown) return;
      shown = true;
      window.removeEventListener('scroll', onScroll);
      clearTimeout(timer);
      showBanner();
    };
    const onScroll = () => {
      if (window.scrollY > window.innerHeight * 0.5) reveal();
    };
    const timer = setTimeout(reveal, 25000);
    window.addEventListener('scroll', onScroll, { passive: true });
  };

  // 6. Listen for the native prompt event (Android/Desktop)
  window.addEventListener('beforeinstallprompt', (e) => {
    // Prevent the mini-infobar from appearing on mobile
    e.preventDefault();
    // Stash the event so it can be triggered later.
    deferredPrompt = e;
    armBanner();
  });

  // Handle iOS specifically (since beforeinstallprompt doesn't fire on iOS)
  if (isIos() && !isStandalone()) {
    armBanner();
  }

  // 6. Handle Install Button Click
  if (installBtn) {
    installBtn.addEventListener('click', async () => {
      if (isIos()) {
        // Show iOS instruction modal
        if (iosModal && !iosModal.open) iosModal.showModal();
        if (installBanner) installBanner.classList.remove('visible');
        return;
      }

      if (deferredPrompt) {
        // Hide the install banner
        if (installBanner) installBanner.classList.remove('visible');

        // Show the native install prompt
        deferredPrompt.prompt();

        // Wait for the user to respond to the prompt
        const { outcome } = await deferredPrompt.userChoice;
        window.beuTrack?.('pwa_install', { outcome: outcome, platform: isIos() ? 'ios' : 'other' });
        if (outcome === 'accepted') {
          // Clear the prompt variable
          deferredPrompt = null;
        } else {
          // Save dismissal state
          localStorage.setItem('beu_pwa_dismissed', Date.now().toString());
        }
      } else {
        // Fallback if deferredPrompt is missing (e.g. desktop browsers without PWA flags enabled)
        // Just hide the banner, user might already have it or it's not supported
        if (installBanner) {
          installBanner.classList.remove('visible');
          setTimeout(() => installBanner.classList.add('hidden'), 400);
        }
      }
    });
  }

  // 7. Handle Close Button Click
  if (closeBtn) {
    closeBtn.addEventListener('click', () => {
      if (installBanner) {
        installBanner.classList.remove('visible');
        setTimeout(() => installBanner.classList.add('hidden'), 400); // Wait for transition
      }
      localStorage.setItem('beu_pwa_dismissed', Date.now().toString());
    });
  }

  // Handle iOS modal close
  if (closeIosModal) {
    closeIosModal.addEventListener('click', () => {
      if (iosModal) iosModal.close();
    });
  }

  // Track successful installation to hide UI
  window.addEventListener('appinstalled', () => {
    window.beuTrack?.('pwa_install', { outcome: 'installed' });
    if (installBanner) {
      installBanner.classList.remove('visible');
      installBanner.classList.add('hidden');
    }
    deferredPrompt = null;
  });
</script>

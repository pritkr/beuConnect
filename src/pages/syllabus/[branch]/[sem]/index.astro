---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from "../../../../layouts/Layout.astro";
import branchConfig from "../../../../assets/data/config.json";
import Header from "../../../../components/header.astro";
import Footer from "../../../../components/footer.astro";
import { getCanonicalPyqSubject, getPyqSubjectLookupKeys, slugifySubjectName } from "../../../../utils/pyqSubjects";

export async function getStaticPaths() {
	const paths = [];
	for (const branch of branchConfig.branches) {
		for (let sem = 1; sem <= 8; sem++) {
			paths.push({ params: { branch: branch.code, sem: String(sem) } });
		}
	}
	return paths;
}

const { branch, sem } = Astro.params;
const branchInfo = branchConfig.branches.find((b) => b.code === branch);
if (!branchInfo) throw new Error(`Unknown branch ${branch}`);

const syllabus = await import(
    `../../../../assets/data/branches/${branchInfo.file}.json`
);
const data = syllabus.default;
const semData = data && data.semesters ? data.semesters[sem] : undefined;

const allPapers = await getCollection('pyqs');
const pyqMap = new Map();
const pyqCodeMap = new Map();
allPapers.forEach(paper => {
    const canonicalSubject = getCanonicalPyqSubject(paper.data.metadata);
    pyqMap.set(canonicalSubject.slug, canonicalSubject.slug);
    getPyqSubjectLookupKeys(paper.data.metadata.subject).forEach((key) => {
        pyqMap.set(key, canonicalSubject.slug);
    });
    if (paper.data.metadata.subject_code) {
        pyqCodeMap.set(paper.data.metadata.subject_code, canonicalSubject.slug);
    }
});

function getPyqSlug(sub) {
    if (!sub) return null;
    const lookupKeys = sub.name ? getPyqSubjectLookupKeys(sub.name) : [];
    const fallbackSlug = sub.name ? slugifySubjectName(sub.name) : '';

    for (const key of [...lookupKeys, fallbackSlug]) {
        if (key && pyqMap.has(key)) {
            return pyqMap.get(key);
        }
    }

    if (sub.code && pyqCodeMap.has(sub.code)) {
        return pyqCodeMap.get(sub.code);
    }

    return null;
}
---

<Layout title={`Sem ${sem}-${branchInfo.code}`}>
    <Header />
    <h1>
        <a
            href={`${import.meta.env.BASE_URL}syllabus/${branchInfo.code}/`}
            style={`view-transition-name:${branchInfo.code}`}
            >←{branchInfo.name}</a>
    </h1>
    <h2 style={`view-transition-name:sem${sem}`}>Semester {sem}</h2>

    {
        semData && semData.subjects && semData.subjects.length ? (
            <section>
                {(() => {
                    const electivesI = semData.subjects.filter(
                        (s: any) =>
                            (s.electiveGroup || "") === "Program Elective I",
                    );
                    const electivesII = semData.subjects.filter(
                        (s: any) =>
                            (s.electiveGroup || "") === "Program Elective II",
                    );
                    const nonElectives = semData.subjects.filter(
                        (s: any) => !s.electiveGroup,
                    );
                    const nonPracticals = nonElectives.filter(
                        (s: any) =>
                            (s.type || "").toLowerCase() !== "practical",
                    );
                    const practicals = nonElectives.filter(
                        (s: any) =>
                            (s.type || "").toLowerCase() === "practical",
                    );
                    return (
                        <>
                            {nonPracticals.length ? <h3>Theory</h3> : null}
                            {nonPracticals.map((sub: any) => (
                                <details>
                                    <summary style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <span style="flex: 1; margin-right: 1rem;">
                                            <strong>{sub.name}</strong>
                                            {sub.code ? ` (${sub.code})` : ""}
                                            {` - ${sub.credits} Credits`}
                                        </span>
                                        {getPyqSlug(sub) ? (
                                            <a 
                                                href={`${import.meta.env.BASE_URL}pyqs/${getPyqSlug(sub)}`}
                                                role="button"
                                                class="outline"
                                                style="padding: 0.25rem 0.5rem; font-size: 0.75rem; text-decoration: none; border-radius: 4px; white-space: nowrap;"
                                                onclick="event.stopPropagation();"
                                                title="View Previous Year Questions"
                                            >
                                                📄 PYQs
                                            </a>
                                        ) : null}
                                    </summary>
                                    {sub.content
                                        ? (() => {
                                              const ltp =
                                                  sub.summary &&
                                                  typeof sub.summary ===
                                                      "object"
                                                      ? [
                                                            sub.summary
                                                                .lecture != null
                                                                ? `${sub.summary.lecture}L`
                                                                : null,
                                                            sub.summary
                                                                .tutorial !=
                                                            null
                                                                ? `${sub.summary.tutorial}T`
                                                                : null,
                                                            sub.summary
                                                                .practical !=
                                                            null
                                                                ? `${sub.summary.practical}P`
                                                                : null,
                                                        ]
                                                            .filter(Boolean)
                                                            .join(" + ")
                                                      : null;
                                              return (
                                                      <p style="white-space: pre-wrap; color: rgba(255, 255, 255, 0.95); font-size: 0.9rem; line-height: 1.6;">
                                                          {ltp ? `${ltp}\n` : ""}
                                                          {sub.content}
                                                      </p>
                                              );
                                          })()
                                        : null}
                                    {Array.isArray(sub.references) &&
                                    sub.references.length ? (
                                        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                                            <p style="font-weight: 700; color: rgba(255,255,255,0.9); margin-bottom: 0.5rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">References:</p>
                                            <div style="color: rgba(255,255,255,0.8); font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.4rem;">
                                                {sub.references.map(
                                                    (ref: any) => (
                                                        <div style="display: flex; gap: 0.5rem;"><span style="color: #60a5fa;">•</span> <span>{ref}</span></div>
                                                    ),
                                                )}
                                            </div>
                                        </div>
                                    ) : null}
                                </details>
                            ))}

                            {electivesI && electivesI.length ? (
                                <details>
                                    <summary>
                                        <strong>Program Elective I</strong>
                                    </summary>
                                    {electivesI.map((sub: any) => (

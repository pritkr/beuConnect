                                                              ? [
                                                                    sub.summary
                                                                        .lecture !=
                                                                    null
                                                                        ? `${sub.summary.lecture}L`
                                                                        : null,
                                                                    sub.summary
                                                                        .tutorial !=
                                                                    null
                                                                        ? `${sub.summary.tutorial}T`
                                                                        : null,
                                                                    sub.summary
                                                                        .practical !=
                                                                    null
                                                                        ? `${sub.summary.practical}P`
                                                                        : null,
                                                                ]
                                                                    .filter(
                                                                        Boolean,
                                                                    )
                                                                    .join(" + ")
                                                              : null;
                                                      return (
                                                            <p style="white-space: pre-wrap; color: rgba(255, 255, 255, 0.95); font-size: 0.9rem; line-height: 1.6;">
                                                                {ltp
                                                                    ? `${ltp}\n`
                                                                    : ""}
                                                                {sub.content}
                                                            </p>
                                                      );
                                                  })()
                                                : null}
                                            {Array.isArray(sub.references) &&
                                            sub.references.length ? (
                                                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                                                    <p style="font-weight: 700; color: rgba(255,255,255,0.9); margin-bottom: 0.5rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">References:</p>
                                                    <div style="color: rgba(255,255,255,0.8); font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.4rem;">
                                                        {sub.references.map(
                                                            (ref: any) => (
                                                                <div style="display: flex; gap: 0.5rem;"><span style="color: #60a5fa;">•</span> <span>{ref}</span></div>
                                                            ),
                                                        )}
                                                    </div>
                                                </div>
                                            ) : null}
                                        </details>
                                    ))}
                                </details>
                            ) : null}

                            {electivesII && electivesII.length ? (
                                <details>
                                    <summary>
                                        <strong>Program Elective II</strong>
                                    </summary>
                                    {electivesII.map((sub: any) => (
                                        <details>
                                            <summary style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                                <span style="flex: 1; margin-right: 1rem;">
                                                    <strong>{sub.name}</strong>
                                                    {sub.code ? ` (${sub.code})` : ""}
                                                    {` - ${sub.credits} Credits`}
                                                </span>
                                                {getPyqSlug(sub) ? (
                                                    <a 
                                                        href={`${import.meta.env.BASE_URL}pyqs/${getPyqSlug(sub)}`}
                                                        role="button"
                                                        class="outline"
                                                        style="padding: 0.25rem 0.5rem; font-size: 0.75rem; text-decoration: none; border-radius: 4px; white-space: nowrap;"
                                                        onclick="event.stopPropagation();"
                                                        title="View Previous Year Questions"
                                                    >
                                                        📄 PYQs
                                                    </a>
                                                ) : null}
                                            </summary>
                                            {sub.content
                                                ? (() => {
                                                      const ltp =
                                                          sub.summary &&
                                                          typeof sub.summary ===
                                                              "object"
                                                              ? [
                                                                    sub.summary
                                                                        .lecture !=
                                                                    null
                                                                        ? `${sub.summary.lecture}L`
                                                                        : null,
                                                                    sub.summary
                                                                        .tutorial !=
                                                                    null
                                                                        ? `${sub.summary.tutorial}T`
                                                                        : null,
                                                                    sub.summary
                                                                        .practical !=
                                                                    null
                                                                        ? `${sub.summary.practical}P`
                                                                        : null,
                                                                ]
                                                                    .filter(
                                                                        Boolean,
                                                                    )
                                                                    .join(" + ")
                                                              : null;
                                                      return (
                                                            <p style="white-space: pre-wrap; color: rgba(255, 255, 255, 0.95); font-size: 0.9rem; line-height: 1.6;">
                                                                {ltp
                                                                    ? `${ltp}\n`
                                                                    : ""}
                                                                {sub.content}
                                                            </p>
                                                      );
                                                  })()
                                                : null}
                                            {Array.isArray(sub.references) &&
                                            sub.references.length ? (
                                                <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                                                    <p style="font-weight: 700; color: rgba(255,255,255,0.9); margin-bottom: 0.5rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">References:</p>
                                                    <div style="color: rgba(255,255,255,0.8); font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.4rem;">
                                                        {sub.references.map(
                                                            (ref: any) => (
                                                                <div style="display: flex; gap: 0.5rem;"><span style="color: #60a5fa;">•</span> <span>{ref}</span></div>
                                                            ),
                                                        )}
                                                    </div>
                                                </div>
                                            ) : null}
                                        </details>
                                    ))}
                                </details>
                            ) : null}
                            {practicals.length ? <h3>Practical</h3> : null}
                            {practicals.map((sub: any) => (
                                <details>
                                    <summary style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                                        <span style="flex: 1; margin-right: 1rem;">
                                            <strong>{sub.name}</strong>
                                            {sub.code ? ` (${sub.code})` : ""}
                                            {` - ${sub.credits} Credits`}
                                        </span>
                                        {getPyqSlug(sub) ? (
                                            <a 
                                                href={`${import.meta.env.BASE_URL}pyqs/${getPyqSlug(sub)}`}
                                                role="button"
                                                class="outline"
                                                style="padding: 0.25rem 0.5rem; font-size: 0.75rem; text-decoration: none; border-radius: 4px; white-space: nowrap;"
                                                onclick="event.stopPropagation();"
                                                title="View Previous Year Questions"
                                            >
                                                📄 PYQs
                                            </a>
                                        ) : null}
                                    </summary>
                                    {sub.content
                                        ? (() => {
                                              const ltp =
                                                  sub.summary &&
                                                  typeof sub.summary ===
                                                      "object"
                                                      ? [
                                                            sub.summary
                                                                .lecture != null
                                                                ? `${sub.summary.lecture}L`
                                                                : null,
                                                            sub.summary
                                                                .tutorial !=
                                                            null
                                                                ? `${sub.summary.tutorial}T`
                                                                : null,
                                                            sub.summary
                                                                .practical !=
                                                            null
                                                                ? `${sub.summary.practical}P`
                                                                : null,
                                                        ]
                                                            .filter(Boolean)
                                                            .join(" + ")
                                                      : null;
                                              return (
                                                      <p style="white-space: pre-wrap; color: rgba(255, 255, 255, 0.95); font-size: 0.9rem; line-height: 1.6;">
                                                          {ltp ? `${ltp}\n` : ""}
                                                          {sub.content}
                                                      </p>
                                              );
                                          })()
                                        : null}
                                    {Array.isArray(sub.references) &&
                                    sub.references.length ? (
                                        <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);">
                                            <p style="font-weight: 700; color: rgba(255,255,255,0.9); margin-bottom: 0.5rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;">References:</p>
                                            <div style="color: rgba(255,255,255,0.8); font-size: 0.85rem; display: flex; flex-direction: column; gap: 0.4rem;">
                                                {sub.references.map(
                                                    (ref: any) => (
                                                        <div style="display: flex; gap: 0.5rem;"><span style="color: #60a5fa;">•</span> <span>{ref}</span></div>
                                                    ),
                                                )}
                                            </div>
                                        </div>
                                    ) : null}
                                </details>
                            ))}
                        </>
                    );
                })()}
            </section>
        ) : (
            <p>
                <em>Data not available for this semester yet.</em>
            </p>
        )
    }
    <Footer />
</Layout>

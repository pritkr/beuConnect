---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from "../../../../layouts/Layout.astro";
import branchConfig from "../../../../assets/data/config.json";
import AskAI from "../../../../components/AskAI.astro";
import BranchIcon from "../../../../components/BranchIcon.astro";
import SyllabusTopics from "../../../../components/SyllabusTopics.astro";
import { getCanonicalPyqSubject, getPyqSubjectLookupKeys, slugifySubjectName } from "../../../../utils/pyqSubjects";

export async function getStaticPaths() {
	const paths = [];
	for (const branch of branchConfig.branches) {
		for (let sem = 1; sem <= 8; sem++) {
			paths.push({ params: { branch: branch.code, sem: String(sem) } });
		}
	}
	return paths;
}

const { branch, sem } = Astro.params;
const branchInfo = branchConfig.branches.find((b) => b.code === branch);
if (!branchInfo) throw new Error(`Unknown branch ${branch}`);

const syllabus = await import(
    `../../../../assets/data/branches/${branchInfo.file}.json`
);
const data = syllabus.default;
const semData = data && data.semesters ? data.semesters[sem] : undefined;

const allPapers = await getCollection('pyqs');
const pyqMap = new Map();
const pyqCodeMap = new Map();
allPapers.forEach(paper => {
    const canonicalSubject = getCanonicalPyqSubject(paper.data.metadata);
    pyqMap.set(canonicalSubject.slug, canonicalSubject.slug);
    getPyqSubjectLookupKeys(paper.data.metadata.subject).forEach((key) => {
        pyqMap.set(key, canonicalSubject.slug);
    });
    if (paper.data.metadata.subject_code) {
        pyqCodeMap.set(paper.data.metadata.subject_code, canonicalSubject.slug);
    }
});

function getPyqSlug(sub) {
    if (!sub) return null;
    const lookupKeys = sub.name ? getPyqSubjectLookupKeys(sub.name) : [];
    const fallbackSlug = sub.name ? slugifySubjectName(sub.name) : '';

    for (const key of [...lookupKeys, fallbackSlug]) {
        if (key && pyqMap.has(key)) {
            return pyqMap.get(key);
        }
    }

    if (sub.code && pyqCodeMap.has(sub.code)) {
        return pyqCodeMap.get(sub.code);
    }

    return null;
}

const subjects = semData && Array.isArray(semData.subjects) ? semData.subjects : [];
const electivesI = subjects.filter((sub) => (sub.electiveGroup || "") === "Program Elective I");
const electivesII = subjects.filter((sub) => (sub.electiveGroup || "") === "Program Elective II");
const nonElectives = subjects.filter((sub) => !sub.electiveGroup);
const theory = nonElectives.filter((sub) => (sub.type || "").toLowerCase() !== "practical");
const practicals = nonElectives.filter((sub) => (sub.type || "").toLowerCase() === "practical");

// One loop over one shape: the four copies of the subject block used to be
// four hand-maintained copies of the same sixty lines.
const groups = [
    { label: "Theory", subjects: theory },
    { label: "Program Elective I", subjects: electivesI },
    { label: "Program Elective II", subjects: electivesII },
    { label: "Practical", subjects: practicals },
].filter((group) => group.subjects.length);
---

<Layout
    title={`${branchInfo.name} semester ${sem}`}
    description={`${branchInfo.name} semester ${sem} syllabus, subject by subject.`}
>
    <header class="page-head">
        <div>
            <p class="back">
                <a href={`${import.meta.env.BASE_URL}syllabus/${branchInfo.code}/`}><BranchIcon branch={branchInfo.code} size={13} />{branchInfo.name}</a>
            </p>
            <h1>Semester {sem}</h1>
        </div>
    </header>

    {
        groups.length ? (
            <section class="subjects" data-syllabus data-branch={branch} data-sem={sem}>
                {groups.map((group) => (
                    <section class="subject-group">
                        <h2>{group.label}</h2>
                        {group.subjects.map((sub: any) => (
                            <details class="subject" data-subject data-code={sub.code}>
                                <summary class="subject-summary">
                                    <span class="subject-title">
                                        <strong>{sub.name}</strong>
                                        {sub.code ? ` (${sub.code})` : ""}
                                        {` - ${sub.credits} Credits`}
                                    </span>
                                    {getPyqSlug(sub) ? (
                                        <a
                                            href={`${import.meta.env.BASE_URL}pyqs/${getPyqSlug(sub)}`}
                                            class="pyq-link"
                                            onclick="event.stopPropagation();"
                                            data-ga="pyq_subject_open"
                                            data-ga-params={JSON.stringify({ subject: sub.code, branch, sem, source: "syllabus" })}
                                        >
                                            PYQs
                                        </a>
                                    ) : null}
                                </summary>
                                <SyllabusTopics subject={sub} branch={branch} sem={sem} />
                                {Array.isArray(sub.references) && sub.references.length ? (
                                    <div class="references">
                                        <p class="references-label">References</p>
                                        <ul class="reference-list">
                                            {sub.references.map((ref: any) => (
                                                <li>{String(ref).replace(/^\s*\d+[.)]\s*/, "")}</li>
                                            ))}
                                        </ul>
                                    </div>
                                ) : null}
                            </details>
                        ))}
                    </section>
                ))}
            </section>
        ) : (
            <p class="empty">Syllabus is not available for this semester yet.</p>
        )
    }

    <AskAI variant="dialog" />
</Layout>

<script>
    // One delegated listener for the whole page: 48 syllabus pages carry a few
    // hundred checkboxes each, and per-topic listeners would be pure weight.
    const STORAGE_KEY = "beu_syllabus_done";
    const root = document.querySelector("[data-syllabus]");

    if (root instanceof HTMLElement) {
        const readDone = () => {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (!raw) return new Set<string>();
                const parsed = JSON.parse(raw);
                if (!Array.isArray(parsed)) return new Set<string>();
                return new Set(
                    parsed.filter((id): id is string => typeof id === "string"),
                );
            } catch {
                return new Set<string>();
            }
        };

        const writeDone = (done: Set<string>) => {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify([...done]));
            } catch {
                // Private mode or a full quota: the checkbox still works for this visit.
            }
        };

        const done = readDone();
        const boxes = root.querySelectorAll<HTMLInputElement>(
            'input[type="checkbox"][data-topic-id]',
        );

        for (const box of boxes) {
            box.checked = done.has(box.dataset.topicId || "");
        }

        const countChecked = (scope: Element) => {
            const all = scope.querySelectorAll('input[type="checkbox"][data-topic-id]');
            let checked = 0;
            for (const box of all) {
                if (box instanceof HTMLInputElement && box.checked) checked += 1;
            }
            return { checked, total: all.length };
        };

        const refreshUnit = (unit: Element) => {
            const out = unit.querySelector("[data-unit-progress]");
            if (!(out instanceof HTMLElement)) return;
            const { checked, total } = countChecked(unit);
            out.textContent = `${checked}/${total}`;
        };

        const refreshSubject = (subject: Element) => {
            const { checked, total } = countChecked(subject);
            const out = subject.querySelector("[data-subject-progress]");
            if (out instanceof HTMLElement) out.textContent = `${checked}/${total}`;
            const clear = subject.querySelector("[data-clear-subject]");
            if (clear instanceof HTMLElement) clear.hidden = checked === 0;
        };

        for (const subject of root.querySelectorAll("[data-subject]")) {
            refreshSubject(subject);
            for (const unit of subject.querySelectorAll("[data-unit-block]")) {
                refreshUnit(unit);
            }
        }

        // `toggle` does not bubble, so it is caught on the way down: one listener
        // for every subject on the page, and only an opening counts.
        root.addEventListener(
            "toggle",
            (event) => {
                const details = event.target;
                if (!(details instanceof HTMLDetailsElement) || !details.open) return;
                window.beuTrack?.("syllabus_subject_open", {
                    branch: root.dataset.branch || "",
                    sem: root.dataset.sem || "",
                    subject: details.dataset.code || "",
                });
            },
            true,
        );

        root.addEventListener("change", (event) => {
            const box = event.target;
            if (!(box instanceof HTMLInputElement) || box.type !== "checkbox") return;
            const id = box.dataset.topicId;
            if (!id) return;

            if (box.checked) done.add(id);
            else done.delete(id);
            writeDone(done);

            const unit = box.closest("[data-unit-block]");
            if (unit) refreshUnit(unit);
            const subject = box.closest("[data-subject]");
            if (subject) refreshSubject(subject);
            // A tick is the one thing that shows reading actually happened, as
            // opposed to the page merely being opened.
            window.beuTrack?.("syllabus_topic_toggle", {
                branch: root.dataset.branch || "",
                sem: root.dataset.sem || "",
                label: box.checked ? "mark" : "unmark",
            });
        });

        root.addEventListener("click", (event) => {
            const target = event.target;
            if (!(target instanceof Element)) return;
            const button = target.closest("[data-clear-subject]");
            if (!(button instanceof HTMLElement)) return;

            const subject = button.closest("[data-subject]");
            if (!subject) return;
            const key = button.dataset.subjectKey || "";
            if (!key) return;

            for (const box of subject.querySelectorAll<HTMLInputElement>(
                'input[type="checkbox"][data-topic-id]',
            )) {
                const id = box.dataset.topicId || "";
                if (!id.startsWith(`${key}:`)) continue;
                box.checked = false;
                done.delete(id);
            }
            writeDone(done);

            for (const unit of subject.querySelectorAll("[data-unit-block]")) {
                refreshUnit(unit);
            }
            refreshSubject(subject);
        });
    }
</script>

<style>
    .back {
        margin: 0 0 var(--s2);
        font-size: 0.78rem;
    }

    .back a {
        color: var(--faint);
        text-decoration: none;
    }

    @media (hover: hover) and (pointer: fine) {
        .back a:hover {
            color: var(--paper);
        }
    }

    h2 {
        margin: var(--s6) 0 var(--s2);
        color: var(--faint);
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 650;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .subject-group:first-child h2 {
        margin-top: 0;
    }

    details.subject {
        border-bottom: 1px solid var(--line);
    }

    .subject-summary {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--s3);
        padding: var(--s3) 0;
        cursor: pointer;
    }

    .subject-summary strong {
        color: var(--paper);
        font-weight: 600;
    }

    .subject-title {
        font-size: 0.9rem;
        color: var(--muted);
    }

    .subject-summary .subject-title strong {
        color: var(--paper);
    }

    .pyq-link {
        flex: 0 0 auto;
        color: var(--accent);
        font-size: 0.72rem;
        text-decoration: none;
        white-space: nowrap;
    }

    @media (hover: hover) and (pointer: fine) {
        .pyq-link:hover {
            text-decoration: underline;
            text-underline-offset: 0.2em;
        }
    }

    .references {
        max-width: var(--measure);
        margin: 0 0 var(--s3);
        padding-top: var(--s3);
        border-top: 1px solid var(--line);
    }

    .references-label {
        margin: 0 0 var(--s2);
        color: var(--faint);
        font-size: 0.68rem;
        font-weight: 650;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .reference-list {
        display: grid;
        gap: var(--s2);
        margin: 0;
        padding-left: 1rem;
        color: var(--muted);
        font-size: 0.82rem;
    }

    .empty {
        margin: var(--s5) 0;
        color: var(--faint);
    }
</style>

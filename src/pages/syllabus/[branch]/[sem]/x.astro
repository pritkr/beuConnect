---
export const prerender = true;
import Layout from "../../../../layouts/Layout.astro";
import branchConfig from "../../../../assets/data/config.json";

export async function getStaticPaths() {
  const paths = [];
  for (const branch of branchConfig.branches) {
    for (let sem = 1; sem <= 8; sem++) {
      paths.push({ params: { branch: branch.code, sem: String(sem) } });
    }
  }
  return paths;
}

const { branch, sem } = Astro.params;
const branchInfo = branchConfig.branches.find(b => b.code === branch);
if (!branchInfo) throw new Error(`Unknown branch ${branch}`);

const syllabus = await import(`../../../../assets/data/branches/${branchInfo.file}.json`);
const data = syllabus.default;
const semData = data && data.semesters ? data.semesters[sem] : undefined;
---

<Layout title={`${branchInfo.name} semester ${sem}`}>
  <header class="page-head">
    <div>
      <p class="back"><a href={`${import.meta.env.BASE_URL}syllabus/${branch}/`}>{branchInfo.name}</a></p>
      <h1>Semester {sem}</h1>
    </div>
  </header>

  {semData && semData.subjects && semData.subjects.length ? (
    <div class="subjects">
      {(() => {
        const nonPracticals = semData.subjects.filter((s: any) => (s.type || '').toLowerCase() !== 'practical');
        const practicals = semData.subjects.filter((s: any) => (s.type || '').toLowerCase() === 'practical');
        return (
          <>
            {nonPracticals.length ? <h2>Theory</h2> : null}
            {nonPracticals.map((sub: any) => (
              <details>
                <summary>
                  <strong>{sub.name}</strong>
                  {sub.code ? ` (${sub.code})` : ''}
                  {` · ${sub.credits} credits`}
                </summary>
                {sub.content ? (
                  (() => {
                    const ltp = (sub.summary && typeof sub.summary === 'object')
                      ? [
                          sub.summary.lecture != null ? `${sub.summary.lecture}L` : null,
                          sub.summary.tutorial != null ? `${sub.summary.tutorial}T` : null,
                          sub.summary.practical != null ? `${sub.summary.practical}P` : null,
                        ].filter(Boolean).join(' + ')
                      : null;
                    return (
                      <p>{ltp ? `${ltp}\n` : ''}{sub.content}</p>
                    );
                  })()
                ) : null}
                {Array.isArray(sub.references) && sub.references.length ? (
                  <div class="references">
                    <p class="label">References</p>
                    <ul>
                      {sub.references.map((ref: any) => (
                        <li>{ref}</li>
                      ))}
                    </ul>
                  </div>
                ) : null}
              </details>
            ))}
            {practicals.length ? <h2>Practical</h2> : null}
            {practicals.map((sub: any) => (
              <details>
                <summary>
                  <strong>{sub.name}</strong>
                  {sub.code ? ` (${sub.code})` : ''}
                  {` · ${sub.credits} credits`}
                </summary>
                {sub.content ? (
                  (() => {
                    const ltp = (sub.summary && typeof sub.summary === 'object')
                      ? [
                          sub.summary.lecture != null ? `${sub.summary.lecture}L` : null,
                          sub.summary.tutorial != null ? `${sub.summary.tutorial}T` : null,
                          sub.summary.practical != null ? `${sub.summary.practical}P` : null,
                        ].filter(Boolean).join(' + ')
                      : null;
                    return (
                      <p>{ltp ? `${ltp}\n` : ''}{sub.content}</p>
                    );
                  })()
                ) : null}
                {Array.isArray(sub.references) && sub.references.length ? (
                  <div class="references">
                    <p class="label">References</p>
                    <ul>
                      {sub.references.map((ref: any) => (
                        <li>{ref}</li>
                      ))}
                    </ul>
                  </div>
                ) : null}
              </details>
            ))}
          </>
        );
      })()}
    </div>
  ) : (
    <p class="empty">Syllabus is not available for this semester yet.</p>
  )}

  <style>
    .back {
      margin: 0 0 var(--s2);
      font-size: 0.78rem;
    }

    .back a {
      color: var(--faint);
      text-decoration: none;
    }

    @media (hover: hover) and (pointer: fine) {
      .back a:hover {
        color: var(--paper);
      }
    }

    .subjects {
      margin-top: var(--s5);
      border-top: 1px solid var(--line-strong);
    }

    h2 {
      margin: var(--s5) 0 var(--s2);
      color: var(--faint);
      font-family: var(--font-sans);
      font-size: 0.72rem;
      font-weight: 650;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    details {
      border-bottom: 1px solid var(--line);
    }

    summary {
      padding: var(--s3) 0;
      color: var(--muted);
      font-size: 0.9rem;
      cursor: pointer;
    }

    summary strong {
      color: var(--paper);
      font-weight: 600;
    }

    details p {
      max-width: var(--measure);
      margin: 0 0 var(--s3);
      color: var(--muted);
      font-size: 0.875rem;
      line-height: 1.65;
      white-space: pre-wrap;
    }

    .references {
      padding-top: var(--s3);
      border-top: 1px solid var(--line);
    }

    .label {
      margin: 0 0 var(--s2);
      color: var(--faint);
      font-size: 0.68rem;
      font-weight: 650;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .references ul {
      display: grid;
      gap: var(--s2);
      margin: 0 0 var(--s3);
      padding-left: 1rem;
      color: var(--muted);
      font-size: 0.82rem;
    }

    .empty {
      margin: var(--s5) 0;
      color: var(--faint);
    }
  </style>
</Layout>

---
export const prerender = true;
import branchConfig from "../../../assets/data/config.json";
import Layout from "../../../layouts/Layout.astro";
import BranchIcon from "../../../components/BranchIcon.astro";

export async function getStaticPaths() {
	return branchConfig.branches.map((branch) => ({
		params: { branch: branch.code },
	}));
}

const { branch } = Astro.params;
const branchInfo = branchConfig.branches.find((b) => b.code === branch);
if (!branchInfo) throw new Error(`Unknown branch: ${branch}`);

const syllabus = (await import(`../../../assets/data/branches/${branchInfo.file}.json`)).default;
const semesters = Array.from({ length: 8 }, (_, i) => {
	const sem = i + 1;
	const entry = syllabus?.semesters?.[String(sem)];
	const subjects = Array.isArray(entry?.subjects) ? entry.subjects : [];
	const credits = subjects.reduce((total, subject) => total + (Number(subject.credits) || 0), 0);
	return { sem, subjects: subjects.length, credits };
});
---

<Layout
    title={`${branchInfo.name} syllabus`}
    description={`${branchInfo.name} syllabus for semesters 1 to 8.`}
>
    <header class="page-head">
        <div>
            <p class="back">
                <a href={`${import.meta.env.BASE_URL}syllabus/`}>Syllabus</a>
            </p>
            <h1><BranchIcon branch={branch} size="0.7em" />{branchInfo.name}</h1>
            <p class="meta">Semesters 1–8</p>
        </div>
    </header>

    <ol class="semester-list">
        {
            semesters.map((entry) => (
                <li>
                    <a
                        href={`${import.meta.env.BASE_URL}syllabus/${branch}/${entry.sem}/`}
                        data-ga="syllabus_select"
                        data-ga-params={JSON.stringify({ branch, sem: entry.sem, scope: "semester" })}
                    >
                        <span class="num">Semester {entry.sem}</span>
                        {entry.subjects > 0 && (
                            <span class="detail num">
                                {entry.subjects} subjects
                                {entry.credits > 0 && ` · ${entry.credits} credits`}
                            </span>
                        )}
                        <span class="arrow" aria-hidden="true">→</span>
                    </a>
                </li>
            ))
        }
    </ol>

    <style>
        .back {
            margin: 0 0 var(--s2);
            font-size: 0.78rem;
        }

        .back a {
            color: var(--faint);
            text-decoration: none;
        }

        @media (hover: hover) and (pointer: fine) {
            .back a:hover {
                color: var(--paper);
            }
        }

        .semester-list {
            margin: var(--s5) 0 0;
            padding: 0;
            list-style: none;
            border-top: 1px solid var(--line-strong);
        }

        .semester-list li {
            border-bottom: 1px solid var(--line);
        }

        .semester-list a {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: var(--s4);
            padding: var(--s3) 0;
            color: var(--paper);
            font-size: 0.95rem;
            text-decoration: none;
        }

        @media (hover: hover) and (pointer: fine) {
            .semester-list a:hover .num {
                text-decoration: underline;
                text-underline-offset: 0.2em;
            }
        }

        /* Touch: the row confirms the tap while the next page loads. */
        .semester-list a:active .num {
            text-decoration: underline;
            text-underline-offset: 0.2em;
        }

        .detail {
            margin-left: auto;
            color: var(--faint);
            font-size: 0.8rem;
        }

        .arrow {
            color: var(--faint);
        }
    </style>
</Layout>

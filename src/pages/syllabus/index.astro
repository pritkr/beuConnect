---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import BranchIcon from "../../components/BranchIcon.astro";
import branchConfig from "../../assets/data/config.json";

const base = import.meta.env.BASE_URL;
---

<Layout
	title="BEU syllabus"
	description="Semester-wise B.Tech syllabus for six Bihar Engineering University branches: CSE, ECE, EE, Mechanical, Civil and EEE."
>
	<header class="page-head">
		<div>
			<h1>Syllabus</h1>
			<p class="meta">Six branches · Semesters 1–8</p>
		</div>
	</header>

	<div id="smart-syl-box" class="smart" hidden>
		<h2 id="smart-syl-title">—</h2>
		<a id="smart-syl-link" href="#">Open your semester</a>
	</div>

	<ul class="branch-list">
		{
			branchConfig.branches.map((branch) => (
				<li>
					<a
						href={`${base}syllabus/${branch.code}/`}
						data-ga="syllabus_select"
						data-ga-params={JSON.stringify({ branch: branch.code, scope: "branch" })}
					>
						<span class="branch-name"><BranchIcon branch={branch.code} size={17} />{branch.name}</span>
						<span class="branch-code mono">{branch.code.toUpperCase()}</span>
						<span class="branch-sem">Sem 1–8</span>
						<Icon name="arrow-right" size={16} class="go" />
					</a>
				</li>
			))
		}
	</ul>
</Layout>

<style>
	.smart {
		margin-bottom: var(--s5);
		padding: var(--s4) var(--s5);
		border-left: 3px solid var(--accent);
		border-radius: 0 var(--r) var(--r) 0;
		background: var(--accent-soft);
	}

	.smart h2 {
		margin: 0.15rem 0 var(--s3);
		font-size: 1.6rem;
	}

	.smart a {
		font-size: 0.85rem;
		font-weight: 600;
	}

	.branch-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.branch-list a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 4rem 6rem 1rem;
		align-items: center;
		gap: var(--s3);
		min-height: 3.6rem;
		padding: var(--s3) 0;
		border-bottom: 1px solid var(--line);
		color: var(--paper);
		text-decoration: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.branch-list a:hover {
			color: var(--accent);
		}
	}

	/* A tap has no hover to inherit, so the row lights up while pressed. */
	.branch-list a:active {
		color: var(--accent);
	}

	.branch-name {
		font-size: 1rem;
	}

	.branch-code,
	.branch-sem {
		color: var(--faint);
		font-size: 0.78rem;
	}

	.branch-code {
		font-family: var(--font-mono);
		letter-spacing: 0.04em;
	}

	.branch-sem {
		text-align: right;
	}

	.branch-list .go {
		color: var(--line-strong);
	}

	@media (hover: hover) and (pointer: fine) {
		.branch-list a:hover .go {
			color: var(--accent);
		}
	}

	.branch-list a:active .go {
		color: var(--accent);
	}

	@media (max-width: 560px) {
		.branch-list a {
			grid-template-columns: minmax(0, 1fr) auto;
			row-gap: 0.15rem;
		}

		.branch-code {
			grid-row: 2;
		}

		.branch-sem {
			grid-row: 2;
			text-align: left;
		}

		.branch-list .go {
			grid-row: 1 / span 2;
			grid-column: 2;
		}
	}
</style>

<script>
	import { getProfile } from "../../utils/profileManager";

	const box = document.getElementById("smart-syl-box");
	const title = document.getElementById("smart-syl-title");
	const link = document.getElementById("smart-syl-link") as HTMLAnchorElement | null;

	const profile = getProfile();

	if (box && title && link && profile?.branchName && profile.branchPath) {
		title.textContent = profile.branchName;
		link.href = `${import.meta.env.BASE_URL}syllabus/${profile.branchPath}/${
			profile.currentSem ? `${profile.currentSem}/` : ""
		}`;
		link.textContent = profile.currentSem
			? `Open semester ${profile.currentSem}`
			: "Open your branch";
		box.hidden = false;
	}
</script>

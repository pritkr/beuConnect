---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";

export const prerender = true;
---

<Layout title="404 - Page Not Found | BEUConnect">
    <Header />

    <section class="not-found-container">
        <div class="glass-card text-center error-card">
            <h1 class="gradient-text error-code">404</h1>
            <h2>Oops! Looks like you're lost.</h2>
            <p class="error-msg">
                The college campus is big, but this page doesn't exist anywhere
                on the map.
            </p>

            <div class="action-buttons">
                <a
                    href={import.meta.env.BASE_URL}
                    class="button primary glass-btn">Return to Home</a
                >
                <a
                    href={import.meta.env.BASE_URL + "result"}
                    class="button outline glass-btn">Check Results</a
                >
            </div>
        </div>
    </section>

    <style>
        .not-found-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 60vh;
            padding: 2rem;
        }

        .error-card {
            padding: 4rem 2rem;
            max-width: 600px;
            width: 100%;
            border-radius: 24px;
            animation: floatUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid rgba(128, 128, 128, 0.2);
        }

        .error-code {
            font-size: 8rem;
            line-height: 1;
            margin: 0 0 1rem 0;
            text-shadow: 0 10px 30px rgba(79, 70, 229, 0.3);
        }

        .gradient-text {
            background: linear-gradient(
                135deg,
                var(--pico-primary) 0%,
                #ec4899 100%
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            display: inline-block;
            font-weight: 900;
        }

        .error-card h2 {
            font-size: 2rem;
            margin-bottom: 1rem;
            font-weight: 700;
        }

        .error-msg {
            font-size: 1.1rem;
            color: var(--pico-muted-color);
            margin-bottom: 2.5rem;
        }

        .action-buttons {
            display: flex;
            gap: 1rem;
            justify-content: center;
            flex-wrap: wrap;
        }

        .glass-btn {
            border-radius: 50px;
            padding: 0.75rem 2rem;
            font-weight: 600;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .glass-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -10px var(--pico-primary-focus);
        }

        @keyframes floatUp {
            0% {
                opacity: 0;
                transform: translateY(40px) scale(0.95);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }
    </style>

    <Footer />
</Layout>

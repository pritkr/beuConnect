---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout title="Page not found">
	<div class="not-found">
		<p class="code mono">404</p>
		<h1>Page not found</h1>
		<p class="text">This address does not match any page on BEUConnect.</p>

		<div class="actions">
			<a href={import.meta.env.BASE_URL} class="btn btn-primary">Home</a>
			<a href={`${import.meta.env.BASE_URL}result`} class="btn btn-ghost">Results</a>
		</div>
	</div>
</Layout>

<style>
	.not-found {
		display: grid;
		align-content: center;
		gap: var(--s3);
		min-height: 55vh;
		max-width: 36rem;
	}

	.code {
		margin: 0;
		color: var(--line-strong);
		font-size: 0.9rem;
		letter-spacing: 0.2em;
	}

	.not-found h1 {
		font-size: clamp(2.2rem, 6vw, 3.4rem);
	}

	.text {
		margin: 0;
		color: var(--muted);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s2);
		margin-top: var(--s3);
	}
</style>

---
import Layout from "../layouts/Layout.astro";
import BranchIcon from "../components/BranchIcon.astro";
import { RoutineLookupError, resolveRoutineFromRegNo } from "../lib/routine/resolver";
import type {
	ResolvedStudentRoutine,
	RoutineBlock,
	RoutineDay,
} from "../lib/routine/types";

export const prerender = false;

type TableCell =
	| { kind: "empty"; span: number }
	| { kind: "block"; span: number; block: RoutineBlock };

type PageErrorCode = RoutineLookupError["code"] | "unknown";

function buildSegmentCells(
	day: RoutineDay,
	segmentStart: number,
	segmentEnd: number,
): TableCell[] {
	const cells: TableCell[] = [];
	let cursor = segmentStart;
	const blocks = day.blocks
		.filter(
			(block) =>
				block.startSlot >= segmentStart &&
				block.startSlot <= segmentEnd,
		)
		.sort((left, right) => left.startSlot - right.startSlot);

	for (const block of blocks) {
		if (block.startSlot > cursor) {
			cells.push({ kind: "empty", span: block.startSlot - cursor });
		}

		cells.push({ kind: "block", span: block.span, block });
		cursor = block.startSlot + block.span;
	}

	if (cursor <= segmentEnd) {
		cells.push({ kind: "empty", span: segmentEnd - cursor + 1 });
	}

	return cells;
}

/** Short, page-facing copy. The resolver's own messages stay untouched. */
const DISPLAY_ERROR: Record<string, string> = {
	upstream_unavailable: "Routine source did not respond.",
};

function displayError(code: PageErrorCode | null, message: string): string {
	return (code && DISPLAY_ERROR[code]) || message;
}

const params = Astro.url.searchParams;
const reg = params.get("reg")?.trim() || "";
const wantsProbe =
	params.get("probe") === "1" &&
	(Astro.request.headers.get("accept") || "").includes("application/json");

Astro.response.headers.set(
	"Cache-Control",
	"private, max-age=3600, stale-while-revalidate=86400",
);

let errorMessage = "";
let errorCode: PageErrorCode | null = null;
let routineResult: ResolvedStudentRoutine | null = null;

if (reg) {
	try {
		routineResult = await resolveRoutineFromRegNo(reg);
	} catch (error) {
		if (error instanceof RoutineLookupError) {
			errorMessage = error.message;
			errorCode = error.code;
		} else {
			errorMessage = "Routine could not be loaded right now.";
			errorCode = "unknown";
		}
	}
}

/*
 * Preflight for the client. The routine is server-rendered from `?reg=`, so
 * loading a saved number needs a navigation; this tells the client whether
 * that navigation would actually land on a routine before it commits.
 */
if (wantsProbe) {
	return new Response(
		JSON.stringify({
			ok: Boolean(routineResult),
			code: errorCode,
			message: errorMessage ? displayError(errorCode, errorMessage) : "",
		}),
		{
			status: 200,
			headers: {
				"content-type": "application/json; charset=utf-8",
				"cache-control": "no-store",
			},
		},
	);
}

const retryable =
	errorCode === "upstream_unavailable" || errorCode === "unknown";

const pageTitle = routineResult
	? `${routineResult.branchName} Routine | BEUConnect`
	: "Class Routine | BEUConnect";
const description = routineResult
	? `Compact class routine for ${routineResult.branchName}, semester ${routineResult.semester}, Government Engineering College Sheikhpura.`
	: "Compact class routine for Government Engineering College Sheikhpura using your saved registration number.";
---

<Layout title={pageTitle} description={description} wide={true}>

	<div class="routine-shell">
		{
			routineResult ? (
				<>
					<header class="page-head">
						<div>
							<h1>Routine</h1>
							<p class="meta">
								<span id="routineStudentName" hidden />
								<BranchIcon branch={routineResult.sourceBranchLabel} size={13} />{routineResult.sourceBranchLabel} · Sem {routineResult.semester} · {routineResult.batchLabel}
								{routineResult.routine.roomLabel ? ` · Room ${routineResult.routine.roomLabel}` : ""}
							</p>
						</div>
						{routineResult.routine.isStale && <p class="stale">Cached copy</p>}
					</header>

					<section class="timetable" aria-labelledby="timetable-heading">
						<div class="section-head">
							<h2 id="timetable-heading">Weekly timetable</h2>
							{routineResult.routine.sourceUrl && (
								<a href={routineResult.routine.sourceUrl} target="_blank" rel="noreferrer" class="external-link">
									Source
								</a>
							)}
						</div>
						<div class="table-wrap" tabindex="0">
							<table class="routine-table">
								<thead>
									<tr>
										<th scope="col">Day</th>
										<th scope="col">P1<br /><small>10:00-11:00</small></th>
										<th scope="col">P2<br /><small>11:00-12:00</small></th>
										<th scope="col">P3<br /><small>12:00-13:00</small></th>
										<th scope="col" class="recess-head">Break</th>
										<th scope="col">P4<br /><small>14:00-15:00</small></th>
										<th scope="col">P5<br /><small>15:00-16:00</small></th>
										<th scope="col">P6<br /><small>16:00-17:00</small></th>
									</tr>
								</thead>
								<tbody>
									{routineResult.routine.days.map((day) => (
										<tr>
											<th scope="row">{day.day}</th>
											{buildSegmentCells(day, 1, 3).map((cell) =>
												cell.kind === "empty" ? (
													<td colspan={cell.span} class="slot-empty">-</td>
												) : (
													<td colspan={cell.span} class="slot-block">
														<div class="block-subject">{cell.block.subject}</div>
														{(cell.block.room || cell.block.durationLabel || cell.block.type) && (
															<div class="block-meta">
																{cell.block.type && <span class="type-badge">{cell.block.type}</span>}
																{cell.block.room && <span>Room {cell.block.room}</span>}
																{cell.block.durationLabel && <span>{cell.block.durationLabel}</span>}
															</div>
														)}
													</td>
												),
											)}
											<td class="recess-cell">-</td>
											{buildSegmentCells(day, 4, 6).map((cell) =>
												cell.kind === "empty" ? (
													<td colspan={cell.span} class="slot-empty">-</td>
												) : (
													<td colspan={cell.span} class="slot-block">
														<div class="block-subject">{cell.block.subject}</div>
														{(cell.block.room || cell.block.durationLabel || cell.block.type) && (
															<div class="block-meta">
																{cell.block.type && <span class="type-badge">{cell.block.type}</span>}
																{cell.block.room && <span>Room {cell.block.room}</span>}
																{cell.block.durationLabel && <span>{cell.block.durationLabel}</span>}
															</div>
														)}
													</td>
												),
											)}
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</section>

					{routineResult.routine.papers.length > 0 && (
						<section class="papers" aria-labelledby="papers-heading">
							<div class="section-head">
								<h2 id="papers-heading">Subjects and faculty</h2>
							</div>
							<div class="paper-grid">
								{routineResult.routine.papers.map((paper) => (
									<div class="paper-item">
										<div class="paper-topline">
											<span class="paper-abbr">{paper.abbr}</span>
											<span class="paper-code">{paper.code}</span>
											<div class="paper-hours">
												<span>L:{paper.lectureHours}</span>
												<span>T:{paper.tutorialHours}</span>
												<span>P:{paper.practicalHours}</span>
											</div>
										</div>
										<h3>{paper.name}</h3>
										<p>{paper.faculty}</p>
									</div>
								))}
							</div>
						</section>
					)}
				</>
			) : (
				<div class={errorCode ? "state error" : "state"}>
					<h1>Routine</h1>
					<p id="routineStateMessage" role="status">
						{errorMessage ? displayError(errorCode, errorMessage) : ""}
					</p>
					<button type="button" id="routineRetryBtn" class="btn btn-secondary" hidden={!retryable}>
						Retry
					</button>
					<div id="saveInputContainer" hidden={!errorCode}>
						<form id="routineSaveForm" class="save" novalidate>
							<label class="field-label" for="routineRegInput">Registration number</label>
							<div class="save-row">
								<input
									type="text"
									id="routineRegInput"
									name="reg"
									value={reg}
									placeholder="23105157001"
									autocomplete="off"
									inputmode="numeric"
									maxlength="11"
									spellcheck="false"
									enterkeyhint="go"
									aria-describedby="routineRegError"
								/>
								<button type="submit" id="routineRegBtn" class="btn btn-primary">Save and load</button>
							</div>
							<p id="routineRegError" class="field-error" role="alert" hidden />
						</form>
					</div>
				</div>
			)
		}
	</div>

</Layout>

<script>
	import { inferCurrentSemester } from "../lib/beuReg";
	import { fetchStudent } from "../lib/students/client";
	import { getProfile, parseRegNo, saveProfile } from "../utils/profileManager";

	const stateMessage = document.getElementById("routineStateMessage");
	const saveContainer = document.getElementById("saveInputContainer");
	const saveForm = document.getElementById("routineSaveForm");
	const regInput = document.querySelector<HTMLInputElement>("#routineRegInput");
	const saveBtn = document.querySelector<HTMLButtonElement>("#routineRegBtn");
	const retryBtn = document.querySelector<HTMLButtonElement>("#routineRetryBtn");
	const regError = document.getElementById("routineRegError");
	const nameEl = document.getElementById("routineStudentName");

	const urlReg = (new URL(window.location.href).searchParams.get("reg") ?? "").trim();
	let storedReg = (getProfile()?.regNo ?? "").trim();
	let busy = false;

	const routineHref = (value: string) => {
		const next = new URL(window.location.href);
		next.searchParams.set("reg", value);
		next.searchParams.delete("probe");
		return next;
	};

	function setBusy(next: boolean) {
		busy = next;
		if (saveBtn) saveBtn.disabled = next;
		if (retryBtn) retryBtn.disabled = next;
	}

	function setRegError(message: string) {
		if (regError) {
			regError.textContent = message;
			regError.hidden = !message;
		}
		if (regInput) {
			if (message) regInput.setAttribute("aria-invalid", "true");
			else regInput.removeAttribute("aria-invalid");
		}
	}

	function showState(
		message: string,
		options: { error?: boolean; retry?: boolean } = {},
	) {
		if (!stateMessage) return;
		stateMessage.textContent = message;
		stateMessage.closest(".state")?.classList.toggle("error", Boolean(options.error));
		if (retryBtn) retryBtn.hidden = !options.retry;
	}

	function offerSave(value: string) {
		if (!saveContainer) return;
		saveContainer.hidden = false;
		if (regInput && !regInput.value) regInput.value = value;
	}

	async function probeRoutine(value: string) {
		const target = routineHref(value);
		target.searchParams.set("probe", "1");
		try {
			const response = await fetch(target.toString(), {
				headers: { accept: "application/json" },
				cache: "no-store",
			});
			if (!response.ok) return null;
			const payload = (await response.json()) as {
				ok?: boolean;
				code?: string | null;
				message?: string;
			};
			return {
				ok: payload?.ok === true,
				code: typeof payload?.code === "string" ? payload.code : "",
				message: typeof payload?.message === "string" ? payload.message : "",
			};
		} catch {
			return null;
		}
	}

	async function resolveName(value: string) {
		if (!nameEl) return;
		const student = await fetchStudent(value);
		if (!student?.name) return;
		nameEl.textContent = `${student.name} · `;
		nameEl.hidden = false;
		if (storedReg === value && getProfile()?.name !== student.name) {
			saveProfile({ name: student.name });
		}
	}

	async function openRoutine(value: string) {
		if (busy) return;
		if (stateMessage) {
			showState("Loading…");
		}
		setBusy(true);

		const outcome = await probeRoutine(value);
		if (outcome?.ok) {
			window.location.replace(routineHref(value).toString());
			return;
		}

		// Keep this page: show what went wrong and make the number correctable.
		window.history.replaceState(null, "", routineHref(value).toString());
		const retry =
			outcome === null ||
			outcome.code === "upstream_unavailable" ||
			outcome.code === "unknown";
		showState(
			outcome === null
				? "Could not reach the server."
				: outcome.message || "Routine could not be loaded right now.",
			{ error: true, retry },
		);
		offerSave(value);
		setBusy(false);
	}

	async function handleSave() {
		if (busy) return;
		const value = (regInput?.value ?? "").replace(/\D+/g, "").slice(0, 11);
		if (regInput) regInput.value = value;

		if (value.length !== 11) {
			setRegError("Enter the 11-digit registration number.");
			regInput?.focus();
			return;
		}

		setRegError("");
		const previous = getProfile();
		const parsed = parseRegNo(value);
		if (typeof parsed.batchYear === "number") {
			parsed.currentSem = inferCurrentSemester(parsed.batchYear);
		}
		// A different number must not inherit the previous student's name or scores.
		saveProfile(
			previous?.regNo && previous.regNo !== value
				? { ...parsed, name: undefined, lastSgpa: undefined, lastCgpa: undefined }
				: parsed,
		);
		storedReg = value;

		setBusy(true);
		const student = await fetchStudent(value);
		if (student?.name) saveProfile({ name: student.name });
		setBusy(false);

		await openRoutine(value);
	}

	if (nameEl) {
		void resolveName(urlReg || storedReg);
	}

	if (!urlReg && storedReg) {
		void openRoutine(storedReg);
	} else if (!urlReg && !storedReg) {
		// No helper sentence: the labelled field and its button are the state.
		showState("");
		offerSave("");
	} else if (urlReg && !storedReg) {
		// Shared link: keep the resolver's error, offer to save the number.
		offerSave(urlReg);
	}

	regInput?.addEventListener("input", () => {
		const digits = regInput.value.replace(/\D+/g, "").slice(0, 11);
		if (regInput.value !== digits) regInput.value = digits;
		if (regError && !regError.hidden) setRegError("");
	});

	// maxlength would otherwise truncate a pasted "24-105 157-010" at 11 chars.
	regInput?.addEventListener("paste", (event) => {
		const text = event.clipboardData?.getData("text/plain") ?? "";
		const digits = text.replace(/\D+/g, "").slice(0, 11);
		if (!digits) return;
		event.preventDefault();
		regInput.value = digits;
		setRegError("");
	});

	saveForm?.addEventListener("submit", (event) => {
		event.preventDefault();
		void handleSave();
	});

	retryBtn?.addEventListener("click", () => {
		const value = (urlReg || storedReg || regInput?.value || "").replace(/\D+/g, "");
		if (value) void openRoutine(value);
	});
</script>

<style>
	.routine-shell {
		display: grid;
		gap: var(--s5);
	}

	/* The shell's gap is the space under the header. */
	.routine-shell > .page-head { margin-bottom: 0; }

	.page-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s4);
	}

	.page-head .meta {
		margin: 0;
	}

	#routineStudentName {
		color: var(--paper);
		font-weight: 600;
	}

	.stale {
		margin: 0;
		color: var(--warn);
		font-size: 0.75rem;
	}

	.timetable,
	.papers,
	.state {
		display: grid;
		gap: var(--s3);
		padding-top: var(--s4);
		border-top: 1px solid var(--line-strong);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s3);
	}

	.section-head h2 {
		margin: 0;
		color: var(--faint);
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.external-link {
		color: var(--faint);
		font-size: 0.78rem;
		text-decoration: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.external-link:hover {
			color: var(--paper);
			text-decoration: underline;
			text-underline-offset: 0.2em;
		}
	}

	.table-wrap {
		overflow-x: auto;
		overscroll-behavior-x: contain;
		border: 1px solid var(--line);
		border-radius: var(--r);
		background: var(--surface);
	}

	.routine-table {
		width: 100%;
		min-width: 720px;
		margin: 0;
		border-collapse: collapse;
		font-size: 0.78rem;
		font-variant-numeric: tabular-nums;
	}

	.routine-table th,
	.routine-table td {
		padding: 0.5rem;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		text-align: left;
		vertical-align: top;
	}

	.routine-table thead th {
		background: var(--surface-2);
		color: var(--faint);
		font-size: 0.66rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.routine-table thead th small {
		color: var(--faint);
		font-size: 0.6rem;
		font-weight: 400;
		letter-spacing: 0;
		text-transform: none;
	}

	.routine-table tbody th {
		min-width: 3.2rem;
		background: var(--surface-2);
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 500;
	}

	.routine-table tr > :last-child {
		border-right: 0;
	}

	.routine-table tbody tr:last-child > * {
		border-bottom: 0;
	}

	.slot-block {
		border-left: 2px solid var(--accent);
		background: var(--accent-soft);
	}

	.slot-empty,
	.recess-cell,
	.recess-head {
		background: var(--bg);
		color: var(--faint);
		text-align: center;
	}

	.block-subject {
		color: var(--paper);
		font-size: 0.78rem;
		font-weight: 600;
		line-height: 1.3;
	}

	.block-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.25rem;
		color: var(--faint);
		font-size: 0.66rem;
	}

	.type-badge {
		color: var(--accent);
		font-weight: 650;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.paper-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
		gap: 0;
		border-top: 1px solid var(--line);
	}

	.paper-item {
		padding: var(--s3) var(--s3) var(--s3) 0;
		border-bottom: 1px solid var(--line);
	}

	.paper-topline {
		display: flex;
		align-items: baseline;
		gap: var(--s2);
		margin-bottom: 0.3rem;
	}

	.paper-abbr {
		color: var(--accent);
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.04em;
	}

	.paper-code {
		color: var(--faint);
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}

	.paper-hours {
		display: flex;
		gap: var(--s2);
		margin-left: auto;
		color: var(--faint);
		font-size: 0.65rem;
		font-variant-numeric: tabular-nums;
	}

	.paper-item h3 {
		margin: 0;
		color: var(--paper);
		font-size: 0.85rem;
		font-weight: 500;
		line-height: 1.35;
	}

	.paper-item p {
		margin: 0.15rem 0 0;
		color: var(--faint);
		font-size: 0.75rem;
	}

	.state {
		max-width: 34rem;
		justify-items: start;
	}

	.state h1 {
		margin: 0;
	}

	.state p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.state p:empty {
		display: none;
	}

	.state.error p {
		color: var(--bad);
	}

	#routineRetryBtn {
		justify-self: start;
	}

	#saveInputContainer {
		display: grid;
		width: 100%;
	}

	.save {
		display: grid;
		gap: var(--s2);
		margin: 0;
	}

	.save-row {
		display: flex;
		gap: var(--s2);
	}

	.save-row input {
		flex: 1;
		min-width: 0;
		margin: 0;
		font-variant-numeric: tabular-nums;
	}

	.save-row .btn {
		flex: 0 0 auto;
	}

	.field-error {
		margin: 0;
		color: var(--bad);
		font-size: 0.78rem;
	}

	@media (max-width: 640px) {
		.routine-table {
			min-width: 640px;
			font-size: 0.7rem;
		}

		.save-row {
			flex-direction: column;
		}
	}
</style>

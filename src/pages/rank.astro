---
export const prerender = false;
import Layout from "../layouts/Layout.astro";
import { lookupRank } from "../lib/rank/lookup";

const regParam = Astro.url.searchParams.get("reg")?.trim() ?? "";
const digits = regParam.replace(/\D/g, "");

/* Every batch sits in one semester, so the register alone picks the file. */
const SEMESTER_BY_BATCH: Record<string, number> = {
	"21": 8,
	"22": 6,
	"23": 4,
	"24": 2,
	"25": 1,
};

let errorMsg = "";
let studentData = null;

if (digits.length >= 8) {
	const semester = SEMESTER_BY_BATCH[digits.slice(0, 2)];
	if (!semester) {
		errorMsg = "we don't have your data";
	} else {
		const result = await lookupRank(Astro.url.origin, digits, semester);
		if (result.status === "ok") {
			studentData = result.data;
		} else if (result.status === "not_found") {
			errorMsg = "No result data is available for this registration number yet.";
		} else {
			errorMsg = "we don't have your data";
		}
	}
} else if (regParam) {
	errorMsg = "Enter a valid BEU registration number.";
}

---

<Layout
	title="BEU rank"
	description="Find a Bihar Engineering University student's rank within their branch and across the whole university."
>
	<header class="page-head">
		<div>
			<h1>Rank</h1>
			<p class="meta">Based on stored result data</p>
		</div>
	</header>

	{
		!studentData && (
			<div class="rank-form">
				<form method="GET" action="">
					<label class="field-label" for="reg">Registration number</label>
					<div class="rank-input">
						<input
							type="text"
							id="reg"
							name="reg"
							inputmode="numeric"
							placeholder="23105157001"
							required
							value={regParam || ""}
						/>
						<button type="submit" class="btn-primary">Check rank</button>
					</div>
				</form>

				{errorMsg && <p class="form-status is-error" role="alert">{errorMsg}</p>}
			</div>
		)
	}

	{
		studentData && (
			<div class="rank-result">
				<div class="student">
					<h2>{studentData.name}</h2>
					<p class="mono">{studentData.reg}</p>
					<p>{studentData.collegeCode} — {studentData.collegeName}</p>
				</div>

				<dl class="rank-stats">
					<div>
						<dt>University rank</dt>
						<dd class="num">#{studentData.universityRank}</dd>
						<dd class="sub num">of {studentData.universityTotal.toLocaleString("en-IN")}</dd>
					</div>
					<div>
						<dt>Branch rank</dt>
						<dd class="num">#{studentData.branchRank}</dd>
						<dd class="sub num">of {studentData.branchTotal.toLocaleString("en-IN")}</dd>
					</div>
					<div>
						<dt>CGPA</dt>
						<dd class="num">{studentData.cgpa.toFixed(2)}</dd>
					</div>
					<div>
						<dt>Sem {studentData.semester} SGPA</dt>
						<dd class="num">{studentData.sgpa === null ? "—" : studentData.sgpa.toFixed(2)}</dd>
					</div>
				</dl>

				<div class="rank-actions">
					<a
						href={`${import.meta.env.BASE_URL}result-table?session=${studentData.batch}&branch=${studentData.branchSlug}&semester=${studentData.semester}&college=${studentData.collegeCode}`}
						class="btn btn-ghost"
					>
						Result table
					</a>
					<a
						href={`${import.meta.env.BASE_URL}result?reg=${studentData.reg}&sem=${studentData.semester}`}
						class="btn btn-primary"
					>
						Full result
					</a>
				</div>
			</div>
		)
	}
</Layout>

<style>
	.rank-form {
		max-width: 30rem;
		padding: var(--s5);
		border: 1px solid var(--line);
		border-radius: var(--r-lg);
		background: var(--surface);
	}

	.rank-form form {
		display: grid;
		gap: 0.35rem;
		margin: 0;
	}

	.rank-input {
		display: flex;
		gap: var(--s2);
	}

	.rank-input input {
		flex: 1;
		min-width: 0;
		font-variant-numeric: tabular-nums;
	}

	.rank-input button {
		flex: 0 0 auto;
	}

	.rank-result {
		display: grid;
		gap: var(--s5);
		max-width: 44rem;
	}

	.student h2 {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 400;
	}

	.student p {
		margin: 0.15rem 0 0;
		font-size: 0.85rem;
	}

	.rank-stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		margin: 0;
		border-top: 1px solid var(--line-strong);
	}

	.rank-stats div {
		padding: var(--s4) 0;
		border-bottom: 1px solid var(--line);
	}

	.rank-stats dt {
		color: var(--faint);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.rank-stats dd {
		margin: 0.15rem 0 0;
		color: var(--paper);
		font-family: var(--font-display);
		font-size: 2rem;
		line-height: 1;
	}

	.rank-stats dd.sub {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		color: var(--faint);
	}

	.rank-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s2);
	}

	@media (max-width: 560px) {
		.rank-stats {
			grid-template-columns: 1fr;
		}

		.rank-input {
			flex-direction: column;
		}
	}
</style>

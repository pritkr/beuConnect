---
export const prerender = false;
import Layout from "../layouts/Layout.astro";

const regParam = Astro.url.searchParams.get("reg")?.trim();
let errorMsg = "";
let studentData = null;

let batch = "";
let branch = "";
let targetSem = "";

let branchRank = 0;
let totalBranchStudents = 0;
let overallRank = 0;
let totalStudents = 0;

let cseCode = "";

if (regParam) {
	const numericReg = regParam.replace(/\D/g, "");
	if (numericReg.length >= 8) {
		batch = numericReg.substring(0, 2);
		branch = numericReg.substring(2, 5);
		
		if (batch === "25") targetSem = "1";
		else if (batch === "24") targetSem = "2";
		else if (batch === "23") targetSem = "4";
		else if (batch === "22") targetSem = "6";
		else if (batch === "21") targetSem = "8";
		else errorMsg = "we don't have your data";

		if (targetSem) {
			const baseUrl = Astro.url.origin;
			const branchesToFetch = ["101", "102", "103", "104", "105", "106", "110", "161"];
			
			const allStudents = [];
			
			await Promise.all(branchesToFetch.map(async (b) => {
				try {
					const res = await fetch(`${baseUrl}/data/students_${batch}_all_${b}_sem${targetSem}.csv`);
					if (res.ok) {
						const text = await res.text();
						const lines = text.split(/\r?\n/).filter(line => line.trim() !== "");
						for (let i = 1; i < lines.length; i++) {
							let cur = "";
							let inQuotes = false;
							const row = [];
							const line = lines[i];
							for (let j = 0; j < line.length; j++) {
								const char = line[j];
								if (inQuotes) {
									if (char === '"') {
										if (j + 1 < line.length && line[j+1] === '"') {
											cur += '"';
											j++;
										} else inQuotes = false;
									} else cur += char;
								} else {
									if (char === '"') inQuotes = true;
									else if (char === ',') { row.push(cur); cur = ""; }
									else cur += char;
								}
							}
							row.push(cur);
							
							if (row.length >= 5) {
								const cgpaText = row[4];
								const sgpaText = row[3];
								
								const cgpa = cgpaText && cgpaText !== "N/A" && cgpaText !== "NULL" ? parseFloat(cgpaText) : null;
								const sgpa = sgpaText && sgpaText !== "N/A" && sgpaText !== "NULL" ? parseFloat(sgpaText) : null;

								if (!isNaN(cgpa)) {
									allStudents.push({
										reg: row[1],
										name: row[2],
										sgpa: isNaN(sgpa) ? null : sgpa,
										cgpa: isNaN(cgpa) ? null : cgpa,
										branch: b,
										collegeCode: row[5],
										collegeName: row[6]
									});
								}
							}
						}
					}
				} catch (e) {
					// Ignore missing branches
				}
			}));
			

			if (allStudents.length === 0) {
				errorMsg = "we don't have your data";
			} else {
				// Remove duplicates based on reg number
				const uniqueMap = new Map();
				allStudents.forEach(s => {
					if (!uniqueMap.has(s.reg)) {
						uniqueMap.set(s.reg, s);
					}
				});
				const uniqueStudents = Array.from(uniqueMap.values());
				
				// Sort by CGPA desc, then SGPA desc, then RegNo (to match result-table exactly)
				uniqueStudents.sort((a, b) => {
					if (a.cgpa === null && b.cgpa === null) return a.reg.localeCompare(b.reg);
					if (a.cgpa === null) return 1;
					if (b.cgpa === null) return -1;
					if (b.cgpa !== a.cgpa) return b.cgpa - a.cgpa;
					
					if (a.sgpa === null && b.sgpa === null) return a.reg.localeCompare(b.reg);
					if (a.sgpa === null) return 1;
					if (b.sgpa === null) return -1;
					if (b.sgpa !== a.sgpa) return b.sgpa - a.sgpa;
					
					return a.reg.localeCompare(b.reg);
				});
				
				// Assign ranks
				let currentOverallRank = 0;
				let overallRankableCount = 0;
				let previousOverallCgpa = null;
				for (let i = 0; i < uniqueStudents.length; i++) {
					overallRankableCount++;
					if (previousOverallCgpa === null || Math.abs(uniqueStudents[i].cgpa - previousOverallCgpa) > 1e-9) {
						currentOverallRank = overallRankableCount;
						previousOverallCgpa = uniqueStudents[i].cgpa;
					}
					uniqueStudents[i].overallRank = currentOverallRank;
				}
				
				// Filter branch students and assign branch ranks
				const branchStudents = uniqueStudents.filter(s => s.branch === branch);
				let currentBranchRank = 0;
				let branchRankableCount = 0;
				let previousBranchCgpa = null;
				for (let i = 0; i < branchStudents.length; i++) {
					branchRankableCount++;
					if (previousBranchCgpa === null || Math.abs(branchStudents[i].cgpa - previousBranchCgpa) > 1e-9) {
						currentBranchRank = branchRankableCount;
						previousBranchCgpa = branchStudents[i].cgpa;
					}
					branchStudents[i].branchRank = currentBranchRank;
				}
				
				const userStudent = uniqueStudents.find(s => s.reg.replace(/\D/g, "") === numericReg);
				if (!userStudent) {
					errorMsg = "No result data is available for this registration number yet.";
				} else {
					studentData = userStudent;
					overallRank = userStudent.overallRank;
					totalStudents = uniqueStudents.length;
					branchRank = userStudent.branchRank;
					totalBranchStudents = branchStudents.length;
					
					// Map branch code to result-table format
					if (branch === "105") cseCode = "cse";
					else if (branch === "104") cseCode = "ece";
					else if (branch === "103") cseCode = "ee";
					else if (branch === "102") cseCode = "mech";
					else if (branch === "101") cseCode = "civil";
					else if (branch === "110" || branch === "161") cseCode = "eee";
					else cseCode = "cse"; // fallback
				}
			}
		}
	} else {
		errorMsg = "Enter a valid BEU registration number.";
	}
}
---

<Layout
	title="BEU rank"
	description="Find a Bihar Engineering University student's rank within their branch and across the whole university."
>
	<header class="page-head">
		<div>
			<h1>Rank</h1>
			<p class="meta">Based on stored result data</p>
		</div>
	</header>

	{
		!studentData && (
			<div class="rank-form">
				<form method="GET" action="">
					<label class="field-label" for="reg">Registration number</label>
					<div class="rank-input">
						<input
							type="text"
							id="reg"
							name="reg"
							inputmode="numeric"
							placeholder="23105157001"
							required
							value={regParam || ""}
						/>
						<button type="submit" class="btn-primary">Check rank</button>
					</div>
				</form>

				{errorMsg && <p class="form-status is-error" role="alert">{errorMsg}</p>}
			</div>
		)
	}

	{
		studentData && (
			<div class="rank-result">
				<div class="student">
					<h2>{studentData.name}</h2>
					<p class="mono">{studentData.reg}</p>
					<p>{studentData.collegeCode} — {studentData.collegeName}</p>
				</div>

				<dl class="rank-stats">
					<div>
						<dt>University rank</dt>
						<dd class="num">#{overallRank}</dd>
						<dd class="sub num">of {totalStudents}</dd>
					</div>
					<div>
						<dt>Branch rank</dt>
						<dd class="num">#{branchRank}</dd>
						<dd class="sub num">of {totalBranchStudents}</dd>
					</div>
					<div>
						<dt>CGPA</dt>
						<dd class="num">{studentData.cgpa.toFixed(2)}</dd>
					</div>
					<div>
						<dt>Sem {targetSem} SGPA</dt>
						<dd class="num">{studentData.sgpa.toFixed(2)}</dd>
					</div>
				</dl>

				<div class="rank-actions">
					<a
						href={`${import.meta.env.BASE_URL}result-table?session=${batch}&branch=${cseCode}&semester=${targetSem}&college=${studentData.collegeCode}`}
						class="btn btn-ghost"
					>
						Result table
					</a>
					<a
						href={`${import.meta.env.BASE_URL}result?reg=${studentData.reg}&sem=${targetSem}`}
						class="btn btn-primary"
					>
						Full result
					</a>
				</div>
			</div>
		)
	}
</Layout>

<style>
	.rank-form {
		max-width: 30rem;
		padding: var(--s5);
		border: 1px solid var(--line);
		border-radius: var(--r-lg);
		background: var(--surface);
	}

	.rank-form form {
		display: grid;
		gap: 0.35rem;
		margin: 0;
	}

	.rank-input {
		display: flex;
		gap: var(--s2);
	}

	.rank-input input {
		flex: 1;
		min-width: 0;
		font-variant-numeric: tabular-nums;
	}

	.rank-input button {
		flex: 0 0 auto;
	}

	.rank-result {
		display: grid;
		gap: var(--s5);
		max-width: 44rem;
	}

	.student h2 {
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 400;
	}

	.student p {
		margin: 0.15rem 0 0;
		font-size: 0.85rem;
	}

	.rank-stats {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0;
		margin: 0;
		border-top: 1px solid var(--line-strong);
	}

	.rank-stats div {
		padding: var(--s4) 0;
		border-bottom: 1px solid var(--line);
	}

	.rank-stats dt {
		color: var(--faint);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.rank-stats dd {
		margin: 0.15rem 0 0;
		color: var(--paper);
		font-family: var(--font-display);
		font-size: 2rem;
		line-height: 1;
	}

	.rank-stats dd.sub {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		color: var(--faint);
	}

	.rank-actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--s2);
	}

	@media (max-width: 560px) {
		.rank-stats {
			grid-template-columns: 1fr;
		}

		.rank-input {
			flex-direction: column;
		}
	}
</style>

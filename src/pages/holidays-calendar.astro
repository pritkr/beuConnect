---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import 'vanilla-calendar-pro/styles/index.css';
---

<Layout title="Holidays 2026" description="Academic and festival holiday calendar for Bihar Engineering University, 2026.">

	<div class="calendar-shell">
		<header class="page-head">
			<div>
				<h1>Holidays 2026</h1>
				<p class="meta">Academic and festival calendar</p>
			</div>
		</header>

		<div class="year-progress">
			<p class="progress-label">
				<span>2026 elapsed</span>
				<span id="progressPercent" class="num">0%</span>
			</p>
			<div class="progress-bar" role="presentation">
				<div id="progressBarFill" class="progress-fill"></div>
			</div>
		</div>

		<div class="toolbar">
			<div class="field">
				<label class="field-label" for="searchInput">Search</label>
				<input id="searchInput" type="search" placeholder="Holi, Diwali…" />
			</div>
			<label class="check">
				<input type="checkbox" id="teacherOnlyToggle" />
				<span>Teachers only</span>
			</label>
		</div>

		<ul class="legend" aria-label="Holiday categories">
			<li><span class="dot festival"></span>Festival</li>
			<li><span class="dot national"></span>National</li>
			<li><span class="dot vacation"></span>Vacation</li>
			<li><span class="dot academic"></span>Academic</li>
			<li><span class="dot sunday"></span>Sunday</li>
		</ul>

		<div class="calendar-wrapper">
			<div id="calendar"></div>
		</div>

		<section id="selectedCard" class="selected" aria-labelledby="selected-heading">
			<h2 id="selected-heading">Selected day</h2>
			<div id="selectedDayInfo">
				<p class="empty">Choose a marked day to see its details.</p>
			</div>
		</section>

		<section class="schedule" aria-labelledby="schedule-heading">
			<h2 id="schedule-heading">Full schedule</h2>
			<div id="holidayListAll" class="holiday-list"></div>
		</section>

		<section class="notes" aria-labelledby="notes-heading">
			<h2 id="notes-heading">2026 summary</h2>
			<ul>
				<li><strong class="num">59</strong> academic holidays, including Sundays</li>
				<li><strong class="num">52</strong> working holidays, excluding Sundays</li>
				<li>Summer vacation <strong>23 May – 21 June 2026</strong>, teachers only</li>
				<li>Dates marked <code>*</code> depend on lunar sightings</li>
			</ul>
		</section>
	</div>

	<script>
		import { Calendar } from 'vanilla-calendar-pro';

		type HolidayCategory = "festival" | "national" | "vacation" | "academic";
		type HolidayEntry = {
			id: number;
			name: string;
			start: string;
			end?: string;
			category: HolidayCategory;
			moonBased?: boolean;
			teacherOnly?: boolean;
		};

		const holidays2026: HolidayEntry[] = [
			{ id: 1, name: "नव वर्ष", start: "2026-01-01", category: "festival" },
			{ id: 2, name: "मकर संक्रांति", start: "2026-01-14", category: "festival" },
			{ id: 3, name: "बसंत पंचमी", start: "2026-01-23", category: "festival" },
			{ id: 4, name: "कर्पूरी ठाकुर जयंती", start: "2026-01-24", category: "national" },
			{ id: 5, name: "गणतंत्र दिवस", start: "2026-01-26", category: "national" },
			{ id: 6, name: "संत रविदास जयन्ती", start: "2026-02-01", category: "festival" },
			{ id: 7, name: "शब-ए-बरात", start: "2026-02-04", category: "festival", moonBased: true },
			{ id: 8, name: "महाशिवरात्रि", start: "2026-02-15", category: "festival" },
			{ id: 9, name: "होलिकादहन / होली", start: "2026-03-02", end: "2026-03-04", category: "festival" },
			{ id: 10, name: "ईद-उल-फितर (ईद)", start: "2026-03-21", category: "festival", moonBased: true },
			{ id: 11, name: "बिहार दिवस", start: "2026-03-22", category: "national" },
			{ id: 12, name: "सम्राट अशोक जयन्ती (अष्टमी)", start: "2026-03-26", category: "festival" },
			{ id: 13, name: "राम नवमी", start: "2026-03-27", category: "festival" },
			{ id: 14, name: "महावीर जयन्ती", start: "2026-03-31", category: "festival" },
			{ id: 15, name: "गुड फ्राईडे", start: "2026-04-03", category: "festival" },
			{ id: 16, name: "भीमराव अम्बेडकर जयन्ती", start: "2026-04-14", category: "national" },
			{ id: 17, name: "वीर कुंवर सिंह जयन्ती", start: "2026-04-23", category: "national" },
			{ id: 18, name: "जानकी नवमी", start: "2026-04-25", category: "festival" },
			{ id: 19, name: "मई दिवस (श्रम दिवस) / बुद्ध पूर्णिमा", start: "2026-05-01", category: "national" },
			{ id: 20, name: "ईद-उल-जोहा (बकरीद)", start: "2026-05-28", end: "2026-05-29", category: "festival", moonBased: true },
			{ id: 21, name: "मुहर्रम", start: "2026-06-26", end: "2026-06-27", category: "festival", moonBased: true },
			{ id: 22, name: "कबीर जयन्ती", start: "2026-06-29", category: "festival" },
			{ id: 23, name: "चेहल्लुम", start: "2026-08-04", category: "festival" },
			{ id: 24, name: "स्वतंत्रता दिवस", start: "2026-08-15", category: "national" },
			{ id: 25, name: "अंतिम श्रावणी सोमवार", start: "2026-08-24", category: "festival" },
			{ id: 26, name: "हज़रत मोहम्मद साहब का जन्म दिवस", start: "2026-08-26", category: "festival" },
			{ id: 27, name: "रक्षाबंधन", start: "2026-08-28", category: "festival" },
			{ id: 28, name: "श्री कृष्ण जन्माष्टमी", start: "2026-09-04", category: "festival" },
			{ id: 29, name: "विश्वकर्मा पूजा", start: "2026-09-17", category: "festival" },
			{ id: 30, name: "अनन्त चतुर्दशी", start: "2026-09-25", category: "festival" },
			{ id: 31, name: "महात्मा गाँधी जयन्ती", start: "2026-10-02", category: "national" },
			{ id: 32, name: "दुर्गा पूजा (कलश स्थापन) / जय प्रकाश नारायण जयन्ती", start: "2026-10-11", category: "festival" },
			{ id: 33, name: "दुर्गा पूजा / श्रीकृष्ण सिंह जयन्ती", start: "2026-10-17", end: "2026-10-21", category: "vacation" },
			{ id: 34, name: "दीपावली / चित्रगुप्त पूजा / भाई दूज / छठ पूजा", start: "2026-11-08", end: "2026-11-16", category: "vacation" },
			{ id: 35, name: "गुरू नानक जयन्ती / कार्तिक पूर्णिमा", start: "2026-11-24", category: "festival" },
			{ id: 36, name: "डॉ. राजेन्द्र प्रसाद जयन्ती", start: "2026-12-03", category: "national" },
			{ id: 37, name: "क्रिसमस दिवस", start: "2026-12-25", category: "festival" },
			{ id: 38, name: "शीतकालीन अवकाश", start: "2026-12-26", end: "2026-12-31", category: "vacation" },
			{
				id: 39,
				name: "ग्रीष्मावकाश (केवल शिक्षकों के लिए)",
				start: "2026-05-23",
				end: "2026-06-21",
				category: "vacation",
				teacherOnly: true,
			},
		];

		const holidayListAll = document.getElementById("holidayListAll") as HTMLDivElement;
		const selectedDayInfo = document.getElementById("selectedDayInfo") as HTMLDivElement;
		const searchInput = document.getElementById("searchInput") as HTMLInputElement;
		const teacherOnlyToggle = document.getElementById("teacherOnlyToggle") as HTMLInputElement;

		function formatDate(iso: string): string {
			const [y, m, d] = iso.split("-").map(Number);
			return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-IN", {
				timeZone: "UTC",
				day: "2-digit",
				month: "short",
				year: "numeric",
			});
		}

		function categoryLabel(category: HolidayCategory): string {
			if (category === "national") return "National";
			if (category === "festival") return "Festival";
			if (category === "vacation") return "Vacation";
			return "Academic";
		}

		function renderHolidayList(entries: HolidayEntry[]) {
			const sorted = [...entries].sort((a, b) => a.start.localeCompare(b.start));
			if (!sorted.length) {
				holidayListAll.innerHTML = '<p class="empty">No holidays match this search.</p>';
				return;
			}

			holidayListAll.innerHTML = sorted
				.map((entry) => {
					const rangeText = entry.end ? `${formatDate(entry.start)} – ${formatDate(entry.end)}` : formatDate(entry.start);
					return `<article class="holiday-row ${entry.category}">
						<span class="range num">${rangeText}</span>
						<span class="name">${entry.name}${entry.moonBased ? " *" : ""}</span>
						<span class="tags">
							<span>${categoryLabel(entry.category)}</span>
							${entry.teacherOnly ? "<span>Teachers only</span>" : ""}
						</span>
					</article>`;
				})
				.join("");
		}

		function updateYearProgress() {
			const start = new Date("2026-01-01").getTime();
			const end = new Date("2026-12-31").getTime();
			const now = Date.now();
			const year2026Start = new Date("2026-01-01").getTime();
			const year2026End = new Date("2026-12-31").getTime();

			// If it's 2026, show actual progress. Otherwise show 0 or 100
			let progress = 0;
			const currentYear = new Date().getFullYear();
			if (currentYear < 2026) progress = 0;
			else if (currentYear > 2026) progress = 100;
			else {
				progress = Math.max(0, Math.min(100, ((now - year2026Start) / (year2026End - year2026Start)) * 100));
			}

			const barFill = document.getElementById("progressBarFill");
			const percentText = document.getElementById("progressPercent");
			if (barFill) barFill.style.width = `${progress}%`;
			if (percentText) percentText.innerText = `${Math.round(progress)}%`;
		}

		function updateSelectedInfo(date: string) {
			const visible = holidays2026.filter(h => {
				const start = h.start;
				const end = h.end || h.start;
				return date >= start && date <= end;
			});

			if (!visible.length) {
				selectedDayInfo.innerHTML = `<p class="empty">No holiday on ${formatDate(date)}.</p>`;
				return;
			}

			selectedDayInfo.innerHTML = visible
				.map((entry) => {
					const rangeText = entry.end ? `${formatDate(entry.start)} – ${formatDate(entry.end)}` : formatDate(entry.start);
					return `<article class="picked-row">
						<span class="name">${entry.name}${entry.moonBased ? " *" : ""}</span>
						<span class="range num">${rangeText}</span>
						<span class="tags">
							<span>${categoryLabel(entry.category)}</span>
							${entry.teacherOnly ? "<span>Teachers only</span>" : ""}
						</span>
					</article>`;
				})
				.join("");
		}

		let calendar: Calendar | null = null;
		const initCalendar = () => {
			updateYearProgress();
			const calendarEl = document.querySelector('#calendar');
			if (!calendarEl) return;

			const query = searchInput.value.trim().toLowerCase();
			const showTeacherOnly = teacherOnlyToggle.checked;

			const popups: Record<string, any> = {};

			holidays2026.forEach((h) => {
				if (h.teacherOnly && !showTeacherOnly) return;
				if (query && !h.name.toLowerCase().includes(query)) return;

				const start = h.start;
				const end = h.end || h.start;

				const startDate = new Date(start);
				const endDate = new Date(end);
				for (
					let d = new Date(startDate);
					d <= endDate;
					d.setDate(d.getDate() + 1)
				) {
					const iso = d.toISOString().split("T")[0];
					if (!popups[iso]) {
						popups[iso] = {
							modifier: `holiday-mark ${h.category}`,
							html: "",
						};
					} else if (!popups[iso].modifier.includes(h.category)) {
						popups[iso].modifier += ` ${h.category}`;
					}
					popups[iso].html += `<div class="popup-item">${h.name}</div>`;
				}
			});

			if (calendar) {
				try {
					calendar.destroy();
				} catch (e) {
					console.error("Error destroying calendar:", e);
				}
			}

			try {
				calendar = new Calendar(calendarEl as HTMLElement, {
					type: "multiple",
					displayMonthsCount: 12,
					selectedYear: 2026,
					selectedMonth: 0,
					locale: "en",
					selectionDatesMode: "single",
					selectionMonthsMode: false,
					selectionYearsMode: false,
					selectedTheme: "dark",
					selectedWeekends: [0], // Only Sundays
					popups: popups,
					onClickDate(self) {
						if (self.selectedDates && self.selectedDates[0]) {
							updateSelectedInfo(self.selectedDates[0]);
						}
					},
				});
				calendar.init();
			} catch (e: any) {
				console.error("Error initializing calendar:", e);
			}

			renderHolidayList(
				holidays2026.filter((h) => {
					if (h.teacherOnly && !showTeacherOnly) return false;
					if (query && !h.name.toLowerCase().includes(query))
						return false;
					return true;
				}),
			);
		};

		searchInput.addEventListener("input", initCalendar);
		teacherOnlyToggle.addEventListener("change", initCalendar);

		// For Astro view transitions and initial load
		document.addEventListener("astro:page-load", initCalendar);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initCalendar);
		} else {
			initCalendar();
		}
	</script>

	<style is:global>
		.calendar-shell {
			display: grid;
			gap: var(--s4);
		}

		.year-progress {
			display: grid;
			gap: var(--s2);
			max-width: 24rem;
		}

		.progress-label {
			display: flex;
			justify-content: space-between;
			gap: var(--s4);
			margin: 0;
			color: var(--faint);
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		.progress-bar {
			height: 3px;
			background: var(--line);
		}

		.progress-fill {
			width: 0;
			height: 100%;
			background: var(--accent);
			transition: width 600ms ease;
		}

		.toolbar {
			display: flex;
			flex-wrap: wrap;
			align-items: end;
			gap: var(--s4);
			padding-bottom: var(--s3);
			border-bottom: 1px solid var(--line);
		}

		.toolbar .field {
			flex: 1 1 15rem;
			max-width: 22rem;
		}

		.toolbar input[type="search"] {
			margin: 0;
		}

		.check {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			margin: 0 0 0.35rem;
			color: var(--muted);
			font-size: 0.85rem;
			cursor: pointer;
		}

		.check input {
			width: 1rem;
			height: 1rem;
			margin: 0;
		}

		.legend {
			display: flex;
			flex-wrap: wrap;
			gap: var(--s4);
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.legend li {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			color: var(--faint);
			font-size: 0.75rem;
		}

		.dot {
			width: 0.6rem;
			height: 0.6rem;
			border-radius: 1px;
		}

		.dot.festival {
			background: var(--accent);
		}
		.dot.national {
			background: var(--brand);
		}
		.dot.vacation {
			background: var(--ok);
		}
		.dot.academic {
			background: var(--muted);
		}
		.dot.sunday {
			border: 1px solid var(--bad);
		}

		.calendar-wrapper {
			overflow-x: auto;
			padding-bottom: var(--s3);
			scrollbar-width: thin;
		}

		/* vanilla-calendar-pro overrides */
		#calendar {
			width: 100%;
			background: transparent;
		}

		.vc-controls {
			display: none !important;
		}

		.vc-container {
			width: 100% !important;
			background: transparent !important;
			border: none !important;
		}

		.vc-months {
			display: grid !important;
			grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
			gap: var(--s3) !important;
			width: 100% !important;
			min-width: 760px;
		}

		.vc-month {
			padding: var(--s3) !important;
			background: var(--surface) !important;
			border: 1px solid var(--line) !important;
			border-radius: var(--r) !important;
		}

		.vc-header {
			margin-bottom: var(--s2) !important;
			padding: 0 !important;
		}

		.vc-header__content {
			color: var(--paper) !important;
			font-family: var(--font-display) !important;
			font-size: 1rem !important;
			font-weight: 400 !important;
			text-transform: none !important;
			letter-spacing: 0 !important;
		}

		.vc-week__day,
		.vc-week__day-content {
			color: var(--faint) !important;
			font-size: 0.62rem !important;
			font-weight: 500 !important;
			text-transform: uppercase !important;
		}

		.vc-day {
			min-height: 26px !important;
			border-radius: 2px !important;
			color: var(--muted) !important;
			font-size: 0.7rem !important;
			font-variant-numeric: tabular-nums !important;
			transition: background-color 120ms ease !important;
		}

		.vc-day[data-vc-date-weekend] {
			color: var(--bad) !important;
		}

		.vc-date__btn {
			border-radius: 2px !important;
		}

		.vc-date__btn.holiday-mark {
			width: 100% !important;
			height: 100% !important;
			border: 1px solid transparent !important;
			border-radius: 2px !important;
			color: var(--paper) !important;
		}

		.vc-date__btn.festival {
			background: color-mix(in srgb, var(--accent) 18%, transparent) !important;
			border-color: color-mix(in srgb, var(--accent) 45%, transparent) !important;
		}
		.vc-date__btn.national {
			background: color-mix(in srgb, var(--brand) 18%, transparent) !important;
			border-color: color-mix(in srgb, var(--brand) 45%, transparent) !important;
		}
		.vc-date__btn.vacation {
			background: color-mix(in srgb, var(--ok) 18%, transparent) !important;
			border-color: color-mix(in srgb, var(--ok) 45%, transparent) !important;
		}
		.vc-date__btn.academic {
			background: color-mix(in srgb, var(--muted) 14%, transparent) !important;
			border-color: color-mix(in srgb, var(--muted) 35%, transparent) !important;
		}

		.vc-day:hover .vc-date__btn.holiday-mark {
			filter: brightness(1.25);
		}

		.vc-day_selected .vc-date__btn {
			background: var(--accent) !important;
			border-color: var(--accent) !important;
			color: var(--accent-ink) !important;
			font-weight: 700 !important;
		}

		.vc-day_today .vc-date__btn {
			outline: 1px solid var(--accent) !important;
			outline-offset: 1px;
		}

		@media (max-width: 1100px) {
			.vc-months {
				grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
				min-width: 660px;
			}
		}

		@media (max-width: 760px) {
			.vc-months {
				grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
				min-width: 460px;
			}
		}

		@media (max-width: 480px) {
			.vc-months {
				grid-template-columns: minmax(0, 1fr) !important;
				min-width: 260px;
			}
		}

		.selected,
		.schedule,
		.notes {
			display: grid;
			gap: var(--s3);
			padding-top: var(--s4);
			border-top: 1px solid var(--line-strong);
		}

		.selected h2,
		.schedule h2,
		.notes h2 {
			margin: 0;
			color: var(--faint);
			font-family: var(--font-sans);
			font-size: 0.72rem;
			font-weight: 650;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.holiday-list {
			display: grid;
		}

		.holiday-row,
		.picked-row {
			display: grid;
			grid-template-columns: 13rem minmax(0, 1fr) auto;
			align-items: baseline;
			gap: var(--s3);
			padding: var(--s3) 0 var(--s3) var(--s3);
			border-bottom: 1px solid var(--line);
			border-left: 2px solid var(--line);
		}

		.holiday-row.festival,
		.picked-row.festival {
			border-left-color: var(--accent);
		}
		.holiday-row.national,
		.picked-row.national {
			border-left-color: var(--brand);
		}
		.holiday-row.vacation,
		.picked-row.vacation {
			border-left-color: var(--ok);
		}
		.holiday-row.academic,
		.picked-row.academic {
			border-left-color: var(--muted);
		}

		.holiday-row .range,
		.picked-row .range {
			color: var(--faint);
			font-size: 0.75rem;

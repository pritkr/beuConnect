---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import 'vanilla-calendar-pro/styles/index.css';
import { filterHolidays, holidayRowHTML, HOLIDAYS_2026 } from "../lib/holidays/data";

// The schedule is part of the page, not something the browser builds after
// load: 38 rows appearing late pushed the rest of the page down by thousands of
// pixels, which is the largest layout shift on the site.
const scheduleRows = filterHolidays(HOLIDAYS_2026).map(holidayRowHTML);
---

<Layout title="Holidays 2026" description="Academic and festival holiday calendar for Bihar Engineering University, 2026.">

	<div class="calendar-shell">
		<header class="page-head">
			<div>
				<h1>Holidays 2026</h1>
				<p class="meta">Academic and festival calendar</p>
			</div>
		</header>

		<div class="year-progress">
			<p class="progress-label">
				<span>2026 elapsed</span>
				<span id="progressPercent" class="num">0%</span>
			</p>
			<div class="progress-bar" role="presentation">
				<div id="progressBarFill" class="progress-fill"></div>
			</div>
		</div>

		<div class="toolbar">
			<div class="field">
				<label class="field-label" for="searchInput">Search</label>
				<input id="searchInput" type="search" placeholder="Holi, Diwali…" />
			</div>
			<label class="check">
				<input type="checkbox" id="teacherOnlyToggle" />
				<span>Teachers only</span>
			</label>
		</div>

		<ul class="legend" aria-label="Holiday categories">
			<li><span class="dot festival"></span>Festival</li>
			<li><span class="dot national"></span>National</li>
			<li><span class="dot vacation"></span>Vacation</li>
			<li><span class="dot academic"></span>Academic</li>
			<li><span class="dot sunday"></span>Sunday</li>
		</ul>

		<div class="calendar-wrapper">
			<div id="calendar"></div>
		</div>

		<section id="selectedCard" class="selected" aria-labelledby="selected-heading">
			<h2 id="selected-heading">Selected day</h2>
			<div id="selectedDayInfo">
				<p class="empty">Choose a marked day to see its details.</p>
			</div>
		</section>

		<section class="schedule" aria-labelledby="schedule-heading">
			<h2 id="schedule-heading">Full schedule</h2>
			<div id="holidayListAll" class="holiday-list">
				{scheduleRows.map((row) => <Fragment set:html={row} />)}
			</div>
		</section>

		<section class="notes" aria-labelledby="notes-heading">
			<h2 id="notes-heading">2026 summary</h2>
			<ul>
				<li><strong class="num">59</strong> academic holidays, including Sundays</li>
				<li><strong class="num">52</strong> working holidays, excluding Sundays</li>
				<li>Summer vacation <strong>23 May – 21 June 2026</strong>, teachers only</li>
				<li>Dates marked <code>*</code> depend on lunar sightings</li>
			</ul>
		</section>
	</div>

	<script>
		import { Calendar, annotations, months } from 'vanilla-calendar-pro';
		import {
			filterHolidays,
			formatHolidayDate,
			holidayCategoryLabel,
			holidayRangeText,
			holidayRowHTML,
			HOLIDAYS_2026,
			type HolidayEntry,
		} from '../lib/holidays/data';

		const holidayListAll = document.getElementById("holidayListAll") as HTMLDivElement;
		const selectedDayInfo = document.getElementById("selectedDayInfo") as HTMLDivElement;
		const searchInput = document.getElementById("searchInput") as HTMLInputElement;
		const teacherOnlyToggle = document.getElementById("teacherOnlyToggle") as HTMLInputElement;

		function renderHolidayList(entries: HolidayEntry[]) {
			if (!entries.length) {
				holidayListAll.replaceChildren(
					Object.assign(document.createElement("p"), {
						className: "empty",
						textContent: "No holidays match this search.",
					}),
				);
				return;
			}

			// The same markup the page shipped with, so filtering re-uses the
			// rows' boxes instead of replacing the list with a different shape.
			holidayListAll.innerHTML = entries.map(holidayRowHTML).join("");
		}

		function updateYearProgress() {
			const start = new Date("2026-01-01").getTime();
			const end = new Date("2026-12-31").getTime();
			const now = Date.now();
			const year2026Start = new Date("2026-01-01").getTime();
			const year2026End = new Date("2026-12-31").getTime();

			// If it's 2026, show actual progress. Otherwise show 0 or 100
			let progress = 0;
			const currentYear = new Date().getFullYear();
			if (currentYear < 2026) progress = 0;
			else if (currentYear > 2026) progress = 100;
			else {
				progress = Math.max(0, Math.min(100, ((now - year2026Start) / (year2026End - year2026Start)) * 100));
			}

			const barFill = document.getElementById("progressBarFill");
			const percentText = document.getElementById("progressPercent");
			if (barFill) barFill.style.transform = `scaleX(${progress / 100})`;
			if (percentText) percentText.innerText = `${Math.round(progress)}%`;
		}

		function updateSelectedInfo(date: string) {
			const visible = HOLIDAYS_2026.filter(h => {
				const start = h.start;
				const end = h.end || h.start;
				return date >= start && date <= end;
			});

			if (!visible.length) {
				selectedDayInfo.innerHTML = `<p class="empty">No holiday on ${formatHolidayDate(date)}.</p>`;
				return;
			}

			selectedDayInfo.innerHTML = visible
				.map((entry) => {
					const rangeText = holidayRangeText(entry);
					return `<article class="picked-row">
						<span class="name">${entry.name}${entry.moonBased ? " *" : ""}</span>
						<span class="range num">${rangeText}</span>
						<span class="tags">
							<span>${holidayCategoryLabel(entry.category)}</span>
							${entry.teacherOnly ? "<span>Teachers only</span>" : ""}
						</span>
					</article>`;
				})
				.join("");
		}

		let calendar: Calendar | null = null;
		const initCalendar = () => {
			updateYearProgress();
			const calendarEl = document.querySelector('#calendar');
			if (!calendarEl) return;

			const query = searchInput.value.trim().toLowerCase();
			const showTeacherOnly = teacherOnlyToggle.checked;

			const popups: Record<string, any> = {};

			HOLIDAYS_2026.forEach((h) => {
				if (h.teacherOnly && !showTeacherOnly) return;
				if (query && !h.name.toLowerCase().includes(query)) return;

				const start = h.start;
				const end = h.end || h.start;

				const startDate = new Date(start);
				const endDate = new Date(end);
				for (
					let d = new Date(startDate);
					d <= endDate;
					d.setDate(d.getDate() + 1)
				) {
					const iso = d.toISOString().split("T")[0];
					if (!popups[iso]) {
						popups[iso] = {
							modifier: `holiday-mark ${h.category}`,
							html: "",
						};
					} else if (!popups[iso].modifier.includes(h.category)) {
						popups[iso].modifier += ` ${h.category}`;
					}
					popups[iso].html += `<div class="popup-item">${h.name}</div>`;
				}
			});

			// `popups` and `displayMonthsCount` moved into extensions in
			// vanilla-calendar-pro 3; without registering them the constructor
			// throws and the grid stays empty.
			const options = {
				extensions: [annotations, months],
				type: "multiple" as const,
				displayMonthsCount: 12 as const,
				selectedYear: 2026,
				selectedMonth: 0,
				locale: "en",
				selectionDatesMode: "single" as const,
				selectionMonthsMode: false,
				selectionYearsMode: false,
				selectedTheme: "dark" as const,
				selectedWeekends: [0], // Only Sundays
				popups: popups,
				onClickDate(self: any) {
					// The selection lives on the instance context in v3, not on
					// the instance itself.
					const picked = self.context?.selectedDates?.[0];
					if (picked) updateSelectedInfo(picked);
				},
			};

			try {
				if (calendar) {
					// `destroy()` empties the container for good, and the library
					// memoizes the element it was handed, so the next instance
					// needs a clean node addressed by selector instead.
					calendar.destroy();
					const fresh = document.createElement("div");
					fresh.id = "calendar";
					(calendarEl as HTMLElement).replaceWith(fresh);
				}
				calendar = new Calendar("#calendar", options);
				calendar.init();
			} catch (e: any) {
				console.error("Error rendering calendar:", e);
			}

			renderHolidayList(
				filterHolidays(HOLIDAYS_2026, { query, includeTeacherOnly: showTeacherOnly }),
			);
		};

		// Each rebuild lays out twelve month grids (441 day cells), so typing
		// waits for a pause instead of rebuilding on every keystroke.
		let searchTimer = 0;
		searchInput.addEventListener("input", () => {
			clearTimeout(searchTimer);
			searchTimer = window.setTimeout(initCalendar, 150);
		});
		teacherOnlyToggle.addEventListener("change", () => {
			clearTimeout(searchTimer);
			initCalendar();
		});

		// For Astro view transitions and initial load
		document.addEventListener("astro:page-load", initCalendar);
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", initCalendar);
		} else {
			initCalendar();
		}
	</script>

	<style is:global>
		.calendar-shell {
			display: grid;
			gap: var(--s4);
		}

		/* The grid's gap is the space under the header. */
		.calendar-shell > .page-head { margin-bottom: 0; }

		.year-progress {
			display: grid;
			gap: var(--s2);
			max-width: 24rem;
		}

		.progress-label {
			display: flex;
			justify-content: space-between;
			gap: var(--s4);
			margin: 0;
			color: var(--faint);
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		/* "0%" and "88%" are different widths, and the number replaced the
		   placeholder after load. The box holds the widest value ("100%") from
		   the first frame, so writing the real percentage moves nothing. */
		#progressPercent {
			min-inline-size: 4ch;
			text-align: end;
		}

		.progress-bar {
			height: 3px;
			background: var(--line);
		}

		.progress-fill {
			width: 100%;
			height: 100%;
			background: var(--accent);
			transform: scaleX(0);
			transform-origin: left;
			transition: transform 600ms linear;
		}

		.toolbar {
			display: flex;
			flex-wrap: wrap;
			align-items: end;
			gap: var(--s4);
			padding-bottom: var(--s3);
			border-bottom: 1px solid var(--line);
		}

		.toolbar .field {
			flex: 1 1 15rem;
			max-width: 22rem;
		}

		.toolbar input[type="search"] {
			margin: 0;
		}

		.check {
			display: flex;
			align-items: center;
			gap: 0.45rem;
			margin: 0 0 0.35rem;
			color: var(--muted);
			font-size: 0.85rem;
			cursor: pointer;
		}

		.check input {
			width: 1rem;
			height: 1rem;
			margin: 0;
		}

		.legend {
			display: flex;
			flex-wrap: wrap;
			gap: var(--s4);
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.legend li {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			color: var(--faint);
			font-size: 0.75rem;
		}

		.dot {
			width: 0.6rem;
			height: 0.6rem;
			border-radius: 1px;
		}

		.dot.festival {
			background: var(--accent);
		}
		.dot.national {
			background: var(--brand);
		}
		.dot.vacation {
			background: var(--ok);
		}
		.dot.academic {
			background: var(--muted);
		}
		.dot.sunday {
			border: 1px solid var(--bad);
		}

		.calendar-wrapper {
			overflow-x: auto;
			overscroll-behavior-x: contain;
			padding-bottom: var(--s3);
			scrollbar-width: thin;
			/* The library builds the month grid after load. Reserving the first
			   screen here keeps the schedule and the summary underneath out of
			   the first layout, so filling in the months cannot shove them
			   down — and a screen is a floor, not a guess: the grid is far
			   taller than this. */
			min-height: calc(100dvh - var(--header-h));
		}

		/* vanilla-calendar-pro overrides */
		#calendar {
			width: 100%;
			background: transparent;
		}

		.vc-controls {
			display: none !important;
		}

		.vc-container {
			width: 100% !important;
			background: transparent !important;
			border: none !important;
		}

		.vc-months {
			display: grid !important;
			grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
			gap: var(--s3) !important;
			width: 100% !important;
			min-width: 760px;
		}

		.vc-month {
			padding: var(--s3) !important;
			background: var(--surface) !important;
			border: 1px solid var(--line) !important;
			border-radius: var(--r) !important;
		}

		.vc-header {
			margin-bottom: var(--s2) !important;
			padding: 0 !important;
		}

		.vc-header__content {
			color: var(--paper) !important;
			font-family: var(--font-display) !important;
			font-size: 1rem !important;
			font-weight: 400 !important;
			text-transform: none !important;
			letter-spacing: 0 !important;
		}

		.vc-week__day,
		.vc-week__day-content {
			color: var(--faint) !important;
			font-size: 0.62rem !important;
			font-weight: 500 !important;
			text-transform: uppercase !important;
		}

		.vc-day {
			min-height: 26px !important;
			border-radius: 2px !important;
			color: var(--muted) !important;
			font-size: 0.7rem !important;
			font-variant-numeric: tabular-nums !important;
			transition: background-color 120ms ease !important;
		}

		.vc-day[data-vc-date-weekend] {
			color: var(--bad) !important;
		}

		.vc-date__btn {
			border-radius: 2px !important;
		}

		.vc-date__btn.holiday-mark {
			width: 100% !important;
			height: 100% !important;
			border: 1px solid transparent !important;
			border-radius: 2px !important;
			color: var(--paper) !important;
		}

		.vc-date__btn.festival {
			background: color-mix(in srgb, var(--accent) 18%, transparent) !important;
			border-color: color-mix(in srgb, var(--accent) 45%, transparent) !important;
		}
		.vc-date__btn.national {
			background: color-mix(in srgb, var(--brand) 18%, transparent) !important;
			border-color: color-mix(in srgb, var(--brand) 45%, transparent) !important;
		}
		.vc-date__btn.vacation {
			background: color-mix(in srgb, var(--ok) 18%, transparent) !important;
			border-color: color-mix(in srgb, var(--ok) 45%, transparent) !important;
		}
		.vc-date__btn.academic {
			background: color-mix(in srgb, var(--muted) 14%, transparent) !important;
			border-color: color-mix(in srgb, var(--muted) 35%, transparent) !important;
		}

		@media (hover: hover) and (pointer: fine) {
			.vc-day:hover .vc-date__btn.holiday-mark {
				filter: brightness(1.25);
			}
		}

		.vc-day_selected .vc-date__btn {
			background: var(--accent) !important;
			border-color: var(--accent) !important;
			color: var(--accent-ink) !important;
			font-weight: 700 !important;
		}

		.vc-day_today .vc-date__btn {
			outline: 1px solid var(--accent) !important;
			outline-offset: 1px;
		}

		@media (max-width: 1100px) {
			.vc-months {
				grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
				min-width: 660px;
			}
		}

		@media (max-width: 760px) {
			.vc-months {
				grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
				min-width: 460px;
			}
		}

		@media (max-width: 480px) {
			.vc-months {
				grid-template-columns: minmax(0, 1fr) !important;
				min-width: 260px;
			}
		}

		.selected,
		.schedule,
		.notes {
			display: grid;
			gap: var(--s3);
			padding-top: var(--s4);
			border-top: 1px solid var(--line-strong);
		}

		.selected h2,
		.schedule h2,
		.notes h2 {
			margin: 0;
			color: var(--faint);
			font-family: var(--font-sans);
			font-size: 0.72rem;
			font-weight: 650;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.holiday-list {
			display: grid;
		}

		.holiday-row,
		.picked-row {
			display: grid;
			grid-template-columns: 13rem minmax(0, 1fr) auto;
			align-items: baseline;
			gap: var(--s3);
			padding: var(--s3) 0 var(--s3) var(--s3);
			border-bottom: 1px solid var(--line);
			border-left: 2px solid var(--line);
		}

		.holiday-row.festival,
		.picked-row.festival {
			border-left-color: var(--accent);
		}
		.holiday-row.national,
		.picked-row.national {
			border-left-color: var(--brand);
		}
		.holiday-row.vacation,
		.picked-row.vacation {
			border-left-color: var(--ok);
		}
		.holiday-row.academic,
		.picked-row.academic {
			border-left-color: var(--muted);
		}

		.holiday-row .range,
		.picked-row .range {
			color: var(--faint);
			font-size: 0.75rem;
		}

		.holiday-row .name,
		.picked-row .name {
			color: var(--paper);
			font-size: 0.9rem;
			line-height: 1.4;
		}

		.holiday-row .tags,
		.picked-row .tags {
			display: flex;
			flex-wrap: wrap;
			gap: var(--s3);
			color: var(--faint);
			font-size: 0.7rem;
			text-align: right;
		}

		.empty {
			margin: 0;
			padding: var(--s3) 0;
			border-bottom: 1px solid var(--line);
			color: var(--faint);
			font-size: 0.85rem;
		}

		.notes ul {
			display: grid;
			gap: var(--s2);
			margin: 0;
			padding: 0;
			list-style: none;
			color: var(--muted);
			font-size: 0.85rem;
		}

		.notes strong {
			color: var(--paper);
			font-weight: 600;
		}

		.notes code {
			color: var(--accent);
		}

		@media (max-width: 640px) {
			.holiday-row,
			.picked-row {
				grid-template-columns: minmax(0, 1fr);
				gap: 0.2rem;
			}

			.holiday-row .tags,
			.picked-row .tags {
				text-align: left;
			}
		}
	</style>


</Layout>

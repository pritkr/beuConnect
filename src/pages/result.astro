---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="BEU result"
	description="Check a Bihar Engineering University semester result by registration number, in the official layout or a readable one."
>
	<div class="result-shell">
		<header class="page-head">
			<div>
				<h1>Result</h1>
				<p class="meta">Bihar Engineering University · B.Tech</p>
				<p class="student-line" id="resultStudentName" hidden></p>
			</div>
			<div class="actions">
				<button id="printBtn" type="button" class="btn-sm" disabled>Print</button>
				<button id="saveBtn" type="button" class="btn-sm" disabled>Save HTML</button>
			</div>
		</header>

		<form class="controls" id="resultForm" onsubmit="return false">
			<div class="field reg-field">
				<label class="field-label" for="reg">Registration number</label>
				<div class="reg-row">
					<input
						id="reg"
						name="reg"
						inputmode="numeric"
						autocomplete="on"
						maxlength="11"
						placeholder="22105123019"
					/>
				</div>
			</div>

			<fieldset class="sem-field">
				<legend class="field-label">Semester</legend>
				<div class="sem-row" role="group" aria-label="Semester">
					{
						Array.from({ length: 8 }, (_, i) => (
							<button
								type="button"
								class="sem-btn"
								data-sem={String(i + 1)}
								aria-pressed="false"
							>
								{i + 1}
							</button>
						))
					}
				</div>
			</fieldset>

			<fieldset class="view-field">
				<legend class="field-label">View</legend>
				<div class="segmented" role="group" aria-label="Result view">
					<button type="button" class="view-btn active" data-view="official" aria-pressed="true">
						Official
					</button>
					<button type="button" class="view-btn" data-view="modern" aria-pressed="false">
						Readable
					</button>
				</div>
			</fieldset>
		</form>

		<p id="status" class="status" role="status" aria-live="polite">
			Enter a registration number to load a result.
		</p>

		<div id="savePrompt" class="save-prompt" style="display: none;">
			<h2>Save to this device?</h2>
			<button id="confirmSaveBtn" type="button" class="btn-sm btn-primary">Save</button>
		</div>

		<div class="frame-wrap">
			<iframe id="resultBox" title="BEU result output"></iframe>
		</div>
	</div>

	<script>
		import { inferCurrentSemester } from "../lib/beuReg";
		import { fetchStudent } from "../lib/students/client";
		import { parseRegNo, saveProfile, getProfile } from "../utils/profileManager";
		const baseUrl = import.meta.env.BASE_URL;
		const regInput = document.getElementById("reg") as HTMLInputElement;
		const printBtn = document.getElementById("printBtn") as HTMLButtonElement;
		const saveBtn = document.getElementById("saveBtn") as HTMLButtonElement;
		const savePrompt = document.getElementById("savePrompt") as HTMLDivElement;
		const confirmSaveBtn = document.getElementById("confirmSaveBtn") as HTMLButtonElement;
		const frame = document.getElementById("resultBox") as HTMLIFrameElement;
		const frameWrap = document.querySelector(".frame-wrap") as HTMLDivElement;
		const statusEl = document.getElementById("status") as HTMLParagraphElement;
		const studentNameEl = document.getElementById("resultStudentName") as HTMLParagraphElement | null;

		let selectedSem = 1;
		let timeoutTimer: ReturnType<typeof setTimeout> | null = null;
		let debounceTimer: ReturnType<typeof setTimeout> | null = null;
		let selectedView: "official" | "modern" = "official";

		// Identity resolved from the register, never guessed.
		let resolvedFor = "";
		let resolvedName = "";
		let resolvedBranch = "";

		const MIN_REG_LENGTH = 8;

		function renderStudentLine() {
			if (!studentNameEl) return;
			const reg = regInput.value.replace(/\D/g, "");
			if (!resolvedName || reg !== resolvedFor) {
				studentNameEl.hidden = true;
				studentNameEl.textContent = "";
				return;
			}
			const parts = [resolvedName];
			if (resolvedBranch) parts.push(resolvedBranch);
			parts.push(`Semester ${selectedSem}`);
			studentNameEl.textContent = parts.join(" · ");
			studentNameEl.hidden = false;
		}

		async function resolveStudent(reg: string) {
			const digits = reg.replace(/\D/g, "");

			if (digits.length < 11) {
				resolvedFor = "";
				resolvedName = "";
				resolvedBranch = "";
				renderStudentLine();
				return;
			}

			const student = await fetchStudent(digits);
			if (regInput.value.replace(/\D/g, "") !== digits) return;

			if (!student?.name) {
				resolvedFor = digits;
				resolvedName = "";
				resolvedBranch = "";
				renderStudentLine();
				return;
			}

			resolvedFor = digits;
			resolvedName = student.name.replace(/\s+/g, " ").trim();
			resolvedBranch = (student.branch || "").toUpperCase();

			const profile = getProfile();
			if (profile?.regNo === digits && profile.name !== resolvedName) {
				saveProfile({ name: resolvedName });
			}

			renderStudentLine();
		}

		function inferLateralFromReg(reg: string): boolean {
			const numeric = reg.replace(/\D/g, "");
			if (numeric.length < 3) return false;
			const serialCode = Number.parseInt(numeric.slice(-3), 10);
			return Number.isFinite(serialCode) && serialCode >= 900;
		}

		function setStatus(type: "muted" | "loading" | "ok" | "error", text: string) {
			statusEl.className = `status ${type}`;
			statusEl.textContent = text;
		}

		function resizeResultFrame() {
			const doc = frame.contentDocument;
			if (!doc) return;

			// A card is short and fixed; give it its own height instead of the
			// 780px floor the result tables need. It also stands on the page
			// without the frame border, like any other panel here.
			const card = doc.querySelector(".result-card");
			frameWrap.classList.toggle("is-card", Boolean(card));
			if (card) {
				const view = doc.defaultView;
				const pad = view
					? Number.parseFloat(view.getComputedStyle(doc.body).paddingTop) +
						Number.parseFloat(view.getComputedStyle(doc.body).paddingBottom)
					: 0;
				const height = card.getBoundingClientRect().height + pad;
				frame.style.height = `${Math.max(240, Math.round(height))}px`;
				return;
			}

			const bodyH = doc.body?.scrollHeight ?? 0;
			const htmlH = doc.documentElement?.scrollHeight ?? 0;
			const raw = Math.max(bodyH, htmlH);
			if (!raw) return;
			const target = Math.max(780, Math.min(raw + 24, 2600));
			frame.style.height = `${target}px`;
		}

		function updateUrl() {
			const reg = regInput.value.trim();
			const url = new URL(window.location.href);
			if (reg.length >= MIN_REG_LENGTH) {
				url.searchParams.set("reg", reg);
			} else {
				url.searchParams.delete("reg");
			}
			url.searchParams.set("sem", String(selectedSem));
			if (selectedView === "modern") {
				url.searchParams.set("view", "modern");
			} else {
				url.searchParams.delete("view");
			}
			window.history.replaceState({}, "", url);
		}

		function activateSemesterButton() {
			document.querySelectorAll<HTMLButtonElement>(".sem-btn").forEach((btn) => {
				const isActive = Number.parseInt(btn.dataset.sem || "0", 10) === selectedSem;
				btn.classList.toggle("active", isActive);
				btn.setAttribute("aria-pressed", String(isActive));
			});
			renderStudentLine();
		}

		function activateViewButtons() {
			document.querySelectorAll<HTMLButtonElement>(".view-btn").forEach((btn) => {
				const isActive = (btn.dataset.view || "official") === selectedView;
				btn.classList.toggle("active", isActive);
				btn.setAttribute("aria-pressed", String(isActive));
			});
		}

		async function loadResult() {
			const reg = regInput.value.trim();
			updateUrl();
			void resolveStudent(reg);

			if (timeoutTimer) {
				clearTimeout(timeoutTimer);
				timeoutTimer = null;
			}

			savePrompt.style.display = "none"; // Hide prompt when searching new
			if (reg.length < MIN_REG_LENGTH) {
				frame.removeAttribute("src");
				frameWrap.classList.remove("is-visible");
				printBtn.disabled = true;
				saveBtn.disabled = true;
				setStatus("muted", "Enter registration number to load result.");
				return;
			}

			// We do NOT auto-save profile here anymore if anonymous. 
			// We only allow save via the prompt after it loads.
			try {
				const profile = getProfile();
				if (profile && profile.regNo === reg) {
					// they are already logged in as this person, so keep them logged in
					document.documentElement.classList.add("is-logged-in");
				}
			} catch (e) {
				console.error("Failed checking profile", e);
			}

			const isLe = inferLateralFromReg(reg);
			setStatus(
				"loading",
				isLe
					? "LE auto-detected (9xx serial). Fetching using adjusted batch year..."
					: `Loading semester ${selectedSem} result (${selectedView} view)...`,
			);

			const theme =
				document.documentElement.getAttribute("data-theme") === "light"
					? "light"
					: "dark";
			frame.src = `${baseUrl}api/result?reg=${encodeURIComponent(reg)}&sem=${selectedSem}&view=${selectedView}&theme=${theme}`;
			timeoutTimer = setTimeout(() => {
				setStatus("error", "Result request timed out. BEU server may be slow or down.");
			}, 22000);
		}

		function initFromUrl() {
			const params = new URLSearchParams(window.location.search);
			let regParam = params.get("reg");
			let hasUrlSem = params.has("sem");

			try {
				const profile = getProfile();
				
				// Smart Default: If no reg in URL, load from local profile
				if (!regParam && profile && profile.regNo) {
					regParam = profile.regNo;
				}
				
				// Smart Default: pre-select the semester this batch sits in now.
				if (!hasUrlSem && profile && profile.batchYear) {
					selectedSem = inferCurrentSemester(profile.batchYear);
					hasUrlSem = true; // Pretend we had it so we don't overwrite below
				}
			} catch (e) {
				console.error(e);
			}

			regInput.value = (regParam || "").replace(/\D/g, "").slice(0, 11);
			
			if (hasUrlSem || params.has("sem")) {
				selectedSem = Number.parseInt(params.get("sem") || String(selectedSem), 10) || 1;
			}
			
			selectedView = params.get("view") === "modern" ? "modern" : "official";
			activateSemesterButton();
			activateViewButtons();
			if (regInput.value.trim().length >= MIN_REG_LENGTH) {
				loadResult();
			}
		}

		regInput.addEventListener("input", () => {
			const digits = regInput.value.replace(/\D/g, "").slice(0, 11);
			if (regInput.value !== digits) regInput.value = digits;
			renderStudentLine();
			updateUrl();
			if (debounceTimer) {
				clearTimeout(debounceTimer);
			}
			if (regInput.value.trim().length >= MIN_REG_LENGTH) {
				debounceTimer = setTimeout(loadResult, 300);
			}
		});

		regInput.addEventListener("keydown", (event) => {
			if (event.key === "Enter") {
				event.preventDefault();
				loadResult();
			}
		});

		document.querySelectorAll<HTMLButtonElement>(".sem-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				selectedSem = Number.parseInt(btn.dataset.sem || "1", 10);
				activateSemesterButton();
				loadResult();
			});
		});

		document.querySelectorAll<HTMLButtonElement>(".view-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				selectedView = btn.dataset.view === "modern" ? "modern" : "official";
				activateViewButtons();
				loadResult();
			});
		});

		frame.addEventListener("load", async () => {
			if (!frame.getAttribute("src")) return;
			frameWrap.classList.add("is-visible");
			printBtn.disabled = false;
			saveBtn.disabled = false;
			if (timeoutTimer) {
				clearTimeout(timeoutTimer);
				timeoutTimer = null;
			}
			resizeResultFrame();

			const doc = frame.contentDocument;
			const errorCard = doc?.querySelector(".error-card");
			if (errorCard) {
				// The card in the frame carries the full sentence and the way out;
				// the page status only says there is nothing to show.
				setStatus("muted", "No result to show.");
				return;
			}
			const viewLabel = selectedView === "official" ? "Official" : "Modern";
			let extractedName = "";
			let extractedSgpa = "";
			let extractedCgpa = "";
			let shouldPromptToSave = false;
			
			// Scrape SGPA & Name to make dashboard smarter!
			try {
				const profile = getProfile();
				
				// Extract data robustly supporting BOTH Modern and Official views
				
				// 1. Try Official View IDs first (Fastest and most reliable if official)
				const offName = doc?.getElementById("ContentPlaceHolder1_DataList1_StudentNameLabel_0")?.textContent?.trim();
				const offSgpa = doc?.getElementById("ContentPlaceHolder1_DataList5_GROSSTHEORYTOTALLabel_0")?.textContent?.trim();
				const offCgpa = doc?.getElementById("ContentPlaceHolder1_GridView3_CurCgpaLabel_0")?.textContent?.trim();

				if (offName) extractedName = offName;
				if (offSgpa) extractedSgpa = offSgpa;
				if (offCgpa) extractedCgpa = offCgpa;

				// 2. Fallback to Modern View selectors if empty
				if (!extractedName) {
					const modernChips = Array.from(doc?.querySelectorAll(".modern-chip") || []);
					const nameChip = modernChips.find(chip => chip.textContent?.includes("Student Name:"));
					if (nameChip) {
						extractedName = nameChip.textContent?.replace("Student Name:", "").trim() || "";
					}
				}

				if (!extractedSgpa || !extractedCgpa) {
					const kpiCards = Array.from(doc?.querySelectorAll(".modern-kpi-card") || []);
					if (!extractedSgpa) {
						const sgpaCard = kpiCards.find(card => card.textContent?.includes("SGPA"));
						if (sgpaCard) extractedSgpa = sgpaCard.querySelector("strong")?.textContent?.trim() || "";
					}
					if (!extractedCgpa) {
						const cgpaCard = kpiCards.find(card => card.textContent?.includes("CGPA"));
						if (cgpaCard) extractedCgpa = cgpaCard.querySelector("strong")?.textContent?.trim() || "";
					}
				}

				// If they are checking their OWN saved result, silent update the SGPA/CGPA
				if (profile && profile.regNo === regInput.value.trim()) {
					const updates: any = { regNo: regInput.value.trim() };
					if (extractedName) updates.name = extractedName;
					
					// Issue #12 Fix: Only update SGPA/CGPA if viewing the latest or newer semester
					const lastSavedSem = profile.lastSemChecked || 0;
					if (selectedSem >= lastSavedSem) {
						if (extractedSgpa) updates.lastSgpa = extractedSgpa;
						if (extractedCgpa) updates.lastCgpa = extractedCgpa;
						updates.lastSemChecked = selectedSem;
					}
					
					if (Object.keys(updates).length > 1) {
						saveProfile(updates);
					}
				} 
				// If they are checking a completely new/different result, show the Save Prompt
				else if (extractedName || extractedSgpa) {
					shouldPromptToSave = true;
				}

			} catch (e) {
				console.error("Silent scrape error:", e);
			}

			setStatus("ok", `${viewLabel} result loaded.`);

			if (shouldPromptToSave) {
				savePrompt.style.display = "flex";
				savePrompt.style.animation = "fadeInUp 0.3s ease";
				confirmSaveBtn.onclick = async () => {
					try {
						const { parseRegNo, saveProfile } = await import("../utils/profileManager");
						const parsed = parseRegNo(regInput.value.trim());
						if (parsed.regNo) {
							// Determine if they are saving an old semester
							const expectedLatestSem = parsed.currentSem || 1;
							const isLatestSem = selectedSem >= expectedLatestSem - 1; // Tolerance for results not out yet
							
							saveProfile({
								...parsed,
								name: extractedName || undefined,
								lastSgpa: isLatestSem ? (extractedSgpa || undefined) : undefined,
								lastCgpa: isLatestSem ? (extractedCgpa || undefined) : undefined,
								lastSemChecked: isLatestSem ? selectedSem : undefined
							});
							
							document.documentElement.classList.add("is-logged-in");
							savePrompt.style.display = "none";
							setStatus("ok", `Profile saved! Welcome, ${extractedName || "Student"}.`);

							// If they viewed an old semester, fetch the latest one in the background to hydrate dashboard correctly
							if (!isLatestSem) {
								fetch(`${baseUrl}api/result?reg=${encodeURIComponent(parsed.regNo)}&sem=${expectedLatestSem}&format=json`)
									.then(res => res.json())
									.then(data => {
										if (data.status === 200 && data.data) {
											saveProfile({
												lastSgpa: data.data.sgpa && Array.isArray(data.data.sgpa) ? data.data.sgpa[expectedLatestSem - 1] : undefined,
												lastCgpa: data.data.cgpa || undefined,
												lastSemChecked: expectedLatestSem
											});
										}
									}).catch(e => console.log("Background hydrate failed", e));
							}
						}
					} catch(e) {
						console.error("Failed to save from prompt", e);
					}
				};
			}
		});

		frame.addEventListener("error", () => {
			if (timeoutTimer) {
				clearTimeout(timeoutTimer);
				timeoutTimer = null;
			}
			setStatus("error", "Failed to load result.");
		});

		printBtn.addEventListener("click", () => {
			const win = frame.contentWindow;
			const html = frame.contentDocument?.documentElement?.outerHTML || "";
			if (!win || !html.trim()) {
				setStatus("error", "No result loaded yet.");
				return;
			}
			win.focus();
			win.print();
		});

		saveBtn.addEventListener("click", () => {
			const html = frame.contentDocument?.documentElement?.outerHTML || "";
			if (!html.trim()) {
				setStatus("error", "No result loaded yet.");
				return;
			}
			const reg = regInput.value.trim() || "unknown";
			const blob = new Blob([html], { type: "text/html" });
			const a = document.createElement("a");
			a.href = URL.createObjectURL(blob);
			a.download = `BEU_Result_${reg}_Sem${selectedSem}.html`;
			a.click();
			URL.revokeObjectURL(a.href);
		});

		// A card is drawn inside the frame with its own tokens; repaint it when
		// the theme changes so it never sits in the opposite scheme.
		window.addEventListener("beu:theme", () => {
			if (!frame.getAttribute("src")) return;
			if (!frame.contentDocument?.querySelector(".result-card")) return;
			loadResult();
		});

		initFromUrl();
	</script>

	<style>
		.result-shell {
			display: grid;
			gap: var(--s4);
		}

		.student-line {
			margin: 0.35rem 0 0;
			color: var(--paper);
			font-size: 0.9rem;
			font-variant-numeric: tabular-nums;
			overflow-wrap: anywhere;
		}

		.controls {
			display: grid;
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto;
			align-items: end;
			gap: var(--s5);
			margin: 0;
			padding: var(--s4) var(--s5);
			border: 1px solid var(--line);
			border-radius: var(--r-lg);
			background: var(--surface);
		}

		.controls fieldset {
			min-width: 0;
			margin: 0;
			padding: 0;
			border: 0;
		}

		.controls legend {
			margin-bottom: 0.35rem;
			padding: 0;
			color: var(--paper);
			font-size: 0.78rem;
			font-weight: 600;
		}

		.reg-row {
			display: flex;
			gap: var(--s2);
		}

		.reg-row input {
			flex: 1;
			min-width: 0;
			font-variant-numeric: tabular-nums;
			letter-spacing: 0.04em;
		}

		.sem-row {
			display: grid;
			grid-template-columns: repeat(8, minmax(0, 1fr));
			gap: 2px;
		}

		.sem-btn {
			min-height: 2.5rem;
			padding: 0;
			border-radius: 0;
			font-size: 0.8rem;
			font-variant-numeric: tabular-nums;
		}

		.sem-btn.active {
			border-color: var(--accent);
			background: var(--accent);
			color: var(--accent-ink);
		}

		.view-btn {
			min-height: 2.5rem;
			border: 0;
			border-radius: 0;
			background: transparent;
			color: var(--muted);
		}

		.view-btn + .view-btn {
			border-left: 1px solid var(--line);
		}

		.view-btn.active {
			background: var(--surface-2);
			color: var(--paper);
		}

		.save-prompt {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
			gap: var(--s3);
			padding: var(--s3) var(--s4);
			border: 1px solid var(--line);
			border-left: 3px solid var(--accent);
			border-radius: 0 var(--r) var(--r) 0;
			background: var(--accent-soft);
		}

		.save-prompt h2 {
			font-family: var(--font-sans);
			font-size: 0.85rem;
			font-weight: 650;
		}

		.frame-wrap {
			display: none;
			border: 1px solid var(--line);
			border-radius: var(--r-lg);
			background: var(--surface);
			overflow: hidden;
		}

		.frame-wrap.is-visible {
			display: block;
			transition:
				opacity var(--dur-ui) var(--ease-out),
				transform var(--dur-ui) var(--ease-out);
		}

		@starting-style {
			.frame-wrap.is-visible {
				opacity: 0;
				transform: translateY(6px);
			}
		}

		.frame-wrap.is-card {
			border-color: transparent;
			background: transparent;
		}

		#resultBox {
			display: block;
			width: 100%;
			height: min(90vh, 1300px);
			border: 0;
			background: transparent;
		}

		@keyframes fadeInUp {
			from { opacity: 0; transform: translateY(6px); }
			to { opacity: 1; transform: none; }
		}

		@media (max-width: 900px) {
			.controls {
				grid-template-columns: 1fr;
			}
		}

		@media (max-width: 560px) {
			.sem-row {
				grid-template-columns: repeat(4, minmax(0, 1fr));
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.frame-wrap.is-visible {
				transition-property: opacity;
				transition-duration: 120ms !important;
			}
		}
	</style>

</Layout>

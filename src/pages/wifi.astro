---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout
	title="WiFi bookmarklet"
	description="Generate a one-click login bookmarklet for the GEC Sheikhpura campus WiFi portal."
>
	<header class="page-head">
		<div>
			<h1>WiFi bookmarklet</h1>
			<p class="meta">GEC Sheikhpura campus portal</p>
		</div>
	</header>

	<div class="generator">
		<form id="bookmarkletForm" class="generator-form">
			<div class="field">
				<label class="field-label" for="bmReNo">Registration number</label>
				<input type="text" id="bmReNo" inputmode="numeric" autocomplete="username" placeholder="21101157017" />
			</div>
			<div class="field">
				<label class="field-label" for="bmPass">WiFi password</label>
				<input type="password" id="bmPass" autocomplete="current-password" placeholder="Campus password" />
			</div>

			<p class="form-status" id="bmStatus" role="status"></p>

			<button type="button" id="generateBtn" class="btn btn-primary">Generate</button>
		</form>

		<div id="resultArea" hidden>
			<h2>Save the bookmark</h2>
			<p class="text">
				Drag the button to your bookmarks bar, then click it on the WiFi login page.
			</p>

			<div class="drag-zone">
				<a href="#" id="bookmarkletLink" class="btn btn-primary drag-btn" onclick="return false;">GEC WiFi login</a>
				<a href="#" id="copyBookmarklet" class="copy-link">Copy instead</a>
			</div>

			<details>
				<summary>Raw bookmarklet code</summary>
				<pre id="rawCode"></pre>
			</details>
		</div>
	</div>

	<style>
		.generator {
			display: grid;
			gap: var(--s5);
			max-width: 34rem;
			margin-top: var(--s5);
		}

		.generator-form {
			display: grid;
			gap: var(--s3);
			padding: var(--s5);
			border: 1px solid var(--line);
			border-radius: var(--r-lg);
			background: var(--surface);
		}

		.generator-form .btn {
			justify-self: start;
			margin-top: var(--s2);
		}

		.form-status {
			min-height: 1.1rem;
			margin: 0;
			color: var(--bad);
			font-size: 0.8rem;
		}

		#resultArea {
			display: grid;
			gap: var(--s3);
			padding-top: var(--s4);
			border-top: 1px solid var(--line-strong);
		}

		#resultArea[hidden] {
			display: none;
		}

		#resultArea h2 {
			margin: 0;
			font-family: var(--font-sans);
			font-size: 0.72rem;
			font-weight: 650;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--faint);
		}

		.text {
			margin: 0;
			color: var(--muted);
			font-size: 0.9rem;
		}

		.drag-zone {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--s4);
			padding: var(--s4);
			border: 1px dashed var(--line-strong);
			border-radius: var(--r-lg);
		}

		.drag-btn {
			cursor: grab;
		}

		.drag-btn:active {
			cursor: grabbing;
		}

		.copy-link {
			background: none;
			border: 0;
			padding: 0;
			color: var(--faint);
			font-size: 0.8rem;
			text-decoration: underline;
			text-underline-offset: 0.2em;
			cursor: pointer;
		}

		.copy-link:hover {
			color: var(--paper);
		}

		details {
			border-bottom: 1px solid var(--line);
			padding-bottom: var(--s3);
		}

		summary {
			color: var(--muted);
			font-size: 0.85rem;
			cursor: pointer;
		}

		pre {
			overflow-x: auto;
			margin: var(--s3) 0 0;
			padding: var(--s3);
			background: var(--surface-2);
			border-radius: var(--r);
			font-size: 0.72rem;
			white-space: pre-wrap;
			word-break: break-all;
		}
	</style>

	<script>
		document.addEventListener("DOMContentLoaded", () => {
			const btn = document.getElementById("generateBtn");
			const form = document.getElementById("bookmarkletForm") as HTMLFormElement | null;
			const regInput = document.getElementById("bmReNo") as HTMLInputElement | null;
			const passInput = document.getElementById("bmPass") as HTMLInputElement | null;
			const resultArea = document.getElementById("resultArea");
			const link = document.getElementById("bookmarkletLink") as HTMLAnchorElement | null;
			const rawCode = document.getElementById("rawCode");
			const status = document.getElementById("bmStatus");
			const copyBtn = document.getElementById("copyBookmarklet");

			if (!btn || !regInput || !passInput || !resultArea || !link || !rawCode) return;

			btn.addEventListener("click", () => {
				const username = regInput.value.trim();
				const password = passInput.value.trim();

				if (!username || !password) {
					if (status) status.textContent = "Enter both the registration number and password.";
					return;
				}

				if (status) status.textContent = "";

				const code = `javascript:(function(){
                    var u=document.querySelector('input[name="username"]') || document.getElementById('user');
                    var p=document.querySelector('input[name="password"]') || document.getElementById('pass');
                    var b=document.querySelector('input[type="submit"]') || document.getElementById('loginBtn');
                    if(u) u.value='${username.replace(/'/g, "\\'")}';
                    if(p) p.value='${password.replace(/'/g, "\\'")}';
                    if(b) b.click();
                    else document.forms[0].submit();
                })();`.replace(/\s+/g, " ");

				link.href = code;
				rawCode.textContent = code;
				resultArea.removeAttribute("hidden");
			});

			form?.addEventListener("submit", (event) => event.preventDefault());

			copyBtn?.addEventListener("click", async (event) => {
				event.preventDefault();
				await navigator.clipboard.writeText(rawCode.textContent ?? "");
				copyBtn.textContent = "Copied";
			});
		});
	</script>
</Layout>

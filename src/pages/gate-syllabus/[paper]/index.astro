---
export const prerender = true;
import Layout from "../../../layouts/Layout.astro";
import papersList from "../../../assets/data/gate-papers.json";

export async function getStaticPaths() {
	const papers = (await import("../../../assets/data/gate-papers.json"))
		.default;
	return papers.map((p) => ({ params: { paper: p.code } }));
}

const { paper } = Astro.params;
const paperInfo = papersList.find(p => p.code === paper);
const paperName = paperInfo ? paperInfo.name : "";
const syllabus = await import(`../../../assets/data/gate/${paper}.json`).catch(
    () => null,
);
const data = syllabus ? syllabus.default : null;
---

<Layout
    title={`GATE ${paper} syllabus`}
    description={`GATE ${paper} ${paperName} syllabus, section by section.`}
>
    <header class="page-head">
        <div>
            <p class="back"><a href={`${import.meta.env.BASE_URL}gate-syllabus/`}>GATE syllabus</a></p>
            <h1>{paperName || paper}</h1>
            <p class="meta num">{paper}</p>
        </div>
    </header>

    {
        data ? (
            <div class="sections">
                {data.sections.map((sec) => (
                    <details>
                        <summary>{sec.title}</summary>
                        <p>{sec.content}</p>
                    </details>
                ))}
            </div>
        ) : (
            <p class="empty">Syllabus is not available for this paper.</p>
        )
    }

    <style>
        .back {
            margin: 0 0 var(--s2);
            font-size: 0.78rem;
        }

        .back a {
            color: var(--faint);
            text-decoration: none;
        }

        .back a:hover {
            color: var(--paper);
        }

        .sections {
            margin-top: var(--s5);
            border-top: 1px solid var(--line-strong);
        }

        details {
            padding: var(--s3) 0;
            border-bottom: 1px solid var(--line);
        }

        summary {
            color: var(--paper);
            font-weight: 600;
            cursor: pointer;
        }

        details p {
            max-width: var(--measure);
            margin: var(--s3) 0 0;
            color: var(--muted);
            font-size: 0.9rem;
            white-space: pre-wrap;
        }

        .empty {
            margin: var(--s5) 0;
            color: var(--faint);
        }
    </style>
</Layout>

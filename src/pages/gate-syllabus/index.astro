---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import BranchIcon from "../../components/BranchIcon.astro";
import papers from "../../assets/data/gate-papers.json";

const base = import.meta.env.BASE_URL;
---

<Layout title="GATE syllabus" description="Paper-wise GATE syllabus.">
    <header class="page-head">
        <div>
            <h1>GATE syllabus</h1>
            <p class="meta num">{papers.length} papers</p>
        </div>
    </header>

    <ul class="paper-list">
        {
            papers.map((p) => (
                <li>
                    <a href={`${base}gate-syllabus/${p.code}/`}>
                        <span class="code num">{p.code}</span>
                        <span class="name"><BranchIcon branch={p.code} />{p.name}</span>
                    </a>
                </li>
            ))
        }
    </ul>

    <style>
        .paper-list {
            margin: var(--s5) 0 0;
            padding: 0;
            list-style: none;
            border-top: 1px solid var(--line-strong);
        }

        .paper-list li {
            border-bottom: 1px solid var(--line);
            list-style: none;
        }

        .paper-list a {
            display: grid;
            grid-template-columns: 4rem minmax(0, 1fr);
            align-items: baseline;
            gap: var(--s3);
            padding: var(--s3) 0;
            color: var(--paper);
            text-decoration: none;
        }

        @media (hover: hover) and (pointer: fine) {
            .paper-list a:hover .name {
                text-decoration: underline;
                text-underline-offset: 0.2em;
            }
        }

        .paper-list a:active .name {
            text-decoration: underline;
            text-underline-offset: 0.2em;
        }

        .code {
            color: var(--faint);
            font-size: 0.72rem;
            letter-spacing: 0.04em;
        }
    </style>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
---

<Layout title="CGPA & SGPA Calculator | BEUConnect" description="Calculate your SGPA and CGPA easily with different input options according to BEU grading system.">
    <Header />
    <main class="container">
        <section class="calculator-hero">
            <h1 class="page-title">
                <span class="gradient-text">CGPA & SGPA</span> Calculator
            </h1>
            <p class="page-subtitle">
                Accurate calculations based on the latest Bihar Engineering University (BEU) 7-scale grading system.
            </p>
        </section>

        <article class="calculator-card glass-panel" id="calc-root">
            <header class="calculator-header">
                <fieldset>
                    <div class="mode-toggle-group">
                        <input type="radio" id="mode-sgpa-radio" name="calc-mode" value="sgpa" checked />
                        <label for="mode-sgpa-radio">SGPA (Subjects)</label>

                        <input type="radio" id="mode-cgpa-sem-radio" name="calc-mode" value="cgpa-sem" />
                        <label for="mode-cgpa-sem-radio">CGPA (Semesters)</label>

                        <input type="radio" id="mode-cgpa-quick-radio" name="calc-mode" value="cgpa-quick" />
                        <label for="mode-cgpa-quick-radio">Quick Update</label>

                        <input type="radio" id="mode-target-radio" name="calc-mode" value="target" />
                        <label for="mode-target-radio">Target Planner</label>
                    </div>
                </fieldset>
            </header>

            <div class="calculator-body">
                <!-- SGPA Mode UI -->
                <div id="mode-sgpa" class="calc-view active fade-in">
                    <div class="view-intro">
                        <h3>SGPA Calculator</h3>
                        <p>Enter your IA (Internal) and ESE (External) marks. We'll automatically calculate your BEU grade!</p>
                    </div>

                    <div class="input-grid-header hidden-mobile">
                        <div>Subject</div>
                        <div>Credits</div>
                        <div>Total</div>
                        <div style="text-align:center;">Marks (IA + ESE)</div>
                        <div>Action</div>
                    </div>

                    <div id="sgpa-rows-container" class="rows-container">
                        <!-- Rows injected via JS -->
                    </div>

                    <div class="action-bar">
                        <button id="add-sgpa-row" class="outline contrast">+ Add Subject</button>
                        <button id="clear-sgpa" class="outline secondary">Clear All</button>
                    </div>

                    <div class="result-display" id="sgpa-result-display">
                        <div class="result-label">Estimated SGPA</div>
                        <div class="result-value" id="sgpa-value">0.00</div>
                        <div class="result-subtext" id="sgpa-credits-text">Total Credits: 0</div>
                        <div class="error-msg" id="sgpa-error"></div>
                    </div>
                </div>

                <!-- CGPA Semester Mode UI -->
                <div id="mode-cgpa-sem" class="calc-view hidden fade-in">
                    <div class="view-intro">
                        <h3>Semester-wise CGPA</h3>
                        <p>Calculate Cumulative GPA across multiple semesters using quick SGPA or detailed marks.</p>
                    </div>

                    <div class="action-bar center" style="margin-bottom: 1rem; padding-top: 0; border-top: none;">
                        <button id="add-cgpa-sem-row" class="outline contrast">+ Add Semester</button>
                    </div>

                    <div id="cgpa-sem-cards-container" class="cards-container">
                        <!-- Semester Cards injected via JS -->
                    </div>

                    <div class="action-bar">
                        <button id="clear-cgpa-sem" class="outline secondary">Clear All Semesters</button>
                    </div>

                    <div class="result-display" id="cgpa-sem-result-display">
                        <div class="result-label">Estimated CGPA</div>
                        <div class="result-value" id="cgpa-sem-value">0.00</div>
                        <div class="result-subtext" id="cgpa-sem-credits-text">Total Credits: 0</div>
                        <div class="error-msg" id="cgpa-sem-error"></div>
                    </div>
                </div>

                <!-- CGPA Quick Mode UI -->
                <div id="mode-cgpa-quick" class="calc-view hidden fade-in">
                    <div class="view-intro">
                        <h3>Quick CGPA Update</h3>
                        <p>Combine your current overall CGPA with your latest semester's results.</p>
                    </div>

                    <div class="quick-form-grid">
                        <div class="input-group">
                            <label>Current CGPA</label>
                            <input type="number" id="current-cgpa" min="0" max="10" step="0.01" placeholder="e.g., 8.21">
                        </div>
                        <div class="input-group">
                            <label>Previous Total Credits</label>
                            <input type="number" id="current-credits" min="0" step="0.5" placeholder="e.g., 120">
                        </div>
                        <div class="input-group">
                            <label>New Semester SGPA</label>
                            <input type="number" id="new-sgpa" min="0" max="10" step="0.01" placeholder="e.g., 8.74">
                        </div>
                        <div class="input-group">
                            <label>New Semester Credits</label>
                            <input type="number" id="new-credits" min="0" step="0.5" placeholder="e.g., 20">
                        </div>
                    </div>

                    <div class="action-bar center">
                        <button id="clear-cgpa-quick" class="outline secondary">Reset Fields</button>
                    </div>

                    <div class="result-display" id="cgpa-quick-result-display">
                        <div class="result-label">Updated CGPA</div>
                        <div class="result-value" id="cgpa-quick-value">0.00</div>
                        <div class="result-subtext" id="cgpa-quick-credits-text">Total Credits: 0</div>
                        <div class="error-msg" id="cgpa-quick-error"></div>
                    </div>
                </div>

                <!-- Target CGPA Planner UI -->
                <div id="mode-target" class="calc-view hidden fade-in">
                    <div class="view-intro">
                        <h3>Target CGPA Planner</h3>
                        <p>Find out exactly what SGPA you need this semester to hit your dream CGPA.</p>
                    </div>

                    <div class="quick-form-grid">
                        <div class="input-group">
                            <label>Current CGPA</label>
                            <input type="number" id="target-curr-cgpa" min="0" max="10" step="0.01" placeholder="e.g., 7.50">
                        </div>
                        <div class="input-group">
                            <label>Previous Total Credits</label>
                            <input type="number" id="target-prev-credits" min="0" step="0.5" placeholder="e.g., 80">
                        </div>
                        <div class="input-group">
                            <label>Target CGPA</label>
                            <input type="number" id="target-target-cgpa" min="0" max="10" step="0.01" placeholder="e.g., 8.00">
                        </div>
                        <div class="input-group">
                            <label>Current Sem Credits</label>
                            <input type="number" id="target-sem-credits" min="0" step="0.5" placeholder="e.g., 20">
                        </div>
                    </div>

                    <div class="action-bar center">
                        <button id="clear-target" class="outline secondary">Reset Fields</button>
                    </div>

                    <div class="result-display" id="target-result-display">
                        <div class="result-label">Required SGPA</div>
                        <div class="result-value" id="target-value" style="font-size: 3rem;">0.00</div>
                        <div class="result-subtext" id="target-subtext" style="color: var(--pico-color); margin-top: 1rem; font-weight: 500;">Enter your details to plan your semester.</div>
                        <div class="error-msg" id="target-error"></div>
                    </div>
                </div>
            </div>
        </article>
    </main>
    <Footer />
</Layout>

<style>
    .calculator-hero { text-align: center; margin: 2rem 0 1.5rem; }
    .page-title { font-size: clamp(1.8rem, 4vw, 2.8rem); margin-bottom: 0.25rem; font-weight: 800; letter-spacing: -0.02em; }
    .gradient-text { background: var(--accent-gradient, linear-gradient(90deg, #3b82f6, #06b6d4)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .page-subtitle { color: var(--pico-muted-color); max-width: 600px; margin: 0 auto; font-size: 0.95rem; }
    
    .calculator-card { max-width: 850px; margin: 0 auto 3rem; padding: 0; overflow: hidden; border: 1px solid var(--pico-form-element-border-color); box-shadow: 0 10px 30px rgba(0,0,0,0.1); }
    .calculator-header { background: var(--pico-card-sectioning-background-color); padding: 1rem 1.5rem; border-bottom: 1px solid var(--pico-form-element-border-color); }
    
    fieldset { margin: 0; padding: 0; border: none; }
    
    .mode-toggle-group { display: grid; grid-template-columns: repeat(4, 1fr); background: var(--pico-background-color); border-radius: var(--pico-border-radius); border: 1px solid var(--pico-form-element-border-color); overflow: hidden; width: 100%; }
    .mode-toggle-group input[type="radio"] { display: none; }
    .mode-toggle-group label { text-align: center; padding: 0.6rem 0.5rem; margin: 0; cursor: pointer; font-weight: 600; font-size: 0.8rem; color: var(--pico-muted-color); transition: transform 0.2s ease; border-right: 1px solid var(--pico-form-element-border-color); }
    .mode-toggle-group label:last-child { border-right: none; }
    .mode-toggle-group label:hover { background: var(--pico-form-element-background-color); color: var(--pico-color); }
    .mode-toggle-group input[type="radio"]:checked + label { background: var(--pico-primary-background); color: var(--pico-primary-inverse); }

    .calculator-body { padding: 1.5rem; }
    .view-intro { text-align: center; margin-bottom: 1.5rem; }
    .view-intro h3 { margin-bottom: 0.25rem; font-size: 1.25rem; color: var(--pico-h1-color); }
    .view-intro p { color: var(--pico-muted-color); font-size: 0.85rem; margin-bottom: 0; }

    .input-grid-header { display: grid; grid-template-columns: 2fr 0.8fr 0.8fr 2.5fr 40px; gap: 0.5rem; padding: 0 0.25rem 0.5rem; border-bottom: 2px solid var(--pico-form-element-border-color); margin-bottom: 0.5rem; font-weight: 600; color: var(--pico-muted-color); font-size: 0.8rem; }
    .rows-container { display: flex; flex-direction: column; gap: 0.25rem; margin-bottom: 1rem; }

    :global(.dynamic-row) { display: grid; grid-template-columns: 2fr 0.8fr 0.8fr 2.5fr 40px; gap: 0.5rem; align-items: center; padding: 0.5rem 0; border-bottom: 1px dashed var(--border-subtle); animation: slideIn 0.3s ease-out forwards; }
    :global(.dynamic-row:last-child) { border-bottom: none; }
    :global(.dynamic-row input), :global(.dynamic-row select) { height: 2.2rem; font-size: 0.85rem; padding: 0.25rem 0.5rem; margin-bottom: 0; width: 100%; border-radius: 6px; }
    
    :global(.marks-group) { display: flex; gap: 0.25rem; align-items: center; justify-content: space-between; }
    :global(.marks-group input) { width: 38%; text-align: center; padding-left: 0; padding-right: 0;}
    :global(.grade-badge) { width: 20%; text-align: center; font-weight: 800; font-size: 0.85rem; padding: 0.2rem; border-radius: 4px; background: var(--pico-form-element-background-color); color: var(--pico-muted-color); }
    :global(.grade-badge.active) { background: var(--pico-primary-background); color: var(--pico-primary-inverse); }
    :global(.grade-badge.fail) { background: var(--pico-del-color); color: white; }

    :global(.btn-remove) { height: 2.2rem; width: 2.2rem; display: flex; align-items: center; justify-content: center; padding: 0; margin: 0 auto; background: transparent; border: 1px solid var(--pico-del-color, #ef4444); color: var(--pico-del-color, #ef4444); border-radius: 50%; cursor: pointer; transition: transform 0.2s; }
    :global(.btn-remove:hover) { background: var(--pico-del-color, #ef4444); color: white; }

    .action-bar { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; padding-top: 0.5rem; }
    .action-bar.center { justify-content: center; }
    .action-bar button { margin: 0; font-size: 0.85rem; padding: 0.5rem 1rem; }

    .quick-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem; }
    .input-group label { font-weight: 600; font-size: 0.8rem; margin-bottom: 0.25rem; display: block; color: var(--pico-muted-color); }
    .input-group input { height: 2.5rem; font-size: 0.9rem; margin-bottom: 0; }

    .cards-container { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1rem; }
    :global(.semester-card) { background: var(--pico-background-color); border: 1px solid var(--pico-form-element-border-color); border-radius: var(--radius-md); padding: 1rem; animation: slideIn 0.3s ease-out forwards; }
    :global(.semester-card-header) { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid var(--pico-form-element-border-color); padding-bottom: 0.75rem; }
    :global(.semester-card-title input) { margin: 0; height: 2rem; width: 120px; font-weight: 700; font-size: 1rem; background: transparent; border: none; padding: 0; }
    
    :global(.sem-toggle-group) { display: flex; background: var(--pico-form-element-background-color); border-radius: 20px; padding: 2px; }
    :global(.sem-toggle-btn) { border: none; background: transparent; color: var(--pico-muted-color); padding: 0.25rem 0.75rem; font-size: 0.75rem; font-weight: 700; border-radius: 20px; cursor: pointer; transition: transform 0.2s; margin: 0; }
    :global(.sem-toggle-btn.active) { background: var(--pico-primary-background); color: var(--pico-primary-inverse); }
    
    :global(.sem-quick-view), :global(.sem-detailed-view) { display: none; animation: fadeIn 0.3s ease-out; }
    :global(.sem-quick-view.active), :global(.sem-detailed-view.active) { display: block; }
    :global(.sem-quick-grid) { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    
    :global(.detailed-subjects-container) { display: flex; flex-direction: column; gap: 0; margin-bottom: 0.75rem; }
    :global(.sem-summary-footer) { background: var(--pico-form-element-background-color); padding: 0.5rem 1rem; border-radius: var(--radius-sm); display: flex; justify-content: space-between; margin-top: 0.75rem; font-size: 0.85rem; font-weight: 700; }
    :global(.detailed-add-btn) { margin: 0; width: 100%; font-size: 0.8rem; height: 2.2rem; padding: 0; }

    .result-display { background: var(--pico-card-sectioning-background-color); border: 2px solid var(--pico-primary-background); border-radius: var(--radius-md); padding: 1.5rem; text-align: center; transition: transform 0.3s ease; position: relative; overflow: hidden; }
    .result-display::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--accent-gradient, linear-gradient(90deg, #3b82f6, #06b6d4)); }
    .result-label { font-size: 0.9rem; color: var(--pico-muted-color); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .result-value { font-size: 3.5rem; font-weight: 800; color: var(--pico-h1-color); line-height: 1.2; margin: 0.25rem 0; font-variant-numeric: tabular-nums; transition: color 0.3s ease; }
    .result-value.valid { color: var(--pico-primary-background); }
    .result-subtext { font-size: 0.85rem; color: var(--pico-muted-color); }
    .error-msg { color: var(--pico-del-color, #ef4444); font-size: 0.85rem; margin-top: 0.5rem; min-height: 1.2rem; font-weight: 600; }

    .hidden { display: none !important; }
    .active { display: block; }
    .fade-in { animation: fadeIn 0.4s ease-out; }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
    @keyframes slideIn { from { opacity: 0; transform: translateX(-5px); } to { opacity: 1; transform: translateX(0); } }

    @media (max-width: 768px) {
        .mode-toggle-group { grid-template-columns: 1fr 1fr; }
        .mode-toggle-group label { border-bottom: 1px solid var(--pico-form-element-border-color); }
        .mode-toggle-group label:nth-child(4), .mode-toggle-group label:nth-child(8) { border-right: none; }
        .mode-toggle-group label:nth-last-child(-n+2) { border-bottom: none; }

        .hidden-mobile { display: none; }

        :global(.dynamic-row) { 
            grid-template-columns: 1fr 1fr; 
            grid-template-areas: "name name" "credit total" "marks action"; 
            background: var(--pico-card-sectioning-background-color); 
            padding: 0.75rem; border-radius: var(--radius-sm); border: 1px solid var(--pico-form-element-border-color); margin-bottom: 0.5rem; gap: 0.5rem;
        }
        :global(.col-name) { grid-area: name; }
        :global(.col-credit) { grid-area: credit; display: flex; align-items: center; gap: 0.5rem; }
        :global(.col-credit::before) { content: "Cr:"; font-size: 0.75rem; font-weight: 600; color: var(--pico-muted-color); }
        :global(.col-total) { grid-area: total; display: flex; align-items: center; gap: 0.5rem; }
        :global(.col-total::before) { content: "Tot:"; font-size: 0.75rem; font-weight: 600; color: var(--pico-muted-color); }
        :global(.col-marks) { grid-area: marks; }
        :global(.col-action) { grid-area: action; display: flex; justify-content: flex-end; }
        :global(.btn-remove) { margin: 0; }

        .action-bar { flex-direction: column; }
        .action-bar button { width: 100%; }
        .quick-form-grid { grid-template-columns: 1fr; gap: 0.75rem; }
    }
</style>

<script>
    import { BEU_GRADES, calculateGrade, calculateSgpa, calculateQuickCgpa, calculateTargetSgpa } from '../lib/calculator/engine';

    // Generate credit options (1.0 to 10.0)
    const creditsOptionsHTML = Array.from({length: 19}, (_, i) => {
        const val = (i * 0.5 + 1).toFixed(1);
        return `<option value="${val}" ${val === '3.0' ? 'selected' : ''}>${val}</option>`;
    }).join('');

    const initCalculator = () => {
        const root = document.getElementById('calc-root');
        if (!root || root.dataset.init === "true") return;
        root.dataset.init = "true";

        // --- Tab Switching ---
        document.querySelectorAll('input[name="calc-mode"]').forEach(radio => {
            radio.addEventListener('change', (e) => {
                const targetId = `mode-${(e.target as HTMLInputElement).value}`;
                document.querySelectorAll('.calc-view').forEach(view => {
                    if (view.id === targetId) { view.classList.remove('hidden'); view.classList.add('active'); }
                    else { view.classList.add('hidden'); view.classList.remove('active'); }
                });
            });
        });

        const generateId = () => Math.random().toString(36).substring(2, 9);

        // --- GRADE CALCULATION LOGIC ---
        const validateMarks = (row: Element) => {
            const totalSel = row.querySelector('.sgpa-total') as HTMLSelectElement;
            const iaInput = row.querySelector('.sgpa-ia') as HTMLInputElement;
            const eseInput = row.querySelector('.sgpa-ese') as HTMLInputElement;
            const badge = row.querySelector('.grade-badge') as HTMLElement;

            if (!totalSel || !iaInput || !eseInput || !badge) return;

            const total = parseInt(totalSel.value);
            let ia = parseFloat(iaInput.value);
            let ese = parseFloat(eseInput.value);

            // Bounds logic was inside validateMarks, but let's keep it simple for UI bounds
            const maxIa = total === 100 ? 30 : 20;
            const maxEse = total === 100 ? 70 : 30;
            if (!isNaN(ia)) { if (ia < 0) ia = 0; if (ia > maxIa) ia = maxIa; iaInput.value = ia.toString(); }
            if (!isNaN(ese)) { if (ese < 0) ese = 0; if (ese > maxEse) ese = maxEse; eseInput.value = ese.toString(); }

            const grade = calculateGrade(total, ia, ese);
            if (grade === '-') {
                badge.textContent = '-';
                badge.dataset.grade = '';
                badge.className = 'grade-badge';
            } else {
                badge.textContent = grade;
                badge.dataset.grade = grade;
                badge.className = `grade-badge ${grade === 'F' ? 'fail' : 'active'}`;
            }
        };

        // --- SGPA CALCULATOR ---
        const sgpaContainer = document.getElementById('sgpa-rows-container');
        const sgpaValueDisplay = document.getElementById('sgpa-value');
        const sgpaCreditsDisplay = document.getElementById('sgpa-credits-text');
        const sgpaErrorDisplay = document.getElementById('sgpa-error');
        let sgpaRowsCount = 0;

        const calculateSgpaView = () => {
            if (!sgpaContainer || !sgpaValueDisplay || !sgpaCreditsDisplay || !sgpaErrorDisplay) return;

            const subjects: { credit: number; grade: string }[] = [];
            let hasIncompleteRows = false;
            let hasValidInputs = false;

            sgpaContainer.querySelectorAll('.dynamic-row').forEach(row => {
                const credit = parseFloat((row.querySelector('.sgpa-credit') as HTMLSelectElement).value);
                const ia = (row.querySelector('.sgpa-ia') as HTMLInputElement).value;
                const ese = (row.querySelector('.sgpa-ese') as HTMLInputElement).value;
                const gradeBadge = row.querySelector('.grade-badge') as HTMLElement;
                const grade = gradeBadge.dataset.grade;

                if (!isNaN(credit) && grade) {
                    subjects.push({ credit, grade });
                    hasValidInputs = true;
                } else if (ia !== '' || ese !== '') {
                    hasIncompleteRows = true;
                }
            });

            if (hasIncompleteRows) {
                sgpaErrorDisplay.textContent = "Please fill both IA and ESE for entered rows.";
                sgpaValueDisplay.classList.remove('valid');
            } else {
                sgpaErrorDisplay.textContent = "";
            }

            const { sgpa, totalCredits } = calculateSgpa(subjects);

            if (hasValidInputs && totalCredits > 0 && !hasIncompleteRows) {
                sgpaValueDisplay.textContent = sgpa.toFixed(2);
                sgpaCreditsDisplay.textContent = `Total Credits: ${totalCredits}`;
                sgpaValueDisplay.classList.add('valid');
            } else {
                sgpaValueDisplay.textContent = "0.00";
                sgpaCreditsDisplay.textContent = "Total Credits: 0";
                sgpaValueDisplay.classList.remove('valid');
            }
        };

        const attachRowListeners = (row: Element, calcFn: () => void) => {
            row.querySelector('.sgpa-credit')?.addEventListener('change', calcFn);
            row.querySelector('.sgpa-total')?.addEventListener('change', (e) => { validateMarks(row); calcFn(); });
            row.querySelector('.sgpa-ia')?.addEventListener('input', (e) => { validateMarks(row); calcFn(); });
            row.querySelector('.sgpa-ese')?.addEventListener('input', (e) => { validateMarks(row); calcFn(); });
            row.querySelector('.btn-remove')?.addEventListener('click', () => {
                row.remove();
                calcFn();
            });
        };

        const createSgpaRow = () => {
            sgpaRowsCount++;
            const row = document.createElement('div');
            row.className = 'dynamic-row';
            row.innerHTML = `
                <div class="col-name"><input type="text" placeholder="Subject ${sgpaRowsCount}"></div>
                <div class="col-credit"><select class="sgpa-credit">${creditsOptionsHTML}</select></div>
                <div class="col-total"><select class="sgpa-total"><option value="100">100</option><option value="50">50</option></select></div>
                <div class="col-marks marks-group">
                    <input type="number" class="sgpa-ia" placeholder="IA" min="0" max="30">
                    <input type="number" class="sgpa-ese" placeholder="ESE" min="0" max="70">
                    <span class="grade-badge">-</span>
                </div>
                <div class="col-action"><button type="button" class="btn-remove" title="Remove">✕</button></div>
            `;
            attachRowListeners(row, calculateSgpaView);
            return row;
        };

        document.getElementById('add-sgpa-row')?.addEventListener('click', () => {
            sgpaContainer?.appendChild(createSgpaRow());
        });
        document.getElementById('clear-sgpa')?.addEventListener('click', () => {
            if (sgpaContainer) sgpaContainer.innerHTML = '';
            sgpaRowsCount = 0;
            for(let i=0; i<5; i++) sgpaContainer?.appendChild(createSgpaRow());
            calculateSgpaView();
        });

        if (sgpaContainer?.children.length === 0) {
            for(let i=0; i<5; i++) sgpaContainer?.appendChild(createSgpaRow());
        }


        // --- CGPA SEMESTER CALCULATOR ---
        const cgpaSemCardsContainer = document.getElementById('cgpa-sem-cards-container');
        const cgpaSemValueDisplay = document.getElementById('cgpa-sem-value');
        const cgpaSemCreditsDisplay = document.getElementById('cgpa-sem-credits-text');
        const cgpaSemErrorDisplay = document.getElementById('cgpa-sem-error');
        let cgpaSemRowsCount = 0;

        const calculateCgpaSem = () => {
            if (!cgpaSemCardsContainer || !cgpaSemValueDisplay) return;
            let overallPoints = 0, overallCredits = 0, hasIncomplete = false, hasInvalid = false, hasValid = false;

            cgpaSemCardsContainer.querySelectorAll('.semester-card').forEach(card => {
                if (card.getAttribute('data-mode') === 'detailed') {
                    const subjects: { credit: number; grade: string }[] = [];
                    card.querySelectorAll('.dynamic-row').forEach(row => {
                        const credit = parseFloat((row.querySelector('.sgpa-credit') as HTMLSelectElement).value);
                        const grade = (row.querySelector('.grade-badge') as HTMLElement).dataset.grade;
                        const ia = (row.querySelector('.sgpa-ia') as HTMLInputElement).value;
                        const ese = (row.querySelector('.sgpa-ese') as HTMLInputElement).value;

                        if (!isNaN(credit) && grade) {
                            subjects.push({ credit, grade });
                        } else if (ia !== '' || ese !== '') {
                            hasIncomplete = true;
                        }
                    });
                    const { sgpa: subSgpa, totalCredits: subCred } = calculateSgpa(subjects);
                    const subPts = subCred * subSgpa;
                    if (subCred > 0) {
                        overallCredits += subCred;
                        overallPoints += subPts;
                        hasValid = true;
                        card.querySelector('.sem-summary-sgpa')!.textContent = subSgpa.toFixed(2);
                        card.querySelector('.sem-summary-credits')!.textContent = subCred.toString();
                    } else {
                        card.querySelector('.sem-summary-sgpa')!.textContent = "0.00";
                        card.querySelector('.sem-summary-credits')!.textContent = "0";
                    }
                } else {
                    const c = parseFloat((card.querySelector('.cgpa-sem-credit') as HTMLInputElement).value);
                    const s = parseFloat((card.querySelector('.cgpa-sem-sgpa') as HTMLInputElement).value);
                    if (c < 0 || s < 0 || s > 10) hasInvalid = true;
                    if (!isNaN(c) && !isNaN(s) && c >= 0 && s >= 0 && s <= 10) {
                        overallCredits += c; overallPoints += c * s; hasValid = true;
                    } else if (!isNaN(c) || !isNaN(s)) {
                        hasIncomplete = true;
                    }
                }
            });

            if (hasInvalid) { cgpaSemErrorDisplay!.textContent = "Values cannot be negative or SGPA > 10."; cgpaSemValueDisplay.classList.remove('valid'); }
            else if (hasIncomplete) { cgpaSemErrorDisplay!.textContent = "Please fill all active fields."; cgpaSemValueDisplay.classList.remove('valid'); }
            else { cgpaSemErrorDisplay!.textContent = ""; }

            if (hasValid && overallCredits > 0 && !hasInvalid && !hasIncomplete) {
                cgpaSemValueDisplay.textContent = (overallPoints / overallCredits).toFixed(2);
                cgpaSemCreditsDisplay!.textContent = `Total Credits: ${overallCredits}`;
                cgpaSemValueDisplay.classList.add('valid');
            } else {
                cgpaSemValueDisplay.textContent = "0.00";
                cgpaSemCreditsDisplay!.textContent = "Total Credits: 0";
                cgpaSemValueDisplay.classList.remove('valid');
            }
        };

        const createDetailedSubjectRow = () => {
            const row = document.createElement('div');
            row.className = 'dynamic-row';
            row.innerHTML = `
                <div class="col-name"><input type="text" placeholder="Subject"></div>
                <div class="col-credit"><select class="sgpa-credit">${creditsOptionsHTML}</select></div>
                <div class="col-total"><select class="sgpa-total"><option value="100">100</option><option value="50">50</option></select></div>
                <div class="col-marks marks-group">
                    <input type="number" class="sgpa-ia" placeholder="IA">
                    <input type="number" class="sgpa-ese" placeholder="ESE">
                    <span class="grade-badge">-</span>
                </div>
                <div class="col-action"><button type="button" class="btn-remove">✕</button></div>
            `;
            attachRowListeners(row, calculateCgpaSem);
            return row;
        };

        const createCgpaSemCard = () => {
            cgpaSemRowsCount++;
            const card = document.createElement('div');
            card.className = 'semester-card';
            card.setAttribute('data-mode', 'quick');
            card.innerHTML = `
                <div class="semester-card-header">
                    <div class="semester-card-title"><input type="text" value="Semester ${cgpaSemRowsCount}"></div>
                    <div class="sem-toggle-group">
                        <button type="button" class="sem-toggle-btn active" data-target="quick">Quick</button>
                        <button type="button" class="sem-toggle-btn" data-target="detailed">Detailed</button>
                    </div>
                    <button type="button" class="btn-remove btn-remove-sem" style="margin:0; width:30px; height:30px; font-size:14px;">✕</button>
                </div>
                <div class="sem-quick-view active">
                    <div class="sem-quick-grid">
                        <div class="input-group"><label>SGPA</label><input type="number" step="0.01" class="cgpa-sem-sgpa" placeholder="e.g. 8.5"></div>
                        <div class="input-group"><label>Credits</label><input type="number" step="0.5" class="cgpa-sem-credit" placeholder="e.g. 20"></div>
                    </div>
                </div>
                <div class="sem-detailed-view">
                    <div class="detailed-subjects-container"></div>
                    <button type="button" class="outline contrast detailed-add-btn">+ Add Subject</button>
                    <div class="sem-summary-footer">
                        <span>SGPA: <span class="sem-summary-sgpa" style="color:var(--pico-primary)">0.00</span></span>
                        <span>Credits: <span class="sem-summary-credits">0</span></span>
                    </div>
                </div>
            `;

            card.querySelector('.cgpa-sem-credit')?.addEventListener('input', calculateCgpaSem);
            card.querySelector('.cgpa-sem-sgpa')?.addEventListener('input', calculateCgpaSem);

            const detContainer = card.querySelector('.detailed-subjects-container');
            for(let i=0; i<3; i++) detContainer?.appendChild(createDetailedSubjectRow());

            card.querySelector('.detailed-add-btn')?.addEventListener('click', () => { detContainer?.appendChild(createDetailedSubjectRow()); });
            card.querySelector('.btn-remove-sem')?.addEventListener('click', () => { card.remove(); calculateCgpaSem(); });

            const toggles = card.querySelectorAll('.sem-toggle-btn');
            toggles.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const targetBtn = e.target as HTMLButtonElement;
                    const mode = targetBtn.getAttribute('data-target')!;
                    toggles.forEach(b => b.classList.remove('active'));
                    targetBtn.classList.add('active');
                    card.setAttribute('data-mode', mode);
                    
                    card.querySelector('.sem-quick-view')?.classList.toggle('active', mode === 'quick');
                    card.querySelector('.sem-detailed-view')?.classList.toggle('active', mode === 'detailed');
                    calculateCgpaSem();
                });
            });
            return card;
        };

        document.getElementById('add-cgpa-sem-row')?.addEventListener('click', () => cgpaSemCardsContainer?.appendChild(createCgpaSemCard()));
        document.getElementById('clear-cgpa-sem')?.addEventListener('click', () => {
            if (cgpaSemCardsContainer) cgpaSemCardsContainer.innerHTML = '';
            cgpaSemRowsCount = 0;
            for(let i=0; i<2; i++) cgpaSemCardsContainer?.appendChild(createCgpaSemCard());
            calculateCgpaSem();
        });

        if (cgpaSemCardsContainer?.children.length === 0) {
            for(let i=0; i<2; i++) cgpaSemCardsContainer?.appendChild(createCgpaSemCard());
        }

        // --- QUICK CGPA UPDATE ---
        const quickInputs = ['current-cgpa', 'current-credits', 'new-sgpa', 'new-credits'].map(id => document.getElementById(id) as HTMLInputElement);
        const quickVal = document.getElementById('cgpa-quick-value');
        const quickCr = document.getElementById('cgpa-quick-credits-text');
        const quickErr = document.getElementById('cgpa-quick-error');

        const calcQuick = () => {
            const [cgpa, cr, sgpa, ncr] = quickInputs.map(i => parseFloat(i?.value));
            const filled = quickInputs.filter(i => i?.value !== '').length;

            if (filled > 0 && filled < 4) { quickErr!.textContent = "Fill all fields."; quickVal!.classList.remove('valid'); return; }
            if (filled === 4) {
                if (quickInputs.some(i => isNaN(parseFloat(i.value)))) return;
                if (cgpa < 0 || cgpa > 10 || sgpa < 0 || sgpa > 10 || cr < 0 || ncr < 0) {
                    quickErr!.textContent = "Values must be positive, CGPA/SGPA ≤ 10."; quickVal!.classList.remove('valid'); return;
                }
                quickErr!.textContent = "";
                const { cgpa: newCgpa, totalCredits } = calculateQuickCgpa(cgpa, cr, sgpa, ncr);
                
                quickVal!.textContent = totalCredits > 0 ? newCgpa.toFixed(2) : "0.00";
                quickCr!.textContent = `New Total Credits: ${totalCredits}`;
                if(totalCredits > 0) quickVal!.classList.add('valid');
            } else {
                quickErr!.textContent = ""; quickVal!.textContent = "0.00"; quickVal!.classList.remove('valid'); quickCr!.textContent = "Total Credits: 0";
            }
        };
        quickInputs.forEach(i => i?.addEventListener('input', calcQuick));
        document.getElementById('clear-cgpa-quick')?.addEventListener('click', () => { quickInputs.forEach(i => {if(i) i.value=''}); calcQuick(); });


        // --- TARGET CGPA PLANNER ---
        const targetInputs = ['target-curr-cgpa', 'target-prev-credits', 'target-target-cgpa', 'target-sem-credits'].map(id => document.getElementById(id) as HTMLInputElement);
        const targetVal = document.getElementById('target-value');
        const targetSub = document.getElementById('target-subtext');
        const targetErr = document.getElementById('target-error');

        const calcTarget = () => {
            const [curr, pCr, tgt, sCr] = targetInputs.map(i => parseFloat(i?.value));
            const filled = targetInputs.filter(i => i?.value !== '').length;

            if (filled > 0 && filled < 4) { 
                targetErr!.textContent = "Please fill all fields."; 
                targetVal!.classList.remove('valid'); 
                targetVal!.textContent = "0.00"; 
                targetSub!.textContent = "Enter your details to plan your semester.";
                targetSub!.style.color = "var(--pico-color)";
                return; 
            }
            if (filled === 4) {
                if (targetInputs.some(i => isNaN(parseFloat(i.value)))) return;
                if (curr < 0 || curr > 10 || tgt < 0 || tgt > 10 || pCr < 0 || sCr <= 0) {
                    targetErr!.textContent = "Invalid values. Sem Credits must be > 0. CGPAs ≤ 10.";
                    targetVal!.classList.remove('valid');
                    return;
                }
                targetErr!.textContent = "";

                const result = calculateTargetSgpa(curr, pCr, tgt, sCr);

                if (result.type === 'impossible_perfect') {
                    targetVal!.textContent = "N/A";
                    targetVal!.classList.remove('valid');
                    targetSub!.textContent = "A perfect 10 CGPA is mathematically impossible once you have dropped points previously.";
                    targetSub!.style.color = "var(--pico-del-color)";
                } else if (result.type === 'success') {
                    targetVal!.textContent = result.requiredSgpa.toFixed(2);
                    targetVal!.classList.add('valid');
                    targetSub!.textContent = `You need exactly ${result.requiredSgpa.toFixed(2)} SGPA this semester to hit ${tgt} CGPA. You can do it!`;
                    targetSub!.style.color = "var(--pico-primary)";
                } else if (result.type === 'secured') {
                    targetVal!.textContent = "0.00";
                    targetVal!.classList.add('valid');
                    targetSub!.textContent = "You've already secured your target! Even with a 0 SGPA, you stay above it.";
                    targetSub!.style.color = "var(--pico-primary)";
                } else if (result.type === 'impossible_this_sem') {
                    targetVal!.textContent = "> 10";
                    targetVal!.classList.remove('valid');
                    targetSub!.textContent = `It's mathematically not possible this semester. But don't give up! If you score a perfect 10 SGPA for the next ${result.semsNeeded} consecutive semester(s), you will reach your target!`;
                    targetSub!.style.color = "var(--accent-purple)";
                }
            } else {
                targetErr!.textContent = ""; targetVal!.textContent = "0.00"; targetVal!.classList.remove('valid');
                targetSub!.textContent = "Enter your details to plan your semester.";
                targetSub!.style.color = "var(--pico-color)";
            }
        };

        targetInputs.forEach(i => i?.addEventListener('input', calcTarget));
        document.getElementById('clear-target')?.addEventListener('click', () => { targetInputs.forEach(i => {if(i) i.value=''}); calcTarget(); });
    };

    initCalculator();
    document.addEventListener('astro:page-load', initCalculator);
</script>

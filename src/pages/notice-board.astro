---
import Layout from "../layouts/Layout.astro";
import { getNoticeBoard } from "../lib/beuNotices";

// Notices come from BEU at request time. Prerendering this page made every
// build depend on their server being reachable; the snapshot label was also
// stale the moment it shipped.
export const prerender = false;

Astro.response.headers.set(
	"Cache-Control",
	"public, s-maxage=300, stale-while-revalidate=900",
);

const boardNotices = await getNoticeBoard({ important: false, limit: 200 });
const buildTime = new Date().toISOString();
const importantApi = `${import.meta.env.BASE_URL}api/notices/important?limit=10`;
const formatDate = (value: string | null) =>
	value
		? new Date(value).toLocaleDateString("en-GB", {
				year: "numeric",
				month: "short",
				day: "numeric",
			})
		: "Date unavailable";
---

<Layout
	title="Notice board"
	description="Official notices, exam schedules and circulars from Bihar Engineering University."
>
	<header class="page-head">
		<div>
			<h1>Notice board</h1>
			<p class="meta">
				Snapshot {new Date(buildTime).toLocaleDateString("en-IN", {
					day: "numeric",
					month: "short",
					year: "numeric",
				})}
			</p>
		</div>
	</header>

	<section aria-labelledby="important-heading" class="block">
		<h2 id="important-heading">Important</h2>
		<div id="importantNoticeList" class="notice-list" aria-live="polite">
			<p class="empty">Loading important notices…</p>
		</div>
	</section>

	<section aria-labelledby="all-heading" class="block">
		<h2 id="all-heading">All notices</h2>
		<p class="count num" id="all-count">{boardNotices.length} notices</p>
		<div class="table-scroll">
			<table>
				<thead>
					<tr>
						<th scope="col">Date</th>
						<th scope="col">Notice</th>
						<th scope="col"><span class="sr-only">Link</span></th>
					</tr>
				</thead>
				<tbody>
					{
						boardNotices.map((notice) => (
							<tr>
								<td class="num">{formatDate(notice.date)}</td>
								<td>{notice.title}</td>
								<td class="cell-link">
									<a href={notice.link} target="_blank" rel="noopener">
										Open
									</a>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</section>

	<script is:inline define:vars={{ importantApi }}>
		const CACHE_KEY = "beu_important_notice_slider_v1";
		const CACHE_TTL_MS = 3 * 60 * 1000;
		const REFRESH_MS = 60 * 1000;
		const list = document.getElementById("importantNoticeList");

		function normalizeLink(link) {
			if (!link) return "https://beu-bih.ac.in";
			if (link.startsWith("http://") || link.startsWith("https://")) return link;
			const trimmed = link.replace(/^\/+/, "");
			if (trimmed.startsWith("backend/")) return `https://beu-bih.ac.in/${trimmed}`;
			if (trimmed.includes(".pdf")) return `https://beu-bih.ac.in/backend/${trimmed}`;
			return `https://beu-bih.ac.in/${trimmed}`;
		}

		function render(items) {
			if (!list) return;
			if (!items.length) {
				list.innerHTML = '<p class="empty">No important notices right now.</p>';
				return;
			}

			list.innerHTML = items
				.map(
					(item) => `
					<a class="notice-row" href="${normalizeLink(item.link)}" target="_blank" rel="noopener">
						<span>${String(item.board || item.title || "").trim()}</span>
						<span class="row-link">Open</span>
					</a>`,
				)
				.join("");
		}

		function readCache() {
			try {
				const raw = localStorage.getItem(CACHE_KEY);
				if (!raw) return null;
				const parsed = JSON.parse(raw);
				if (!parsed?.ts || !Array.isArray(parsed?.items)) return null;
				if (Date.now() - parsed.ts > CACHE_TTL_MS) return null;
				return parsed.items;
			} catch {
				return null;
			}
		}

		function writeCache(items) {
			try {
				localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), items }));
			} catch {}
		}

		async function refreshImportant() {
			try {
				const response = await fetch(importantApi, { cache: "no-store" });
				if (!response.ok) return;
				const payload = await response.json();
				const items = Array.isArray(payload?.items)
					? payload.items
					: Array.isArray(payload)
						? payload
						: Array.isArray(payload?.data)
							? payload.data
							: [];
				render(items);
				writeCache(items);
			} catch {}
		}

		const cached = readCache();
		if (cached) {
			render(cached);
			setTimeout(refreshImportant, 150);
		} else {
			refreshImportant();
		}

		setInterval(refreshImportant, REFRESH_MS);
	</script>

	<style>
		.block {
			display: grid;
			gap: var(--s3);
			margin-top: var(--s6);
		}

		.block h2 {
			margin: 0;
			font-family: var(--font-sans);
			font-size: 0.75rem;
			font-weight: 650;
			letter-spacing: 0.1em;
			text-transform: uppercase;
			color: var(--faint);
		}

		.count {
			margin: 0;
			color: var(--faint);
			font-size: 0.8rem;
		}

		.notice-list {
			display: grid;
			border-top: 1px solid var(--line-strong);
		}


		:global(.notice-row) {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: var(--s4);
			padding: var(--s3) 0;
			border-bottom: 1px solid var(--line);
			color: var(--paper);
			text-decoration: none;
		}


		@media (hover: hover) and (pointer: fine) {
			:global(.notice-row:hover span:first-child) {
				text-decoration: underline;
				text-underline-offset: 0.18em;
			}
		}

		:global(.notice-row:active span:first-child) {
			text-decoration: underline;
			text-underline-offset: 0.18em;
		}


		:global(.row-link) {
			flex: 0 0 auto;
			color: var(--faint);
			font-size: 0.8rem;
		}


		:global(.empty) {
			margin: 0;
			padding: var(--s4) 0;
			border-bottom: 1px solid var(--line);
			color: var(--faint);
		}

		.table-scroll {
			overflow-x: auto;
			overscroll-behavior-x: contain;
			border-top: 1px solid var(--line-strong);
		}

		table {
			margin: 0;
			width: 100%;
			font-size: 0.9rem;
		}

		th {
			padding: var(--s2) var(--s3) var(--s2) 0;
			background: none;
			border-bottom: 1px solid var(--line);
			color: var(--faint);
			font-size: 0.7rem;
			font-weight: 650;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		td {
			padding: var(--s3) var(--s3) var(--s3) 0;
			border-bottom: 1px solid var(--line);
			vertical-align: baseline;
		}

		td.num {
			white-space: nowrap;
			color: var(--muted);
			font-size: 0.8rem;
			font-variant-numeric: tabular-nums;
		}

		.cell-link {
			text-align: right;
			white-space: nowrap;
		}
	</style>
</Layout>

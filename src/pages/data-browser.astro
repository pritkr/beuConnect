---
import Layout from "../layouts/Layout.astro";
// @ts-ignore - Importing DataBrowser script client-side
import DataBrowserScript from "../components/DataBrowser/DataBrowser.ts?url";

export const prerender = true;
---

<Layout
	title="Student data browser"
	description="Scan BEU semester records, sort by SGPA or CGPA, and open an eight-semester student profile."
	wide={true}
>
	<header class="page-head">
		<div>
			<h1>Student data browser</h1>
					</div>
	</header>

	<section id="data-browser-app" aria-label="Student data browser">
		<!-- The controls render disabled from the first paint instead of being
		     hidden until the manifest arrives. Showing them late grew the page by
		     ~350px after the first frame (CLS 0.67); a disabled row is also the
		     honest state while the data loads. -->
		<form id="dbFilterForm" class="controls" aria-busy="true">
			<div class="filter">
				<label for="dbBatch">Batch</label>
				<select id="dbBatch" name="batch" disabled>
					<option value="">Loading…</option>
				</select>
			</div>

			<div class="filter">
				<label for="dbBranch">Branch</label>
				<select id="dbBranch" name="branch" disabled>
					<option value="">Loading…</option>
				</select>
			</div>

			<div class="filter">
				<label for="dbSemester">Semester</label>
				<select id="dbSemester" name="semester" disabled>
					<option value="">Loading…</option>
				</select>
			</div>

			<div class="filter filter-college">
				<label for="dbCollege">College</label>
				<select id="dbCollege" name="college" disabled>
					<option value="">Loading…</option>
				</select>
			</div>

			<div class="filter">
				<label for="dbSortBy">Sort</label>
				<select id="dbSortBy" disabled>
					<option value="CGPA" selected>CGPA</option>
					<option value="Name">Name</option>
					<option value="RegNo">Reg no.</option>
				</select>
			</div>

			<div class="filter">
				<label for="dbSortDir">Order</label>
				<select id="dbSortDir" disabled>
					<option value="desc">High to low</option>
					<option value="asc">Low to high</option>
				</select>
			</div>

			<div class="filter filter-search">
				<label for="dbSearch">Search</label>
				<input type="search" id="dbSearch" placeholder="Name or reg no." disabled />
			</div>

			<div class="filter filter-export">
				<button type="button" id="dbExportBtn" class="btn btn-ghost" disabled>Export CSV</button>
			</div>
		</form>

		<div id="dbLoading" class="status" aria-busy="true">Loading records…</div>
		<div id="dbError" class="status status-error" role="alert"></div>

		<div
			id="dbTableContainer"
			class="table-container"
			style="display: none; overflow-x: auto; overscroll-behavior-x: contain; position: relative;"
		>
			<table id="dbTable">
				<thead id="dbThead"></thead>
				<tbody id="dbTbody"></tbody>
			</table>
			<div id="dbVirtualPadding" style="display: none; width: 1px; pointer-events: none;"></div>
		</div>

		<div
			id="dbProfileContainer"
			class="profile"
			style="display: none; position: relative;"
		>
			<button type="button" class="btn btn-ghost profile-close" id="dbCloseProfileBtn">Close</button>

			<div class="profile-head">
				<h2 id="pfName">Student name</h2>
				<p id="pfReg" class="mono">Registration number</p>
			</div>

			<dl class="profile-stats">
				<div>
					<dt>CGPA</dt>
					<dd id="pfCgpa" class="num">—</dd>
				</div>
				<div>
					<dt>Rank</dt>
					<dd id="pfRank" class="num">—</dd>
				</div>
				<div class="stat-history">
					<dt>SGPA history</dt>
					<dd id="pfSparkline"></dd>
				</div>
			</dl>

			<details id="pfHistoryDetails" class="history">
				<summary>Eight-semester history</summary>
				<div id="pfHistoryLoading" style="display: none;" aria-busy="true">Loading history…</div>
				<div id="pfHistoryError" class="status-error" style="display: none;" role="alert"></div>
				<div id="pfHistoryContent"></div>
			</details>
		</div>
	</section>
</Layout>

<style>
	.controls {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		align-items: end;
		gap: var(--s2) var(--s3);
		margin: var(--s5) 0 var(--s3);
		padding-bottom: var(--s3);
		border-bottom: 1px solid var(--line);
	}

	/* The virtualised table mounts after the manifest and the CSV arrive. Reserving
	   the first screen means the footer is already below the fold when that
	   happens, so the page never shifts under the reader mid-load. */
	#data-browser-app {
		min-height: calc(100dvh - var(--header-h));
	}

	/* A filter change keeps the old rows on screen, dimmed, until the new ones
	   replace them. */
	#dbTableContainer[data-loading="true"] {
		opacity: 0.45;
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	.filter {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.filter-college {
		grid-column: span 2;
	}

	.filter-search {
		grid-column: span 5;
	}

	.filter-export {
		grid-column: span 2;
		align-self: end;
		justify-self: end;
	}

	.filter label {
		color: var(--faint);
		font-size: 0.65rem;
		font-weight: 650;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.filter select,
	.filter input {
		height: 2.1rem;
		margin: 0;
		padding: 0 0.45rem;
		border-radius: var(--r);
		font-size: 0.8rem;
	}

	.filter-export .btn {
		height: 2.1rem;
		padding: 0 0.75rem;
		font-size: 0.78rem;
	}

	.status {
		margin: var(--s3) 0;
		color: var(--faint);
		font-size: 0.85rem;
	}

	.status-error {
		margin: var(--s3) 0;
		color: var(--bad);
		font-size: 0.85rem;
	}

	.table-container {
		width: 100%;
		border: 1px solid var(--line);
		border-radius: var(--r);
		background: var(--surface);
	}

	:global(#dbTable) {
		width: 100%;
		table-layout: fixed;
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.15;
		/* Sticky cells do not stick in Chrome while the table is `collapse`d. */
		border-collapse: separate;
		border-spacing: 0;
	}

	:global(#dbThead) {
		position: sticky;
		top: 0;
		z-index: 10;
		background: var(--surface-2);
	}

	:global(#dbTbody) {
		position: relative;
	}

	:global(#dbTable th),
	:global(#dbTable td) {
		height: var(--db-row-h, 28px);
		padding: 0.25rem 0.45rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		border-bottom: 1px solid var(--line);
	}

	:global(#dbTable th) {
		background: var(--surface-2);
		color: var(--faint);
		font-size: 0.68rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		cursor: pointer;
		user-select: none;
	}

	:global(#dbTable tbody tr) {
		cursor: pointer;
	}

	@media (hover: hover) and (pointer: fine) {
		:global(#dbTable tbody tr:hover) {
			background: var(--surface-2);
		}
	}

	:global(#dbThead th.sticky-col),
	:global(#dbTbody td.sticky-col) {
		position: sticky;
		left: 0;
		z-index: 2;
		background: var(--surface);
		border-right: 1px solid var(--line);
	}

	:global(#dbThead th.sticky-col) {
		z-index: 11;
		background: var(--surface-2);
	}

	:global(.grade-row-o) td {
		border-left: 2px solid var(--ok);
	}
	:global(.grade-row-f) td {
		border-left: 2px solid var(--bad);
	}
	:global(.grade-row-borderline) td {
		border-left: 2px solid var(--warn);
	}

	@media (max-width: 768px) {
		:global(#dbTable) {
			width: 100% !important;
		}

		:global(#dbTable th[class*="col-"]:not(.col-regno):not(.col-name):not(.col-cgpa)),
		:global(#dbTable td[class*="col-"]:not(.col-regno):not(.col-name):not(.col-cgpa)) {
			display: none;
		}

		:global(#dbTable th.col-regno) {
			width: 108px !important;
		}

		:global(#dbTable .col-name.sticky-col) {
			left: 108px !important;
		}

		:global(#dbTable th.col-name) {
			width: 150px !important;
		}

		:global(#dbTable th.col-cgpa) {
			width: 64px !important;
		}
	}

	.profile {
		margin-top: var(--s4);
		padding: var(--s5);
		border: 1px solid var(--line);
		border-radius: var(--r-lg);
		background: var(--surface);
	}

	.profile-close {
		position: absolute;
		top: var(--s3);
		right: var(--s3);
		padding: 0.25rem 0.6rem;
		font-size: 0.75rem;
	}

	.profile-head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 2rem;
		font-weight: 400;
	}

	.profile-head p {
		margin: 0.15rem 0 0;
		color: var(--faint);
		font-size: 0.8rem;
	}

	.profile-stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		margin: var(--s4) 0 0;
		border-top: 1px solid var(--line-strong);
	}

	.profile-stats > div {
		padding: var(--s3) var(--s3) var(--s3) 0;
		border-bottom: 1px solid var(--line);
	}

	.profile-stats dt {
		color: var(--faint);
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.profile-stats dd {
		margin: 0.2rem 0 0;
		color: var(--paper);
		font-variant-numeric: tabular-nums;
	}

	.profile-stats dd.num {
		font-family: var(--font-display);
		font-size: 1.8rem;
		line-height: 1;
	}

	.stat-history {
		grid-column: span 1;
	}

	.history {
		margin-top: var(--s4);
		border-top: 1px solid var(--line-strong);
		padding-top: var(--s3);
	}

	.history > summary {
		color: var(--muted);
		font-size: 0.85rem;
		cursor: pointer;
	}

	@media (max-width: 760px) {
		.controls {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.filter,
		.filter-college,
		.filter-search,
		.filter-export {
			grid-column: span 1;
		}

		.filter-search,
		.filter-export {
			grid-column: span 2;
			justify-self: stretch;
		}

		.profile-stats {
			grid-template-columns: 1fr;
		}

		.profile {
			padding: var(--s4);
		}
	}
</style>

<script type="module">
	// Load the orchestrator explicitly as a module
	import { initDataBrowser } from "/src/components/DataBrowser/DataBrowser.ts";
	document.addEventListener("DOMContentLoaded", initDataBrowser);
</script>

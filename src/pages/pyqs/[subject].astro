---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/header.astro';
import Footer from '../../components/footer.astro';
import PYQRenderer from '../../components/PYQRenderer.astro';
import { getCanonicalPyqSubject, getPyqSubjectRouteAliases } from '../../utils/pyqSubjects';

export async function getStaticPaths() {
  const allPapers = await getCollection('pyqs');

  const groupedBySlug = allPapers.reduce((acc, paper) => {
    const canonicalSubject = getCanonicalPyqSubject(paper.data.metadata);

    if (!acc[canonicalSubject.slug]) {
      acc[canonicalSubject.slug] = [];
    }

    acc[canonicalSubject.slug].push(paper);
    return acc;
  }, {} as Record<string, any[]>);

  return Object.entries(groupedBySlug).flatMap(([canonicalSlug, papers]) => {
    const sortedPapers = papers.sort((a, b) => b.data.metadata.year - a.data.metadata.year);
    const canonicalSubject = getCanonicalPyqSubject(sortedPapers[0].data.metadata);
    const routeSlugs = new Set<string>([canonicalSlug]);

    sortedPapers.forEach((paper) => {
      getPyqSubjectRouteAliases(paper.data.metadata).forEach((alias) => {
        routeSlugs.add(alias);
      });
    });

    return [...routeSlugs].map((slug) => ({
      params: { subject: slug },
      props: { subjectPapers: sortedPapers, canonicalSubject }
    }));
  });
}

const { subjectPapers, canonicalSubject } = Astro.props;
const firstPaper = subjectPapers[0].data.metadata;
const pageSubject = canonicalSubject ?? getCanonicalPyqSubject(firstPaper);

// Get all unique codes for this subject name
const allCodes = [...new Set(subjectPapers.map(p => p.data.metadata.subject_code))];

// Prepare anchors for sidebar
const navigation = subjectPapers.map(p => {
  const yearPart = p.id.split('/').pop().replace('.json', '');
  const label = `${p.data.metadata.year} ${yearPart.includes('_') ? `(${yearPart.split('_')[1].toUpperCase()})` : ''}`;
  return { id: `paper-${yearPart}`, label };
});

const pageTitle = `${pageSubject.name} | All PYQs | BEUConnect`;
const pageDescription = `Access all Previous Year Questions (PYQs) for ${pageSubject.name} (${allCodes.join(', ')}). Free PDF downloads and solutions for BEU students.`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": pageSubject.name,
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "Bihar Engineering University",
    "sameAs": "https://beu-bih.ac.in/"
  }
};
---

<Layout title={pageTitle} description={pageDescription} structuredData={structuredData} wide={true}>
  <Header />

  <div class="subject-container">
    <aside class="sidebar-nav glass-card" id="desktopSidebar">
      <div class="sidebar-header">
        <h4>{pageSubject.name}</h4>
        <div class="codes-list">
          {allCodes.map(code => (
            <span class="code-badge">{code}</span>
          ))}
        </div>
      </div>
      <nav class="anchor-links">
        {navigation.map(nav => (
          <a href={`#${nav.id}`} class="anchor-link">{nav.label}</a>
        ))}
      </nav>
    </aside>

    <main class="content-area">
      <div class="mobile-jump-wrapper">
        <details class="mobile-jump glass-card">
          <summary>Jump to Year/Set</summary>
          <div class="mobile-links">
            {navigation.map(nav => (
              <a href={`#${nav.id}`} onclick="this.parentElement.parentElement.removeAttribute('open')">{nav.label}</a>
            ))}
          </div>
        </details>
      </div>

      <div class="papers-stack">
        {subjectPapers.map(paper => {
          const yearPart = paper.id.split('/').pop().replace('.json', '');
          const { metadata, instructions, sections } = paper.data;
          
          return (
            <section class="paper-block" id={`paper-${yearPart}`}>
              <div class="paper-header-overlay glass-card">
                <div class="badge-row">
                  <span class="year-badge">{metadata.year}</span>
                  {yearPart.includes('_') && <span class="set-badge">{yearPart.split('_')[1].toUpperCase()}</span>}
                  <span class="code-badge-outline">{metadata.subject_code}</span>
                </div>
                <h2 class="paper-title">{metadata.exam_title}</h2>
                <div class="paper-meta-grid">
                  <div class="meta-item">
                    <span class="label">Time</span>
                    <span class="val">{metadata.time || '3 Hours'}</span>
                  </div>
                  <div class="meta-item">
                    <span class="label">Full Marks</span>
                    <span class="val">{metadata.full_marks || '70'}</span>
                  </div>
                </div>
              </div>

              {instructions && instructions.length > 0 && (
                <div class="instructions-panel glass-card">
                  <h5>Instructions:</h5>
                  <ul>
                    {instructions.map(ins => <li>{ins}</li>)}
                  </ul>
                </div>
              )}

              <div class="questions-wrapper">
                <PYQRenderer sections={sections} subject={metadata.subject} year={metadata.year} />
              </div>
              
              <hr class="paper-divider" />
            </section>
          );
        })}
      </div>
    </main>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.paper-block');
    const navLinks = document.querySelectorAll('.anchor-link, .mobile-links a');
    
    // Setup Intersection Observer
    const observerOptions = {
      root: null,
      rootMargin: '-10% 0px -80% 0px', // Trigger when top of section crosses 10% of viewport
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          
          // Remove active class from all links
          navLinks.forEach(link => link.classList.remove('active'));
          
          // Add active class to corresponding links
          document.querySelectorAll(`.anchor-link[href="#${id}"], .mobile-links a[href="#${id}"]`).forEach(link => {
            link.classList.add('active');
          });
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  });
</script>

<style>
  .subject-container {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    align-items: start;
    max-width: 100%;
    /* No overflow-x: hidden here to allow sticky to work */
  }

  .content-area {
    min-width: 0;
    width: 100%;
    /* We handle internal overflow but keep the container clean for sticky children */
  }

  /* Desktop Sidebar */
  .sidebar-nav {
    position: sticky;
    top: 4.5rem; /* Adjusted for header height */
    max-height: calc(100vh - 5.5rem);
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .sidebar-header {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .sidebar-header h4 {
    margin: 0 0 0.35rem 0;
    font-size: 0.95rem;
    line-height: 1.2;
  }

  .codes-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .code-badge {
    font-size: 0.65rem;
    color: var(--text-muted);
    font-family: monospace;
    background: rgba(255, 255, 255, 0.05);
    padding: 0.1rem 0.25rem;
    border-radius: 3px;
  }

  .anchor-links {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .anchor-link {
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.85rem;
    transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-left: 2px solid transparent;
  }

  .anchor-link:hover, .anchor-link.active {
    background: rgba(59, 130, 246, 0.1);
    color: var(--accent-blue);
    border-left-color: var(--accent-blue);
  }

  /* Mobile Jump Menu Sticky */
  .mobile-jump-wrapper {
    display: none;
    margin-bottom: 1rem;
    position: sticky;
    top: 4rem; /* Should match header height */
    z-index: 100;
    background: var(--bg-body); /* Solid bg to prevent transparency issues when scrolling */
    padding: 0.5rem 0;
  }

  .mobile-jump summary {
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    color: var(--accent-blue);
    border: 1px solid var(--border-accent);
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.8);
    backdrop-filter: blur(8px);
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    padding: 0.4rem;
    gap: 0.2rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    margin-top: 0.25rem;
    max-height: 50vh;
    overflow-y: auto;
  }

  .mobile-links a {
    padding: 0.6rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.3s ease, background-color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  .mobile-links a:hover, .mobile-links a.active {
    background: rgba(59, 130, 246, 0.15);
    color: var(--accent-blue);
    font-weight: 600;
  }

  /* Main Content Area */
  .papers-stack {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  
  .paper-block {
    margin-bottom: 0;
    scroll-margin-top: 5rem;
  }

  .paper-header-overlay {
    padding: 1.25rem;
    text-align: center;
    margin-bottom: 1rem;
    border-top: 3px solid var(--accent-blue);
  }

  .badge-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .year-badge {
    background: var(--accent-blue);
    color: white;
    padding: 0.1rem 0.5rem;
    border-radius: 12px;
    font-weight: 800;
    font-size: 0.75rem;
  }

  .set-badge {
    background: var(--accent-purple);
    color: white;
    padding: 0.1rem 0.5rem;
    border-radius: 12px;
    font-weight: 800;
    font-size: 0.75rem;
  }

  .code-badge-outline {
    font-size: 0.7rem;
    font-family: monospace;
    border: 1px solid var(--border-subtle);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: var(--text-muted);
  }

  .paper-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .paper-meta-grid {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .meta-item .label {
    font-size: 0.65rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .meta-item .val {
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--text-primary);
  }

  .instructions-panel {
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
    border-left: 2px solid var(--text-muted);
  }

  .instructions-panel h5 { margin-bottom: 0.35rem; font-size: 0.85rem; color: var(--text-secondary); }
  .instructions-panel ul { margin: 0; padding-left: 1rem; }
  .instructions-panel li { font-size: 0.8rem; margin-bottom: 0.2rem; color: var(--text-muted); }

  .paper-divider {
    margin-top: 2rem;
    border: 0;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--border-accent), transparent);
  }

  @media (max-width: 900px) {
    .subject-container { grid-template-columns: 1fr; gap: 1rem; }
    #desktopSidebar { display: none; }
    .mobile-jump-wrapper { display: block; }
    .paper-block { margin-bottom: 2.5rem; }
  }
</style>

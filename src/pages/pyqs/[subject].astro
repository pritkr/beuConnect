---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PYQRenderer from '../../components/PYQRenderer.astro';
import { getCanonicalPyqSubject, getPyqSubjectRouteAliases } from '../../utils/pyqSubjects';

export async function getStaticPaths() {
  const allPapers = await getCollection('pyqs');

  const groupedBySlug = allPapers.reduce((acc, paper) => {
    const canonicalSubject = getCanonicalPyqSubject(paper.data.metadata);

    if (!acc[canonicalSubject.slug]) {
      acc[canonicalSubject.slug] = [];
    }

    acc[canonicalSubject.slug].push(paper);
    return acc;
  }, {} as Record<string, any[]>);

  return Object.entries(groupedBySlug).flatMap(([canonicalSlug, papers]) => {
    const sortedPapers = papers.sort((a, b) => {
      const byYear = b.data.metadata.year - a.data.metadata.year;
      if (byYear !== 0) return byYear;
      return String(a.data.metadata.subject_code).localeCompare(String(b.data.metadata.subject_code));
    });
    const canonicalSubject = getCanonicalPyqSubject(sortedPapers[0].data.metadata);
    const routeSlugs = new Set<string>([canonicalSlug]);

    sortedPapers.forEach((paper) => {
      getPyqSubjectRouteAliases(paper.data.metadata).forEach((alias) => {
        routeSlugs.add(alias);
      });
    });

    return [...routeSlugs].map((slug) => ({
      params: { subject: slug },
      props: { subjectPapers: sortedPapers, canonicalSubject }
    }));
  });
}

const { subjectPapers, canonicalSubject } = Astro.props;
const firstPaper = subjectPapers[0].data.metadata;
const pageSubject = canonicalSubject ?? getCanonicalPyqSubject(firstPaper);

// Get all unique codes for this subject name
const allCodes = [...new Set(subjectPapers.map(p => p.data.metadata.subject_code))];

// Prepare anchors for sidebar. Each paper needs its own id: a year repeats
// across subject codes, so the folder is part of the anchor.
const anchorFor = (id: string) => `paper-${id.replace(/[^a-zA-Z0-9]+/g, "-")}`;

const navigation = subjectPapers.map(p => {
  const yearPart = p.id.split('/').pop().replace('.json', '');
  const set = yearPart.includes('_') ? yearPart.split('_')[1].toUpperCase() : "";
  const label = [p.data.metadata.year, set, p.data.metadata.subject_code]
    .filter(Boolean)
    .join(" ");
  return { id: anchorFor(p.id), label };
});

const pageTitle = `${pageSubject.name} | All PYQs | BEUConnect`;
const pageDescription = `Access all Previous Year Questions (PYQs) for ${pageSubject.name} (${allCodes.join(', ')}). Free PDF downloads and solutions for BEU students.`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": pageSubject.name,
  "description": pageDescription,
  "provider": {
    "@type": "Organization",
    "name": "Bihar Engineering University",
    "sameAs": "https://beu-bih.ac.in/"
  }
};
---

<Layout title={pageTitle} description={pageDescription} structuredData={structuredData} wide={true}>
  <header class="page-head">
    <div>
      <p class="back"><a href={`${import.meta.env.BASE_URL}pyqs/`}>PYQs</a></p>
      <h1>{pageSubject.name}</h1>
      <p class="meta num">{subjectPapers.length} papers · {allCodes.join(", ")}</p>
    </div>
  </header>

  <div class="subject-container">
    <aside class="sidebar" id="desktopSidebar" aria-label="Papers">
      <nav class="anchor-links">
        {navigation.map(nav => (
          <a href={`#${nav.id}`} class="anchor-link">{nav.label}</a>
        ))}
      </nav>
    </aside>

    <div class="content-area">
      <div class="mobile-jump-wrapper">
        <details class="mobile-jump">
          <summary>Jump to paper</summary>
          <div class="mobile-links">
            {navigation.map(nav => (
              <a href={`#${nav.id}`} onclick="this.parentElement.parentElement.removeAttribute('open')">{nav.label}</a>
            ))}
          </div>
        </details>
      </div>

      <div class="papers-stack">
        {subjectPapers.map(paper => {
          const yearPart = paper.id.split('/').pop().replace('.json', '');
          const { metadata, instructions, sections } = paper.data;

          return (
            <section class="paper-block" id={anchorFor(paper.id)}>
              <header class="paper-head">
                <p class="paper-label">
                  <span class="year num">{metadata.year}</span>
                  {yearPart.includes('_') && <span>{yearPart.split('_')[1].toUpperCase()}</span>}
                  <span class="mono">{metadata.subject_code}</span>
                </p>
                <h2 class="paper-title">{metadata.exam_title}</h2>
                <p class="paper-meta num">
                  <span>{metadata.time || "3 hours"}</span>
                  <span>{metadata.full_marks || "70"} marks</span>
                </p>
              </header>

              {instructions && instructions.length > 0 && (
                <div class="instructions">
                  <h3>Instructions</h3>
                  <ul>
                    {instructions.map(ins => <li>{ins}</li>)}
                  </ul>
                </div>
              )}

              <div class="questions-wrapper">
                <PYQRenderer sections={sections} subject={metadata.subject} year={metadata.year} />
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('.paper-block');
    const navLinks = document.querySelectorAll('.anchor-link, .mobile-links a');
    
    // Setup Intersection Observer
    const observerOptions = {
      root: null,
      rootMargin: '-10% 0px -80% 0px', // Trigger when top of section crosses 10% of viewport
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          
          // Remove active class from all links
          navLinks.forEach(link => link.classList.remove('active'));
          
          // Add active class to corresponding links
          document.querySelectorAll(`.anchor-link[href="#${id}"], .mobile-links a[href="#${id}"]`).forEach(link => {
            link.classList.add('active');
          });
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  });
</script>

<style>
  .back {
    margin: 0 0 var(--s2);
    font-size: 0.78rem;
  }

  .back a {
    color: var(--faint);
    text-decoration: none;
  }

  .back a:hover {
    color: var(--paper);
  }

  .subject-container {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s6);
    align-items: start;
    margin-top: var(--s5);
  }

  .sidebar {
    position: sticky;
    top: 4.5rem;
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
    padding-top: var(--s2);
  }

  .anchor-links {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }

  .anchor-link {
    padding: 0.3rem 0 0.3rem var(--s3);
    border-left: 2px solid transparent;
    margin-left: -1px;
    color: var(--faint);
    font-size: 0.8rem;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .anchor-link:hover,
  .anchor-link.active {
    border-left-color: var(--accent);
    color: var(--paper);
  }

  .content-area {
    min-width: 0;
  }

  .mobile-jump-wrapper {
    display: none;
    position: sticky;
    top: 3.6rem;
    z-index: 50;
    padding: var(--s2) 0;
    margin-bottom: var(--s3);
    background: var(--bg);
  }

  .mobile-jump summary {
    padding: var(--s2) var(--s3);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.82rem;
    cursor: pointer;
  }

  .mobile-links {
    display: flex;
    flex-direction: column;
    margin-top: var(--s2);
    padding: var(--s2);
    max-height: 50vh;
    overflow-y: auto;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--surface);
  }

  .mobile-links a {
    padding: 0.5rem;
    color: var(--muted);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .mobile-links a:hover,
  .mobile-links a.active {
    color: var(--paper);
  }

  .papers-stack {
    display: grid;
    gap: var(--s8);
  }

  .paper-block {
    scroll-margin-top: 5rem;
  }

  .paper-head {
    display: grid;
    gap: var(--s2);
    padding-bottom: var(--s3);
    border-bottom: 1px solid var(--line-strong);
  }

  .paper-label {
    display: flex;
    align-items: baseline;
    gap: var(--s3);
    margin: 0;
    color: var(--faint);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .paper-label .year {
    color: var(--accent);
    font-size: 0.8rem;
  }

  .paper-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
  }

  .paper-meta {
    display: flex;
    gap: var(--s4);
    margin: 0;
    color: var(--faint);
    font-size: 0.78rem;
  }

  .instructions {
    margin-top: var(--s4);
    padding-left: var(--s3);
    border-left: 2px solid var(--line-strong);
  }

  .instructions h3 {
    margin: 0 0 var(--s2);
    color: var(--faint);
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .instructions ul {
    margin: 0;
    padding-left: 1rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .instructions li {
    margin-bottom: 0.2rem;
  }

  .questions-wrapper {
    margin-top: var(--s4);
  }

  @media (max-width: 900px) {
    .subject-container {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }

    #desktopSidebar {
      display: none;
    }

    .mobile-jump-wrapper {
      display: block;
    }
  }
</style>

---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getCanonicalPyqSubject } from '../../utils/pyqSubjects';

const allPapers = await getCollection('pyqs');

// Helper to determine Academic Year from semester or subject code
function getAcademicYear(paper: any) {
  const sem = paper.data.metadata.semester;
  const code = paper.data.metadata.subject_code;
  
  if (sem) {
    if (sem <= 2) return "First Year (Sem 1 & 2)";
    if (sem <= 4) return "Second Year (Sem 3 & 4)";
    if (sem <= 6) return "Third Year (Sem 5 & 6)";
    return "Fourth Year (Sem 7 & 8)";
  }
  
  // Fallback heuristic based on subject code (often 3rd digit is semester in older codes)
  if (code && code.length >= 4) {
    const semDigit = parseInt(code[2]);
    if (!isNaN(semDigit) && semDigit > 0 && semDigit <= 8) {
      if (semDigit <= 2) return "First Year (Sem 1 & 2)";
      if (semDigit <= 4) return "Second Year (Sem 3 & 4)";
      if (semDigit <= 6) return "Third Year (Sem 5 & 6)";
      return "Fourth Year (Sem 7 & 8)";
    }
  }
  
  return "General / Unspecified";
}

// Group papers by canonical subject name and then by Academic Year
const subjectGroups = allPapers.reduce((acc, paper) => {
  const canonicalSubject = getCanonicalPyqSubject(paper.data.metadata);
  const subjectCode = paper.data.metadata.subject_code;
  const acYear = getAcademicYear(paper);
  
  if (!acc[acYear]) {
    acc[acYear] = {};
  }
  
  // Use slug as key to group by name
  if (!acc[acYear][canonicalSubject.slug]) {
    acc[acYear][canonicalSubject.slug] = {
      name: canonicalSubject.name,
      slug: canonicalSubject.slug,
      codes: new Set(),
      years: new Set(),
      count: 0
    };
  }
  acc[acYear][canonicalSubject.slug].codes.add(subjectCode);
  acc[acYear][canonicalSubject.slug].years.add(paper.data.metadata.year);
  acc[acYear][canonicalSubject.slug].count += 1;
  return acc;
}, {} as Record<string, any>);

const academicYears = [
  "First Year (Sem 1 & 2)",
  "Second Year (Sem 3 & 4)",
  "Third Year (Sem 5 & 6)",
  "Fourth Year (Sem 7 & 8)",
  "General / Unspecified",
].filter((label) => Boolean(subjectGroups[label]));

const yearLabels: Record<string, string> = {
  "First Year (Sem 1 & 2)": "First",
  "Second Year (Sem 3 & 4)": "Second",
  "Third Year (Sem 5 & 6)": "Third",
  "Fourth Year (Sem 7 & 8)": "Fourth",
  "General / Unspecified": "General",
};
---

<Layout
  title="Previous-year papers"
  description="1,069 previous-year question papers for Bihar Engineering University, grouped by subject and year."
>
  <header class="page-head">
    <div>
      <h1>Previous-year papers</h1>
      <p class="meta num">{allPapers.length.toLocaleString("en-IN")} papers</p>
    </div>
  </header>

  <div class="toolbar">
    <div class="field">
      <label class="field-label" for="subjectSearch">Search</label>
      <input type="search" id="subjectSearch" placeholder="Subject name or code" />
    </div>

    <div class="field">
      <span class="field-label" id="year-label">Year</span>
      <div class="segmented" role="group" aria-labelledby="year-label">
        <button type="button" class="filter-btn" data-year="all" aria-pressed="true">All</button>
        {academicYears.map((year) => (
          <button
            type="button"
            class="filter-btn"
            data-year={year}
            aria-pressed="false"
          >
            {yearLabels[year]}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="subjects">
    {academicYears.map((acYear) => {
      const subjects = Object.values(subjectGroups[acYear]).sort((a: any, b: any) => a.name.localeCompare(b.name));
      return (
        <section class="ac-year-section" data-group={acYear}>
          <h2 class="ac-year-title">{acYear}</h2>
          <div class="subjects-grid">
            {subjects.map((subject: any) => (
              <a
                href={`${import.meta.env.BASE_URL}pyqs/${subject.slug}`}
                class="subject-card"
                data-name={subject.name.toLowerCase()}
                data-codes={Array.from(subject.codes).join(',')}
                data-ga="pyq_subject_open"
                data-ga-params={JSON.stringify({ subject: subject.slug, year: yearLabels[acYear], papers: subject.count })}
              >
                <h3>{subject.name}</h3>
                <p class="subject-meta">
                  <span class="mono">{Array.from(subject.codes).join(" · ")}</span>
                  <span class="num">{subject.count === 1 ? "1 paper" : `${subject.count} papers`}</span>
                </p>
                <p class="subject-years mono">
                  {Array.from(subject.years).sort((a:any, b:any) => b - a).join(" · ")}
                </p>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <p id="pyq-empty" class="state state-empty" hidden>No subject matches that search.</p>
</Layout>

<script>
  import { EVENTS, track } from "../../lib/analytics";

  const searchInput = document.getElementById("subjectSearch") as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const sections = Array.from(document.querySelectorAll<HTMLElement>(".ac-year-section"));
  const empty = document.getElementById("pyq-empty");

  let currentFilter = "all";
  let searchTerm = "";

  function applyFilters() {
    let visibleSections = 0;

    for (const section of sections) {
      const inGroup = currentFilter === "all" || section.dataset.group === currentFilter;
      let visibleInSection = false;

      for (const card of Array.from(section.querySelectorAll<HTMLElement>(".subject-card"))) {
        const name = card.dataset.name || "";
        const codes = card.dataset.codes || "";
        const matches = !searchTerm || name.includes(searchTerm) || codes.includes(searchTerm);
        const show = inGroup && matches;
        card.hidden = !show;
        if (show) visibleInSection = true;
      }

      section.hidden = !visibleInSection;
      if (visibleInSection) visibleSections += 1;
    }

    if (empty) empty.hidden = visibleSections > 0;
  }

  let searchTimer: ReturnType<typeof setTimeout> | undefined;

  searchInput?.addEventListener("input", () => {
    searchTerm = searchInput.value.trim().toLowerCase();
    applyFilters();
    // The term itself never leaves the browser — a student typing a subject
    // code is harmless, but the same field could hold a name. Length and the
    // answer are what tell us whether search works.
    if (searchTimer) clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      const visible = document.querySelectorAll<HTMLElement>(".subject-card:not([hidden])").length;
      track(EVENTS.searchQuery, {
        feature: "pyqs",
        query_length: searchTerm.length,
        results_count: visible,
        has_results: visible > 0,
      });
    }, 600);
  });

  for (const btn of Array.from(filterBtns)) {
    btn.addEventListener("click", () => {
      currentFilter = btn.dataset.year || "all";
      for (const other of Array.from(filterBtns)) {
        other.setAttribute("aria-pressed", String(other === btn));
      }
      applyFilters();
      track(EVENTS.pyqSelect, { year: yearLabels[currentFilter] ?? "all" });
    });
  }
</script>

<style>
  .toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: var(--s4);
    margin-bottom: var(--s5);
    padding-bottom: var(--s4);
    border-bottom: 1px solid var(--line);
  }

  .toolbar input {
    max-width: 26rem;
  }

  .filter-btn {
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    min-height: 2.5rem;
    padding: 0.35rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .filter-btn + .filter-btn {
    border-left: 1px solid var(--line);
  }

  .filter-btn[aria-pressed="true"] {
    background: var(--surface-2);
    color: var(--paper);
  }

  .subjects {
    display: grid;
    gap: var(--s6);
  }

  .ac-year-title {
    margin-bottom: var(--s3);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .subjects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s3);
  }

  .subject-card {
    display: grid;
    gap: 0.3rem;
    padding: var(--s3) var(--s4);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--paper);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .subject-card:hover {
      border-color: var(--line-strong);
      background: var(--surface-2);
      color: var(--paper);
    }
  }

  .subject-card:active {
    border-color: var(--line-strong);
    background: var(--surface-2);
    color: var(--paper);
  }

  .subject-card h3 {
    font-size: 0.92rem;
  }

  .subject-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem var(--s3);
    margin: 0;
    color: var(--faint);
    font-size: 0.72rem;
  }

  .subject-years {
    margin: 0;
    color: var(--line-strong);
    font-size: 0.7rem;
  }

  @media (max-width: 860px) {
    .toolbar {
      grid-template-columns: 1fr;
    }

    .subjects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

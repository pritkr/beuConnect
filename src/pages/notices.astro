---
import Layout from "../layouts/Layout.astro";
import NotificationOptIn from "../components/NotificationOptIn.astro";
import { getNoticeBoard } from "../lib/beuNotices";

export const prerender = false;

Astro.response.headers.set("Cache-Control", "public, s-maxage=300, stale-while-revalidate=900");

const boardItems = await getNoticeBoard({ limit: 200 });
const now = Date.now();
const notices = boardItems.map((item) => {
	const ageHours = item.date
		? Math.max(0, (now - new Date(item.date).getTime()) / 3_600_000)
		: null;

	return {
		id: item.id,
		title: item.title,
		category: item.isImportant ? "Important" : "General",
		date: item.date,
		link: item.link,
		source: "BEU Notice",
		isImportant: item.isImportant,
		isRecent: ageHours !== null && ageHours <= 3,
		ageHours: ageHours === null ? null : Number(ageHours.toFixed(2)),
	};
});

const sortedNotices = notices.toSorted(
	(a, b) => new Date(b.date ?? 0).getTime() - new Date(a.date ?? 0).getTime(),
);

const SEMESTER_ORDINALS = ["1st", "2nd", "3rd", "4th", "5th", "6th", "7th", "8th"] as const;

function detectCourse(title: string): string {
	const text = title.toLowerCase();
	if (/\bb\.?\s*tech\b/.test(text)) return "B.Tech";
	if (/\bb\.?\s*arch\b/.test(text)) return "B.Arch";
	if (/\bm\.?\s*tech\b/.test(text)) return "M.Tech";
	return "Other";
}

function detectSemester(title: string): string {
	const text = title.toLowerCase();
	for (let i = 0; i < SEMESTER_ORDINALS.length; i += 1) {
		const ord = SEMESTER_ORDINALS[i].toLowerCase();
		const semNumber = i + 1;
		const ordinalMatch = new RegExp(`\\b${ord}\\s*sem(?:ester)?\\b`);
		const forwardMatch = new RegExp(`\\bsem(?:ester)?\\s*[-:]?\\s*${ord}\\b`);
		const numericMatch = new RegExp(`\\bsem(?:ester)?\\s*[-:]?\\s*${semNumber}\\b`);
		if (ordinalMatch.test(text) || forwardMatch.test(text) || numericMatch.test(text)) {
			return SEMESTER_ORDINALS[i];
		}
	}
	return "Other";
}

const noticeFilters = sortedNotices.map((notice) => ({
	id: notice.id,
	course: detectCourse(notice.title),
	semester: detectSemester(notice.title),
}));
const filterById = new Map(noticeFilters.map((item) => [item.id, item]));
const categories = ["All", ...new Set(sortedNotices.map((notice) => notice.category))];
const courses = ["All", ...new Set(noticeFilters.map((item) => item.course))];
const semesters = ["All", ...new Set(noticeFilters.map((item) => item.semester))];
const baseUrl = import.meta.env.BASE_URL;
const resolveNoticeLink = (link: string) =>
	link.startsWith("http") ? link : `${baseUrl}${link.replace(/^\/+/, "")}`;
---

<Layout
	title="BEU notices"
	description="Notices published by Bihar Engineering University, with search and filters for course, category and semester."
>
	<header class="page-head">
		<div>
			<h1>Notices</h1>
		</div>
	</header>

	<NotificationOptIn />

	<form class="filters" onsubmit="return false">
		<div class="field">
			<label class="field-label" for="noticeSearch">Search</label>
			<input id="noticeSearch" type="search" placeholder="Keyword in title" />
		</div>
		<div class="field">
			<label class="field-label" for="noticeCategory">Category</label>
			<select id="noticeCategory">
				{categories.map((category) => <option value={category}>{category}</option>)}
			</select>
		</div>
		<div class="field">
			<label class="field-label" for="noticeCourse">Course</label>
			<select id="noticeCourse">
				{courses.map((course) => <option value={course}>{course}</option>)}
			</select>
		</div>
		<div class="field">
			<label class="field-label" for="noticeSemester">Semester</label>
			<select id="noticeSemester">
				{semesters.map((semester) => <option value={semester}>{semester}</option>)}
			</select>
		</div>
	</form>

	<p id="noticeCount" class="count-text" role="status"></p>

	<ul id="noticeGrid" class="notice-list">
		{
			sortedNotices.map((notice) => {
				const meta = filterById.get(notice.id);
				return (
					<li
						class="notice-card"
						data-title={notice.title.toLowerCase()}
						data-category={notice.category}
						data-course={meta?.course ?? "Other"}
						data-semester={meta?.semester ?? "Other"}
					>
						<time datetime={notice.date ?? undefined}>
							{notice.date
								? new Date(notice.date).toLocaleDateString("en-GB", {
										year: "numeric",
										month: "short",
										day: "numeric",
									})
								: "Undated"}
						</time>

						<div class="notice-body">
							<h2>
								<a href={resolveNoticeLink(notice.link)} target="_blank" rel="noopener">
									{notice.title}
								</a>
							</h2>
							<p class="notice-meta">
								{notice.isImportant && <span class="important">Important</span>}
								<span>{meta?.course ?? "Other"}</span>
								<span>Sem {meta?.semester ?? "Other"}</span>
							</p>
						</div>
					</li>
				);
			})
		}
	</ul>

	<p id="noticeEmpty" class="state state-empty" hidden>No notice matches these filters.</p>
</Layout>

	<script>
		import { EVENTS, track } from "../lib/analytics";

		const searchInput = document.getElementById("noticeSearch") as HTMLInputElement;
		const categorySelect = document.getElementById("noticeCategory") as HTMLSelectElement;
		const courseSelect = document.getElementById("noticeCourse") as HTMLSelectElement;
		const semesterSelect = document.getElementById("noticeSemester") as HTMLSelectElement;
		const noticeGrid = document.getElementById("noticeGrid") as HTMLDivElement;
		const noticeCount = document.getElementById("noticeCount") as HTMLParagraphElement;
		const noticeEmpty = document.getElementById("noticeEmpty");
		const noticeCards = Array.from(noticeGrid.querySelectorAll<HTMLElement>(".notice-card"));

		function applyFilters() {
			const search = searchInput.value.trim().toLowerCase();
			const selectedCategory = categorySelect.value;
			const selectedCourse = courseSelect.value;
			const selectedSemester = semesterSelect.value;
			let visibleCount = 0;

			noticeCards.forEach((card) => {
				const cardTitle = card.dataset.title || "";
				const cardCategory = card.dataset.category || "";
				const cardCourse = card.dataset.course || "";
				const cardSemester = card.dataset.semester || "";
				const categoryMatch = selectedCategory === "All" || cardCategory === selectedCategory;
				const courseMatch = selectedCourse === "All" || cardCourse === selectedCourse;
				const semesterMatch = selectedSemester === "All" || cardSemester === selectedSemester;
				const titleMatch = !search || cardTitle.includes(search);
				const isVisible = categoryMatch && courseMatch && semesterMatch && titleMatch;
				card.hidden = !isVisible;
				if (isVisible) visibleCount += 1;
			});

			noticeCount.textContent = `${visibleCount} of ${noticeCards.length} notices`;
			if (noticeEmpty) noticeEmpty.hidden = visibleCount > 0;
		}

		let noticeSearchTimer: ReturnType<typeof setTimeout> | undefined;
		searchInput.addEventListener("input", () => {
			applyFilters();
			if (noticeSearchTimer) clearTimeout(noticeSearchTimer);
			noticeSearchTimer = setTimeout(() => {
				track(EVENTS.noticesSearch, { query_length: searchInput.value.trim().length });
			}, 600);
		});
		categorySelect.addEventListener("change", () => {
			applyFilters();
			track(EVENTS.noticesSearch, { filter: "category", value: categorySelect.value });
		});
		courseSelect.addEventListener("change", () => {
			applyFilters();
			track(EVENTS.noticesSearch, { filter: "course", value: courseSelect.value });
		});
		semesterSelect.addEventListener("change", () => {
			applyFilters();
			track(EVENTS.noticesSearch, { filter: "semester", value: semesterSelect.value });
		});
		applyFilters();
	</script>

	<style>
		.filters {
			display: grid;
			grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
			align-items: end;
			gap: var(--s3);
			margin: 0 0 var(--s3);
			padding: var(--s4);
			border: 1px solid var(--line);
			border-radius: var(--r-lg);
			background: var(--surface);
		}

		.count-text {
			margin: 0 0 var(--s3);
			color: var(--faint);
			font-size: 0.75rem;
			font-variant-numeric: tabular-nums;
		}

		.notice-list {
			margin: 0;
			padding: 0;
			list-style: none;
			border-top: 1px solid var(--line-strong);
		}

		.notice-card {
			display: grid;
			grid-template-columns: 8rem minmax(0, 1fr);
			gap: var(--s4);
			padding: var(--s4) 0;
			border-bottom: 1px solid var(--line);
		}

		.notice-card time {
			color: var(--faint);
			font-family: var(--font-mono);
			font-size: 0.72rem;
			font-variant-numeric: tabular-nums;
			padding-top: 0.2rem;
		}

		.notice-body h2 {
			font-family: var(--font-sans);
			font-size: 0.95rem;
			font-weight: 500;
			line-height: 1.45;
		}

		.notice-body h2 a {
			color: var(--paper);
			text-decoration: none;
		}

		@media (hover: hover) and (pointer: fine) {
			.notice-body h2 a:hover {
				color: var(--accent);
				text-decoration: underline;
				text-underline-offset: 0.16em;
			}
		}

		.notice-body h2 a:active {
			color: var(--accent);
			text-decoration: underline;
			text-underline-offset: 0.16em;
		}

		.notice-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.2rem var(--s3);
			margin: 0.3rem 0 0;
			color: var(--faint);
			font-size: 0.72rem;
		}

		.notice-meta .important {
			color: var(--accent);
			font-weight: 650;
		}

		@media (max-width: 900px) {
			.filters {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}

		@media (max-width: 560px) {
			.filters {
				grid-template-columns: 1fr;
			}

			.notice-card {
				grid-template-columns: 1fr;
				gap: 0.35rem;
			}
		}
	</style>


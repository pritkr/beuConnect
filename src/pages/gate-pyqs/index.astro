---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import pyqData from "../../data/gate-pyqs.json";
import {
  gatePyqSubjectOrder,
  getGatePyqSubjectName,
} from "../../data/gate-pyq-subjects";

const base = import.meta.env.BASE_URL;
const orderIndex = new Map(gatePyqSubjectOrder.map((code, idx) => [code, idx]));

const subjects = Object.entries(pyqData)
  .map(([code, papers]) => ({
    code,
    name: getGatePyqSubjectName(code),
    paperCount: papers.length,
  }))
  .sort((a, b) => {
    const ai = orderIndex.get(a.code);
    const bi = orderIndex.get(b.code);
    if (ai !== undefined && bi !== undefined) return ai - bi;
    if (ai !== undefined) return -1;
    if (bi !== undefined) return 1;
    return a.code.localeCompare(b.code);
  });

const paperCount = subjects.reduce((total, subject) => total + subject.paperCount, 0);
---

<Layout
  title="GATE previous year papers"
  description="Subject-wise GATE previous year question papers."
>
  <header class="page-head">
    <div>
      <h1>GATE PYQs</h1>
      <p class="meta num">{paperCount} papers · {subjects.length} subjects</p>
    </div>
  </header>

  <div class="subject-grid" aria-label="GATE subjects">
    {subjects.map((subject) => (
      <a href={`${base}gate-pyqs/${subject.code}`} class="subject-card">
        <span class="subject-code num">{subject.code}</span>
        <span class="subject-name">{subject.name}</span>
        <span class="subject-count num">{subject.paperCount}</span>
      </a>
    ))}
  </div>
</Layout>

<style>
  .subject-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 0;
    margin-top: var(--s5);
    border-top: 1px solid var(--line-strong);
  }

  .subject-card {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--s3);
    padding: var(--s4) var(--s3) var(--s4) 0;
    border-bottom: 1px solid var(--line);
    color: var(--paper);
    text-decoration: none;
  }

  .subject-card:hover .subject-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .subject-code {
    color: var(--faint);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
  }

  .subject-name {
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .subject-count {
    color: var(--faint);
    font-size: 0.75rem;
  }
</style>

---
export const prerender = true;
import Layout from '../../../layouts/Layout.astro';
import BranchIcon from '../../../components/BranchIcon.astro';
import Icon from '../../../components/Icon.astro';
import pyqData from '../../../data/gate-pyqs.json';
import {
  gatePyqSubjectOrder,
  getGatePyqSubjectName,
} from '../../../data/gate-pyq-subjects';

export function getStaticPaths() {
  const orderIndex = new Map(gatePyqSubjectOrder.map((code, idx) => [code, idx]));
  const subjectCodes = Object.keys(pyqData).sort((a, b) => {
    const ai = orderIndex.get(a);
    const bi = orderIndex.get(b);
    if (ai !== undefined && bi !== undefined) return ai - bi;
    if (ai !== undefined) return -1;
    if (bi !== undefined) return 1;
    return a.localeCompare(b);
  });

  return subjectCodes.map((subjectCode) => ({
    params: { branch: subjectCode },
    props: {
      branchName: getGatePyqSubjectName(subjectCode),
      papers: pyqData[subjectCode as keyof typeof pyqData] || [],
    },
  }));
}

const { branchName, papers } = Astro.props;
const branchCode = Astro.params.branch ?? '';
const base = import.meta.env.BASE_URL;
---

<Layout title={`${branchName} GATE papers`} description={`GATE previous year question papers for ${branchName}.`} wide={true}>
  <header class="page-head">
    <div>
      <p class="back"><a href={`${base}gate-pyqs`}>GATE PYQs</a></p>
      <h1><BranchIcon branch={branchCode} size="0.7em" />{branchName}</h1>
      <p class="meta num">{papers.length} papers</p>
    </div>
  </header>

  <div class="pyq-wrapper">
    <aside class="sidebar" id="sidebar" aria-label="Papers">
      <div class="papers-grid">
        {papers.map((paper: any) => (
          <button
            type="button"
            class="paper-btn"
            data-pdf={`${base}${String(paper.path).replace(/^\/+/, "")}`}
            data-title={`${paper.year} ${paper.set ? `(Set ${paper.set})` : ''}`}
          >
            {paper.year}
            {paper.set && <span class="paper-set">S{paper.set}</span>}
          </button>
        ))}
        {papers.length === 0 && (
          <p class="no-data">No papers are available for this subject.</p>
        )}
      </div>
    </aside>

    <div class="viewer-area" id="viewer-area">
      <div class="viewer-header">
        <button type="button" class="mobile-back-btn" id="mobile-back-btn">Back to list</button>
        <h2 id="current-paper-title">Select a paper</h2>
        <a id="download-btn" href="#" download class="download-btn" style="display: none;" aria-label="Download PDF">
          <Icon name="download" size={16} />
        </a>
      </div>
      <div class="iframe-container">
        <div class="placeholder" id="pdf-placeholder">
          <Icon name="file" size={40} class="placeholder-icon" />
          <p>Choose a year to open the paper.</p>
        </div>
        <iframe id="pdf-frame" src="" title="Question paper PDF" allowfullscreen></iframe>
      </div>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.paper-btn');
    const iframe = document.getElementById('pdf-frame') as HTMLIFrameElement;
    const placeholder = document.getElementById('pdf-placeholder');
    const sidebar = document.getElementById('sidebar');
    const viewerArea = document.getElementById('viewer-area');
    const mobileBackBtn = document.getElementById('mobile-back-btn');
    const currentPaperTitle = document.getElementById('current-paper-title');
    const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;

    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        // Remove active class from all
        buttons.forEach(b => b.classList.remove('active'));
        // Add active class to clicked
        const target = e.currentTarget as HTMLButtonElement;
        target.classList.add('active');

        const pdfPath = target.getAttribute('data-pdf');
        const title = target.getAttribute('data-title');

        if (pdfPath) {
          // Update iframe
          iframe.src = pdfPath;
          iframe.style.display = 'block';
          if (placeholder) placeholder.style.display = 'none';
          
          // Update Header
          if (currentPaperTitle) currentPaperTitle.textContent = title || 'Document';
          if (downloadBtn) {
            downloadBtn.href = pdfPath;
            downloadBtn.style.display = 'flex';
          }

          // Mobile logic: hide sidebar, show viewer
          if (window.innerWidth < 768) {
            if (sidebar) sidebar.classList.add('mobile-hidden');
            if (viewerArea) viewerArea.classList.add('mobile-visible');
          }
        }
      });
    });

    if (mobileBackBtn) {
      mobileBackBtn.addEventListener('click', () => {
        if (sidebar) sidebar.classList.remove('mobile-hidden');
        if (viewerArea) viewerArea.classList.remove('mobile-visible');
        
        // Optional: clear active state when going back on mobile
        // buttons.forEach(b => b.classList.remove('active'));
      });
    }
  });
</script>

<style>
  .back {
    margin: 0 0 var(--s2);
    font-size: 0.78rem;
  }

  .back a {
    color: var(--faint);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .back a:hover {
      color: var(--paper);
    }
  }

  .pyq-wrapper {
    display: flex;
    height: calc(100dvh - var(--header-h) - 8.4rem);
    min-height: 26rem;
    margin-top: var(--s4);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
  }

  .sidebar {
    width: 13rem;
    flex: 0 0 auto;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    border-right: 1px solid var(--line);
    background: var(--surface);
    transition-property: transform, visibility;
    transition-duration: 250ms;
    transition-timing-function: var(--ease-drawer);
  }

  .papers-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s2);
    padding: var(--s3);
    align-content: flex-start;
  }

  .paper-btn {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem;
    margin: 0;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r);
    background: transparent;
    color: var(--muted);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .paper-btn:hover {
      border-color: var(--muted);
      color: var(--paper);
    }
  }

  .paper-btn.active {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--paper);
  }

  .paper-set {
    color: var(--faint);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
  }

  .paper-btn.active .paper-set {
    color: var(--accent);
  }

  .no-data {
    margin: 0;
    color: var(--faint);
    font-size: 0.82rem;
  }

  .viewer-area {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    min-width: 0;
    background: var(--bg);
  }

  .viewer-header {
    display: flex;
    align-items: center;
    gap: var(--s3);
    min-height: 3rem;
    padding: var(--s2) var(--s4);
    border-bottom: 1px solid var(--line);
  }

  .viewer-header h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--muted);
  }

  .download-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    padding: 0.35rem;
    color: var(--faint);
  }

  @media (hover: hover) and (pointer: fine) {
    .download-btn:hover {
      color: var(--paper);
    }
  }

  .iframe-container {
    position: relative;
    flex: 1 1 auto;
  }

  iframe {
    display: none;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--surface);
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--s3);
    color: var(--faint);
    text-align: center;
    padding: var(--s5);
  }

  .placeholder p {
    margin: 0;
    font-size: 0.85rem;
  }

  .placeholder-icon {
    color: var(--line-strong);
  }

  .mobile-back-btn {
    display: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--faint);
    font-size: 0.78rem;
    cursor: pointer;
  }

  @media (hover: hover) and (pointer: fine) {
    .mobile-back-btn:hover {
      color: var(--paper);
    }
  }

  @media (max-width: 767px) {
    .pyq-wrapper {
      position: relative;
      height: calc(100dvh - var(--header-h) - 7.4rem);
    }

    .sidebar {
      position: absolute;
      inset: 0;
      z-index: 5;
      width: 100%;
      border-right: 0;
    }

    .sidebar.mobile-hidden {
      transform: translateX(-100%);
      /* Off-canvas must also leave the tab order, or Tab walks into a hidden panel. */
      visibility: hidden;
    }

    .viewer-area {
      position: absolute;
      inset: 0;
      z-index: 1;
      opacity: 0;
      pointer-events: none;
      transition: opacity 200ms var(--ease-out);
    }

    .viewer-area.mobile-visible {
      z-index: 10;
      opacity: 1;
      pointer-events: auto;
    }

    .mobile-back-btn {
      display: block;
    }
  }
</style>

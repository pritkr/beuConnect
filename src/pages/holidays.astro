---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Holiday2025Img from "../assets/holidays2025.png";
import Holiday2026Img from "../assets/holidays2026.png";
---

<Layout title="Holidays" description="BEU holiday lists for 2026 and 2025.">
	<header class="page-head">
		<div>
			<h1>Holidays</h1>
			<p class="meta">
				<a href={`${import.meta.env.BASE_URL}holidays-calendar`}>Interactive 2026 calendar</a>
			</p>
		</div>
	</header>

	<section class="year" aria-labelledby="y2026">
		<h2 id="y2026">2026</h2>
		<img src={Holiday2026Img.src} alt="BEU holiday list for 2026" loading="lazy" />
	</section>

	<section class="year" aria-labelledby="y2025">
		<h2 id="y2025">2025</h2>
		<img src={Holiday2025Img.src} alt="BEU holiday list for 2025" loading="lazy" />
	</section>

	<style>
		.year {
			display: grid;
			gap: var(--s3);
			margin-top: var(--s6);
		}

		.year h2 {
			margin: 0;
			color: var(--faint);
			font-family: var(--font-sans);
			font-size: 0.72rem;
			font-weight: 650;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.year img {
			width: 100%;
			height: auto;
			border: 1px solid var(--line);
			border-radius: var(--r-lg);
			background: var(--surface);
		}
	</style>
</Layout>

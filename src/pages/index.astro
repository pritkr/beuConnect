---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import Hero from "../components/hero.astro";
import Announcements from "../components/announcements.astro";
import { latestAnnouncementPosts } from "../data/announcements";

const importantApi = `${import.meta.env.BASE_URL}api/notices/important?limit=8`;
const latestPost = latestAnnouncementPosts(1)[0];

const announcements = latestPost
	? [{ text: latestPost.title, link: `announcements/${latestPost.slug}/` }]
	: [];
---

<Layout
	title="BEUConnect — syllabus, results and previous-year papers"
	description="B.Tech syllabus for six branches, 1,069 previous-year papers, semester results, merit lists and campus tools for Bihar Engineering University."
>
	<Announcements announcements={announcements} importantApi={importantApi} />
	<Hero />
</Layout>

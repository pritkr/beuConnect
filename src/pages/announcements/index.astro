---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { sortedAnnouncementPosts } from "../../data/announcements";

const base = import.meta.env.BASE_URL;
---

<Layout title="Announcements" description="BEUConnect announcements and updates.">
  <header class="page-head">
    <div>
      <h1>Announcements</h1>
      <p class="meta num">{sortedAnnouncementPosts.length} posts</p>
    </div>
  </header>

  {
    sortedAnnouncementPosts.length ? (
      <div class="post-list">
        {sortedAnnouncementPosts.map((post) => (
          <article class="post-row">
            <p class="post-meta num">
              <time datetime={post.publishedAt}>{post.publishedAt}</time>
              <span>{post.author}</span>
            </p>
            <h2>
              <a href={`${base}announcements/${post.slug}/`}>{post.title}</a>
            </h2>
            <p class="post-excerpt">{post.excerpt}</p>
            {post.tags.length > 0 && (
              <p class="post-tags">{post.tags.join(" · ")}</p>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="empty">No announcements yet.</p>
    )
  }
</Layout>

<style>
  .post-list {
    display: grid;
    margin-top: var(--s5);
    border-top: 1px solid var(--line-strong);
  }

  .post-row {
    display: grid;
    gap: var(--s2);
    padding: var(--s5) 0;
    border-bottom: 1px solid var(--line);
  }

  .post-meta {
    display: flex;
    gap: var(--s3);
    margin: 0;
    color: var(--faint);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .post-row h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.15;
  }

  .post-row h2 a {
    color: var(--paper);
    text-decoration: none;
  }

  .post-row h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 0.16em;
  }

  .post-excerpt {
    max-width: var(--measure);
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .post-tags {
    margin: 0;
    color: var(--faint);
    font-size: 0.72rem;
  }

  .empty {
    margin: var(--s5) 0;
    color: var(--faint);
  }
</style>

---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Attendance Tracker - BEUConnect">
    <div class="attendance-container">
        <header class="page-head">
            <div>
                <h1>Attendance</h1>
                <p class="meta">Saved on this device</p>
            </div>
        </header>

        <section class="overview-section">
            <div class="total-stats">
                <div class="stat-circle">
                    <svg class="progress-ring" width="80" height="80">
                        <circle class="ring-bg" cx="40" cy="40" r="36"></circle>
                        <circle class="ring-progress" id="totalProgressRing" cx="40" cy="40" r="36"></circle>
                    </svg>
                    <div class="stat-value">
                        <span id="totalPercentage">0</span>%
                    </div>
                </div>
                <div class="stat-info">
                    <h2>Total Attendance</h2>
                    <p id="totalClassesInfo">0 / 0 classes attended</p>
                    <p class="status-msg" id="overallStatusMsg"></p>
                </div>
            </div>
        </section>

        <section class="controls-section">
            <form id="addSubjectForm" class="add-subject-form">
                <input type="text" id="subjectName" placeholder="Subject name" required autofocus />
                <button type="submit" class="btn-primary">Add</button>
            </form>

            <div class="settings-card">
                <div class="settings-body">
                    <div class="setting-item">
                        <label for="targetPercentage">Target %</label>
                        <select id="targetPercentage">
                            <option value="60">60%</option>
                            <option value="65">65%</option>
                            <option value="70">70%</option>
                            <option value="75" selected>75%</option>
                            <option value="80">80%</option>
                            <option value="85">85%</option>
                            <option value="90">90%</option>
                            <option value="95">95%</option>
                            <option value="100">100%</option>
                        </select>
                    </div>
                    <div class="setting-actions">
                        <button id="exportBtn" class="btn-ghost" title="Export JSON">Export</button>
                        <label class="btn-ghost file-upload-label" title="Import JSON">
                            Import
                            <input type="file" id="importFile" accept=".json" class="hidden-file-input" />
                        </label>
                        <button id="resetBtn" class="btn-danger" title="Reset All">Reset</button>
                    </div>
                </div>
            </div>
        </section>

        <section class="subjects-grid" id="subjectsContainer">
            <!-- Subjects will be injected here via JS -->
        </section>
    </div>

    <!-- Modal System -->
    <div id="editModal" class="attendance-container-modal-overlay hidden">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Edit Subject</h2>
                <button class="modal-close" id="closeEditModal">&times;</button>
            </div>
            <form id="editSubjectForm">
                <input type="hidden" id="editSubjectId" />
                <div class="form-group">
                    <label for="editSubjectName">Subject Name</label>
                    <input type="text" id="editSubjectName" required />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label for="editAttended">Attended</label>
                        <input type="number" id="editAttended" min="0" required />
                    </div>
                    <div class="form-group">
                        <label for="editTotal">Total</label>
                        <input type="number" id="editTotal" min="0" required />
                    </div>
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary" id="cancelEditBtn">Cancel</button>
                    <button type="submit" class="btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer" class="attendance-container-toast-container"></div>

</Layout>

<script>
    import { AttendanceState } from '../lib/attendance/tracker';
    import type { AttendanceAction, Subject } from '../lib/attendance/tracker';

    class AttendanceTrackerUI {
        private state: AttendanceState;
        private readonly STORAGE_KEY = 'beuconnect_attendance_v2';
        private readonly LEGACY_KEY = 'beuconnect_attendance';
        private readonly SETTINGS_KEY = 'beuconnect_attendance_settings';

        constructor() {
            this.state = new AttendanceState();
            this.loadData();
            this.initEventListeners();
            this.render();
        }

        private loadData() {
            const settingsData = localStorage.getItem(this.SETTINGS_KEY);
            if (settingsData) {
                try {
                    this.state.settings = { ...this.state.settings, ...JSON.parse(settingsData) };
                } catch (e) {
                    console.error("Failed to parse settings", e);
                }
            }

            const data = localStorage.getItem(this.STORAGE_KEY);
            if (data) {
                try {
                    const parsedSubjects = JSON.parse(data);
                    this.state.subjects = parsedSubjects.map((s: any) => ({
                        ...s,
                        history: s.history || []
                    }));
                } catch (e) {
                    console.error("Failed to parse V2 attendance data", e);
                    this.state.subjects = [];
                }
            } else {
                const legacyData = localStorage.getItem(this.LEGACY_KEY);
                if (legacyData) {
                    try {
                        const legacySubjects = JSON.parse(legacyData);
                        this.state.subjects = legacySubjects.map((s: any) => ({
                            id: s.id,
                            name: s.name,
                            attended: s.attended || 0,
                            total: s.total || 0,
                            history: []
                        }));
                        this.saveData();
                        console.log("Migrated legacy attendance data.");
                    } catch (e) {
                        console.error("Failed to migrate legacy data", e);
                    }
                }
            }
        }

        private saveData() {
            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.state.subjects));
        }

        private saveSettings() {
            localStorage.setItem(this.SETTINGS_KEY, JSON.stringify(this.state.settings));
        }

        private showToast(message: string, type: 'success' | 'error' | 'info' = 'info') {
            const toastContainer = document.getElementById('toastContainer');
            if (!toastContainer) return;

            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            const content = document.createElement('div');
            content.className = 'toast-content';
            content.textContent = message;
            const toastCloseBtn = document.createElement('button');
            toastCloseBtn.className = 'toast-close';
            toastCloseBtn.innerHTML = '&times;';

            toast.appendChild(content);
            toast.appendChild(toastCloseBtn);
            toastContainer.appendChild(toast);

            void toast.offsetWidth;
            toast.classList.add('show');

            const removeToast = () => {
                toast.classList.remove('show');
                setTimeout(() => {
                    if (toast.parentElement) toast.parentElement.removeChild(toast);
                }, 300);
            };

            toastCloseBtn.addEventListener('click', removeToast);
            setTimeout(removeToast, 3000);
        }

        private openEditModal(subject: Subject) {
            const modal = document.getElementById('editModal');
            if (!modal) return;

            (document.getElementById('editSubjectId') as HTMLInputElement).value = subject.id;
            (document.getElementById('editSubjectName') as HTMLInputElement).value = subject.name;
            (document.getElementById('editAttended') as HTMLInputElement).value = subject.attended.toString();
            (document.getElementById('editTotal') as HTMLInputElement).value = subject.total.toString();

            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.add('visible'), 10);
        }

        private closeEditModal() {
            const modal = document.getElementById('editModal');
            if (!modal) return;
            modal.classList.remove('visible');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        private handleExport() {
            const data = {
                version: 2,
                settings: this.state.settings,
                subjects: this.state.subjects
            };
            const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `beuconnect_attendance_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            this.showToast('Data exported successfully!', 'success');
        }

        private handleImport(e: Event) {
            const input = e.target as HTMLInputElement;
            if (!input.files || input.files.length === 0) return;

            const file = input.files[0];
            const reader = new FileReader();

            reader.onload = (event) => {
                try {
                    const result = event.target?.result as string;
                    const data = JSON.parse(result);

                    if (data.version === 2 && data.subjects) {
                        this.state.settings = data.settings || { targetPercentage: 75 };
                        this.state.subjects = data.subjects;
                        this.saveData();
                        this.saveSettings();
                        this.render();
                        this.showToast('Data imported successfully!', 'success');
                    } else if (Array.isArray(data)) {
                        this.state.subjects = data.map((s: any) => ({
                            id: s.id,
                            name: s.name,
                            attended: s.attended || 0,
                            total: s.total || 0,
                            history: []
                        }));
                        this.saveData();
                        this.render();
                        this.showToast('Legacy data imported!', 'success');
                    } else {
                        throw new Error("Invalid format");
                    }
                } catch (err) {
                    console.error(err);
                    this.showToast('Failed to import data. Invalid file format.', 'error');
                }
                input.value = '';
            };

            reader.readAsText(file);
        }

        private initEventListeners() {
            const targetInput = document.getElementById('targetPercentage') as HTMLSelectElement;
            if (targetInput) {
                targetInput.value = this.state.settings.targetPercentage.toString();
                targetInput.addEventListener('change', (e) => {
                    let val = parseInt((e.target as HTMLSelectElement).value, 10);
                    if (isNaN(val) || val < 60) val = 75;
                    if (val > 100) val = 100;
                    this.state.settings.targetPercentage = val;
                    this.saveSettings();
                    this.render();
                    this.showToast(`Target set to ${val}%`, 'success');
                });
            }

            document.getElementById('exportBtn')?.addEventListener('click', () => this.handleExport());
            document.getElementById('importFile')?.addEventListener('change', (e) => this.handleImport(e));

            const editForm = document.getElementById('editSubjectForm');
            editForm?.addEventListener('submit', (e) => {
                e.preventDefault();
                const id = (document.getElementById('editSubjectId') as HTMLInputElement).value;
                const name = (document.getElementById('editSubjectName') as HTMLInputElement).value.trim();
                const attended = parseInt((document.getElementById('editAttended') as HTMLInputElement).value, 10);
                const total = parseInt((document.getElementById('editTotal') as HTMLInputElement).value, 10);

                if (name && !isNaN(attended) && !isNaN(total)) {
                    this.state.manualUpdateSubject(id, name, attended, total);
                    this.saveData();
                    this.render();
                    this.showToast('Subject updated successfully', 'success');
                    this.closeEditModal();
                }
            });

            document.getElementById('closeEditModal')?.addEventListener('click', () => this.closeEditModal());
            document.getElementById('cancelEditBtn')?.addEventListener('click', () => this.closeEditModal());
            document.getElementById('editModal')?.addEventListener('click', (e) => {
                if (e.target === document.getElementById('editModal')) this.closeEditModal();
            });

            const editAttended = document.getElementById('editAttended') as HTMLInputElement;
            const editTotal = document.getElementById('editTotal') as HTMLInputElement;

            editAttended?.addEventListener('input', () => {
                if (parseInt(editAttended.value) > parseInt(editTotal.value)) {
                    editTotal.value = editAttended.value;
                }
            });

            editTotal?.addEventListener('input', () => {
                if (parseInt(editAttended.value) > parseInt(editTotal.value)) {
                    editAttended.value = editTotal.value;
                }
            });

            const form = document.getElementById('addSubjectForm');
            form?.addEventListener('submit', (e) => {
                e.preventDefault();
                const input = document.getElementById('subjectName') as HTMLInputElement;
                const name = input.value.trim();
                if (name) {
                    this.state.addSubject(Date.now().toString(), name);
                    this.saveData();
                    this.render();
                    this.showToast(`Added ${name}`, 'success');
                    input.value = '';
                }
            });

            const resetBtn = document.getElementById('resetBtn');
            resetBtn?.addEventListener('click', () => {
                if (confirm('Are you sure you want to completely reset all your attendance data? This cannot be undone.')) {
                    this.state.subjects = [];
                    this.saveData();
                    this.render();
                    this.showToast('All data has been reset.', 'success');
                }
            });

            const container = document.getElementById('subjectsContainer');
            container?.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                const card = target.closest('.subject-card') as HTMLElement;
                if (!card) return;

                const id = card.dataset.id;
                if (!id) return;

                if (target.classList.contains('btn-present') || target.closest('.btn-present')) {
                    if (this.state.updateAttendance(id, 'present')) {
                        const sub = this.state.subjects.find(s => s.id === id);
                        this.showToast(`Marked Present for ${sub?.name}`, 'success');
                        this.saveData();
                        this.render();
                    }
                } else if (target.classList.contains('btn-absent') || target.closest('.btn-absent')) {
                    if (this.state.updateAttendance(id, 'absent')) {
                        const sub = this.state.subjects.find(s => s.id === id);
                        this.showToast(`Marked Absent for ${sub?.name}`, 'info');
                        this.saveData();
                        this.render();
                    }
                } else if (target.classList.contains('btn-undo') || target.closest('.btn-undo')) {
                    if (this.state.undoAction(id)) {
                        this.showToast('Action undone');
                        this.saveData();
                        this.render();
                    } else {
                        this.showToast('Nothing to undo', 'error');
                    }
                } else if (target.classList.contains('btn-delete')) {
                    if (confirm('Delete this subject?')) {
                        this.state.deleteSubject(id);
                        this.showToast('Subject deleted');
                        this.saveData();
                        this.render();
                    }
                } else if (target.classList.contains('stat-fraction') || target.classList.contains('btn-edit')) {
                     const subject = this.state.subjects.find((s: Subject) => s.id === id);
                     if (subject) this.openEditModal(subject);
                }
            });
        }

        private render() {
            let totalAttended = 0;
            let totalClasses = 0;

            this.state.subjects.forEach((s: Subject) => {
                totalAttended += s.attended;
                totalClasses += s.total;
            });

            const overall = this.state.calculateStatus(totalAttended, totalClasses);

            const totalPercentEl = document.getElementById('totalPercentage');
            if (totalPercentEl) totalPercentEl.textContent = overall.percent.toString();

            const totalInfoEl = document.getElementById('totalClassesInfo');
            if (totalInfoEl) totalInfoEl.textContent = `${totalAttended} / ${totalClasses} classes attended`;

            const statusMsgEl = document.getElementById('overallStatusMsg');
            if (statusMsgEl) {
                statusMsgEl.textContent = totalClasses === 0 ? "" : overall.msg;
                statusMsgEl.className = `status-msg status-${overall.type}`;
            }

            const ring = document.getElementById('totalProgressRing') as unknown as SVGCircleElement;
            if (ring) {
                const radius = ring.r.baseVal.value;
                const circumference = radius * 2 * Math.PI;
                const offset = circumference - (overall.percent / 100) * circumference;
                ring.style.strokeDashoffset = offset.toString();
                ring.style.stroke = overall.percent >= this.state.settings.targetPercentage ? 'var(--ok)' : (totalClasses > 0 ? 'var(--bad)' : 'var(--line-strong)');
            }

            const container = document.getElementById('subjectsContainer');
            if (!container) return;

            container.innerHTML = '';

            if (this.state.subjects.length === 0) {
                container.innerHTML = '<div class="empty-state"><p>No subjects yet.</p></div>';
                return;
            }

            this.state.subjects.forEach((sub: Subject) => {
                const status = this.state.calculateStatus(sub.attended, sub.total);
                const card = document.createElement('div');
                card.className = 'subject-card';
                card.dataset.id = sub.id;

                const hasHistory = sub.history && sub.history.length > 0;

                card.innerHTML = `
                    <div class="subject-header">
                        <h3 class="subject-title"></h3>
                        <div class="subject-header-actions">
                            <button class="icon-btn btn-edit" type="button">Edit</button>
                            <button class="icon-btn btn-delete" type="button">Remove</button>
                        </div>
                    </div>

                    <div class="subject-stats">
                        <div class="stat-main">
                            <span class="stat-percent ${status.type === 'safe' ? 'text-safe' : 'text-danger'}">${status.percent}%</span>
                            <span class="stat-fraction clickable" title="Click to edit manual attendance">${sub.attended} / ${sub.total}</span>
                        </div>
                        <p class="subject-msg status-${status.type}">${status.msg}</p>
                    </div>

                    <div class="subject-actions">
                        <button class="action-btn btn-present" type="button">Present</button>
                        <button class="action-btn btn-absent" type="button">Absent</button>
                        <button class="action-btn btn-undo" type="button" ${!hasHistory ? 'disabled' : ''}>Undo</button>
                    </div>
                `;

                const titleEl = card.querySelector('.subject-title');
                if (titleEl) {
                    titleEl.textContent = sub.name;
                }

                container.appendChild(card);
            });
        }
    }

    document.addEventListener('astro:page-load', () => {
        if (document.querySelector('.attendance-container')) {
            new AttendanceTrackerUI();
        }
    });

    if (document.querySelector('.attendance-container') && !window.hasOwnProperty('attendanceTrackerInitialized')) {
        (window as any).attendanceTrackerInitialized = true;
        new AttendanceTrackerUI();
    }

</script>

<style is:global>
    .attendance-container {
        max-width: 60rem;
        margin: 0 auto;
        padding-bottom: var(--s7);
    }

    .attendance-container .overview-section {
        margin: var(--s5) 0 var(--s4);
    }

    .attendance-container :is(.total-stats, .settings-card, .subject-card, .add-subject-form, .modal-content) {
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        background: var(--surface);
    }

    /* Overview */
    .attendance-container .total-stats {
        display: flex;
        align-items: center;
        gap: var(--s4);
        padding: var(--s4) var(--s5);
    }

    .attendance-container .stat-circle {
        position: relative;
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 5rem;
        height: 5rem;
    }

    .attendance-container .progress-ring {
        position: absolute;
        inset: 0;
        width: 5rem;
        height: 5rem;
        transform: rotate(-90deg);
    }

    .attendance-container .ring-bg {
        fill: transparent;
        stroke: var(--line);
        stroke-width: 4;
    }

    .attendance-container .ring-progress {
        fill: transparent;
        stroke: var(--accent);
        stroke-width: 4;
        stroke-linecap: butt;
        stroke-dasharray: 226.19;
        stroke-dashoffset: 226.19;
    }

    .attendance-container .stat-value {
        color: var(--paper);
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-variant-numeric: tabular-nums;
        line-height: 1;
    }

    .attendance-container .stat-info {
        min-width: 0;
    }

    .attendance-container .stat-info h2 {
        margin: 0 0 var(--s1);
        font-family: var(--font-sans);
        font-size: 0.72rem;
        font-weight: 650;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--faint);
    }

    .attendance-container .stat-info p {
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
        font-variant-numeric: tabular-nums;
    }

    .attendance-container .status-msg {
        margin-top: var(--s1) !important;
        color: var(--muted);
    }

    .attendance-container .status-safe,
    .attendance-container .text-safe {
        color: var(--ok);
    }

    .attendance-container .status-danger,
    .attendance-container .text-danger {
        color: var(--bad);
    }

    /* Controls */
    .attendance-container .controls-section {
        display: grid;
        gap: var(--s3);
        margin-bottom: var(--s5);
    }

    .attendance-container .add-subject-form {
        display: flex;
        align-items: stretch;
        gap: var(--s2);
        padding: var(--s2);
    }

    .attendance-container .add-subject-form input {
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
        margin: 0;
        padding: 0.55rem 0.7rem;
        border: 1px solid var(--line-strong);
        border-radius: var(--r);
        background: var(--bg);
        color: var(--paper);
        font-size: 0.9rem;
    }

    .attendance-container .add-subject-form input:focus {
        border-color: var(--accent);
        outline: 2px solid var(--accent);
        outline-offset: 1px;
    }

    .attendance-container .add-subject-form button {
        flex: 0 0 auto;
        margin: 0;
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
    }

    .attendance-container .btn-primary,
    .attendance-container .btn-secondary,
    .attendance-container .btn-ghost,
    .attendance-container .btn-danger {
        margin: 0;
        border-radius: var(--r);
        font-size: 0.82rem;
        font-weight: 550;
        cursor: pointer;
    }

    .attendance-container .btn-primary {
        border: 1px solid var(--accent);
        background: var(--accent);
        color: var(--accent-ink);
    }

    .attendance-container .btn-primary:hover {
        background: var(--accent-hover);
        border-color: var(--accent-hover);
    }

    .attendance-container .btn-secondary,
    .attendance-container .btn-ghost {
        border: 1px solid var(--line-strong);
        background: transparent;
        color: var(--muted);
    }

    .attendance-container .btn-secondary:hover,
    .attendance-container .btn-ghost:hover {
        border-color: var(--muted);
        color: var(--paper);
    }

    .attendance-container .btn-ghost {
        padding: 0.3rem 0.55rem;
    }

    .attendance-container .btn-danger {
        border: 1px solid var(--line-strong);
        background: transparent;
        color: var(--bad);
        padding: 0.3rem 0.55rem;
    }

    .attendance-container .btn-danger:hover {
        border-color: var(--bad);
    }

    .attendance-container .settings-card {
        padding: var(--s3) var(--s4);
    }

    .attendance-container .settings-body {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s3);
        flex-wrap: wrap;
    }

    .attendance-container .setting-item {
        display: flex;
        align-items: center;
        gap: var(--s2);
    }

    .attendance-container .setting-item label {
        margin: 0;
        color: var(--faint);
        font-size: 0.78rem;
    }

    .attendance-container .setting-item select {
        width: auto;
        min-width: 4.5rem;
        margin: 0;
        padding: 0.25rem 0.4rem;
        border: 1px solid var(--line-strong);
        border-radius: var(--r);
        background: var(--bg);
        color: var(--paper);
        font-size: 0.82rem;
    }

    .attendance-container .setting-actions {
        display: flex;
        gap: var(--s2);
    }

    .attendance-container .file-upload-label {
        display: inline-flex;
        align-items: center;
        margin: 0;
        cursor: pointer;
    }

    .attendance-container .hidden-file-input {
        display: none;
    }

    /* Subjects */
    .attendance-container .subjects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
        gap: var(--s3);
    }

    .attendance-container .empty-state {
        grid-column: 1 / -1;
        margin: 0;
        padding: var(--s5);
        border: 1px dashed var(--line-strong);
        border-radius: var(--r);
        color: var(--faint);
        font-size: 0.88rem;
        text-align: center;
    }

    .attendance-container .empty-state p {
        margin: 0;
    }

    .attendance-container .subject-card {
        padding: var(--s4);
    }

    .attendance-container .subject-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--s3);

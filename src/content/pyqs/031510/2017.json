          "sub_questions": [
            {
              "id": "1a",
              "text": "The lengths of two discrete time sequences $x_1(n)$ and $x_2(n)$ are 5 and 7, respectively. The maximum length of a sequence $x_1(n) * x_2(n)$ is ______.",
              "marks": 2
            },
            {
              "id": "1b",

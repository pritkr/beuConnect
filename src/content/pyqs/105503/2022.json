      "questions": [
        {
          "id": "q5_1",
          "type": "theory",
          "text": "<p>Design a pushdown automata to accept the following language by empty stack: \\( \\{0^n 1^n / n\n                        \\ge\n                        1\\}\n                        \\).</p>",

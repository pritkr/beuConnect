      "questions": [
        {
          "id": "q1_1",
          "type": "mcq",
          "text": "<p>Kirchhoff's Current Law is based on</p>",
          "options": [
            "Conservation of momentum",
            "Conservation of magnetic flux",
            "Conservation of energy",
            "Conservation of charge"
          ]
        },
        {
          "id": "q1_2",
          "type": "mcq",
          "text": "<p>In a bilateral element, voltage-current relation</p>",
          "options": [
            "Changes with direction",
            "Same in both directions",
            "Constant",
            "Nonlinear"
          ]
        },
        {
          "id": "q1_3",
          "type": "mcq",
          "text": "<p>Eddy current loss can be reduced by</p>",
          "options": [
            "Thick laminations",
